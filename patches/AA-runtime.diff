+    if (s_fifo_record_on && g.frames - s_fifo_record_first >= s_fifo_record_frames) {
+        fclose(s_fifo_record); s_fifo_record = NULL;
+        s_fifo_record_on = 0; s_fifo_record_done = 1;
+        fprintf(stderr, "[rsx record] complete frames=%u\n", s_fifo_record_frames);
