+static void eng_record_write(u32 kind, u32 a, u32 b, const void* data, u32 bytes)
+{
+    const u32 header[4] = {kind, a, b, bytes};
+    if (fwrite(header, sizeof(header), 1, s_fifo_record) != 1 ||
+        (bytes && fwrite(data, bytes, 1, s_fifo_record) != 1)) {
+        fclose(s_fifo_record); s_fifo_record = NULL;
+        s_fifo_record_on = 0; s_fifo_record_done = 1;
+        fprintf(stderr, "[rsx record] write failed\n");
+    }
+}
