+static void test_stencil_reset(void)
+{
+    printf("-- stencil reset\n");
+    rsx_dispatch rsx;
+    rsx_dispatch_init(&rsx, NULL);
+    CHECK(rsx_dsp_reg(&rsx, 0x032C) == 0xFF &&
+          rsx_dsp_reg(&rsx, 0x034C) == 0xFF,
+          "front and back stencil write masks reset to FF");
+    rsx_dispatch_method(&rsx, 0x032C, 0);
+    rsx_dispatch_method(&rsx, 0x034C, 0);
+    CHECK(!rsx_dsp_reg(&rsx, 0x032C) && !rsx_dsp_reg(&rsx, 0x034C),
+          "explicit zero stencil masks remain zero");
+
+    /* D2 writes an inverse circular mask via REPLACE on depth failure,
+     * without setting STENCIL_MASK. The backing quad then tests 1 > stencil. */
+    engine_up();
+    m(0x0328, 1); m(0x0330, 0x0207); m(0x0334, 255); m(0x0338, 255);
+    m(0x033C, 0x1E01); m(0x0340, 0x1E01); m(0x0344, 0x1E01);
+    m(0x0A6C, 0x0200); m(0x0A70, 0); m(0x0A74, 1);
+    draw_triangle();
+    CHECK(stub.pipeline_state.s_write_mask == 255 &&
+          stub.pipeline_state.s_zfail == 0x1E01 && stub.stencil_ref == 255 &&
+          stub.pipeline_state.depth_test && stub.pipeline_state.depth_func == 0x0200,
+          "depth-fail mask pass can replace stencil without an explicit write mask");
+    const int pipelines = stub.n_pipeline_create;
+    m(0x032C, 0);
+    draw_triangle();
+    CHECK(stub.pipeline_state.s_write_mask == 0 &&
+          stub.n_pipeline_create == pipelines + 1,
+          "explicit zero mask builds a pipeline that disables stencil writes");
+    engine_down();
+}
