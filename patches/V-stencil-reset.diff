diff --git a/libs/video/rsx_dispatch.c b/libs/video/rsx_dispatch.c
index d105230..33168b9 100644
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -171,6 +171,13 @@ void rsx_dispatch_init(rsx_dispatch* rsx, const rsx_dispatch_sink* sink)
      * clear consumers, mirroring COLOR_MASK/FRONT_FACE above. */
     rsx->regs[0x1D8C >> 2] = 0xFFFFFF00u;
 
+    /* NV40 stencil write masks reset to all eight bits enabled. A title can
+     * set stencil ops without ever writing these registers (D2's circular
+     * portrait clip does); zero would silently suppress every stencil write.
+     * Seed the registers so an explicit zero still means "write no bits". */
+    rsx->regs[0x032C >> 2] = 0xFFu;
+    rsx->regs[0x034C >> 2] = 0xFFu;
+
     /* Execution methods */
     mark_class(rsx, M_VERTEX_BEGIN_END,  1, RSX_DSP_CLASS_EXEC);
     mark_class(rsx, M_VB_VERTEX_BATCH,   1, RSX_DSP_CLASS_EXEC);
