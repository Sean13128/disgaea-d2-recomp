+/* Opt-in per-request timeline. Sequence numbers identify guest frames rather
+ * than repeated drawable presentations; timestamps share the vblank clock. */
+static int gcm_flip_trace_enabled(void)
+{
+    static atomic_int enabled = -1;
+    int value = enabled;
+    if (value < 0) {
+        value = getenv("GCM_FLIP_TRACE") != NULL;
+        enabled = value;
+    }
+    return value;
+}
+
+static void gcm_flip_trace(const char* event, u32 sequence)
+{
+    if (gcm_flip_trace_enabled()) {
+        u64 now = get_timestamp_ns();
+        fprintf(stderr, "[gcm-flip] event=%s seq=%u time_ns=%llu vblank=%llu\n",
+                event, sequence, (unsigned long long)now,
+                (unsigned long long)gcm_vblank_at(gcm_vblank_elapsed_ns()));
+    }
+}
