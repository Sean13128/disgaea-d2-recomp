diff --git a/libs/video/rsx_host_settings.h b/libs/video/rsx_host_settings.h
index 636dfa1..e7654c4 100644
--- a/libs/video/rsx_host_settings.h
+++ b/libs/video/rsx_host_settings.h
@@ -12,6 +12,21 @@ static inline unsigned rsx_host_scale_extent(unsigned start, unsigned extent, un
 {
     return rsx_host_scale_edge(start + extent, half_units) - rsx_host_scale_edge(start, half_units);
 }
+/* Frame cap on a fixed schedule. Measuring from the previous display instead
+ * dropped every frame that delivery jitter landed slightly early (60 guest fps
+ * showed ~50). A quarter-period of tolerance absorbs jitter, yet still skips
+ * alternate frames for a 30 cap over a 60 fps guest. cap 0 = uncapped. */
+static inline int rsx_host_cap_due(double now, unsigned cap, double next)
+{
+    return !cap || now >= next - 0.25 / cap;
+}
+/* After a displayed frame: keep the schedule, or (first frame, or a full
+ * period late) restart it from this frame. */
+static inline double rsx_host_cap_next(double now, unsigned cap, double next)
+{
+    double period = cap ? 1.0 / cap : 0;
+    return next && next + period > now ? next + period : now + period;
+}
 #ifdef __cplusplus
 extern "C" {
 #endif
