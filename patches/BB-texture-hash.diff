+/* Exercise every guest byte, including cube alignment padding. A lower mip
+ * or a different face changing must retire and re-upload the whole resource;
+ * the content check still runs only once per frame. */
+static void texture_mutations(u32 fmt, u32 w, u32 h, u32 levels, u32 pitch,
+                               int cube, u32 expected_span)
+{
+    engine_up();
+    bind_texture_unit(RSX_LOCATION_MAIN, TEX_OFFSET + 1u);
+    m(M_TEX_UNIT + 0x04, 2u | ((u32)cube << 2) | (2u << 4) |
+                          (fmt << 8) | (levels << 16));
+    m(M_TEX_UNIT + 0x18, (w << 16) | h);
+    m(0x1840u, pitch);
+
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    const u32 n = rsx_texture_mip_chain(fmt, w, h, levels, pitch, lv);
+    const u32 faces = cube ? 6u : 1u;
+    const u32 span = cube
+        ? rsx_texture_cube_face_stride(fmt, w, h, levels, pitch) * faces
+        : lv[n - 1].offset + lv[n - 1].tl.face_bytes;
+    CHECK(span == expected_span, "mutation fixture span=%u (expected %u)",
+          span, expected_span);
+    u8* data = vm_base + TEX_OFFSET + 1u;
+    for (u32 i = 0; i < span; i++) data[i] = (u8)(i * 131u + i / 31u);
+    draw_triangle();
+
+    int correct = stub.n_texture_create == 1 &&
+                  stub.n_texture_upload == (int)(faces * n);
+    for (u32 byte = 0; byte < span && correct; byte++) {
+        const u32 old = stub.bound_tex[0];
+        const int creates = stub.n_texture_create;
+        const int uploads = stub.n_texture_upload;
+        const int releases = stub.n_texture_release;
+        data[byte] ^= (u8)(1u << (byte % 8));
+        rsx_draw_engine_present();
+        draw_triangle();
+        correct = stub.n_texture_create == creates + 1 &&
+                  stub.n_texture_upload == uploads + (int)(faces * n) &&
+                  stub.n_texture_release == releases + 1 &&
+                  stub.bound_tex[0] != old && !stub.alive[old];
+
+        draw_triangle();
+        rsx_draw_engine_present();
+        draw_triangle();
+        correct = correct && stub.n_texture_create == creates + 1 &&
+                  stub.n_texture_upload == uploads + (int)(faces * n) &&
+                  stub.n_texture_release == releases + 1;
+
+        /* Restoring the byte is another mutation in the following frame. */
+        data[byte] ^= (u8)(1u << (byte % 8));
+        rsx_draw_engine_present();
+        draw_triangle();
+        correct = correct && stub.n_texture_create == creates + 2 &&
+                  stub.n_texture_upload == uploads + (int)(2u * faces * n) &&
+                  stub.n_texture_release == releases + 2;
+    }
+    CHECK(correct, "all %u byte mutations re-upload; unchanged data reuses "
+                   "texture (%u mips, %u faces, pitch=%u)", span, n, faces, pitch);
+
+    /* Unreadable full spans leave the existing upload intact. */
+    const int creates = stub.n_texture_create, uploads = stub.n_texture_upload;
+    const u32 handle = stub.bound_tex[0], saved_size = ppu_vm_size;
+    ppu_vm_size = TEX_OFFSET + span;
+    rsx_draw_engine_present();
+    draw_triangle();
+    CHECK(stub.n_texture_create == creates && stub.n_texture_upload == uploads &&
+          stub.bound_tex[0] == handle,
+          "an unreadable span keeps the cached texture");
+    ppu_vm_size = saved_size;
+    engine_down();
+}
+
+static void test_texture_mutations(void)
+{
+    printf("-- full-span texture mutations\n");
+    /* R8 spans with short word/stripe tails, pitched rows, and mip pyramids. */
+    texture_mutations(0xA1u, 17, 1, 1, 0, 0, 17);
+    texture_mutations(0xA1u, 33, 1, 1, 0, 0, 33);
+    texture_mutations(0xA1u, 65, 1, 1, 0, 0, 65);
+    texture_mutations(0xA1u, 7, 3, 1, 11, 0, 33);
+    texture_mutations(0xA1u, 8, 8, 4, 0, 0, 85);
+    texture_mutations(0x81u, 8, 8, 4, 0, 0, 85); /* swizzled */
+    texture_mutations(0xA1u, 8, 8, 4, 0, 1, 768);
+    texture_mutations(0x86u, 8, 8, 4, 0, 0, 56); /* BC1 */
+}
