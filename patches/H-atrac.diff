                              const uint8_t* frame, int frame_bytes)
 {
+    std::shared_lock<std::shared_mutex> lock(s_at3p_tables);
+    /* The FFmpeg bit reader requires zero padding after every packet, even
+     * when a caller's frame is the last bytes of an allocation. */
+    if (frame_bytes <= 0) return -1;
+    thread_local std::vector<uint8_t> packet;
+    packet.resize((size_t)frame_bytes + 64);
