+static s32 remain_frames(const AtracSlot* s)
+{
+    if (s->all_on_memory) return CELL_ATRAC_ALLDATA_IS_ON_MEMORY;
+    const u32 at = s->t.data_off + (u32)s->next_frame * s->t.block_align;
+    const u32 end = at <= s->prefix ? s->prefix :
+                    at >= s->range_start && at <= s->range_end ? s->range_end : at;
+    if (end == s->file_bytes) return CELL_ATRAC_NONLOOP_STREAM_DATA_IS_ON_MEMORY;
+    return (s32)((end - at) / s->t.block_align);
