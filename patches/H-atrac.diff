+/* A prefix plus the latest seek range covers normal streaming, loops, and
+ * discontinuous resets without treating unsubmitted cache bytes as audio. */
+static int cached(const AtracSlot* s, u32 at, u32 bytes)
+{
+    return at <= s->file_bytes && bytes <= s->file_bytes - at &&
+           (at + bytes <= s->prefix ||
+            (at >= s->range_start && at + bytes <= s->range_end));
+}
+
+static void submit_data(AtracSlot* s, u32 at, u32 ea, u32 bytes)
+{
+    memcpy(s->file + at, vm_base + ea, bytes);
+    if (at <= s->prefix) {
+        if (at + bytes > s->prefix) s->prefix = at + bytes;
+        if (s->range_start <= s->prefix && s->range_end > s->prefix)
+            s->prefix = s->range_end;
+    } else if (at >= s->range_start && at <= s->range_end) {
+        if (at + bytes > s->range_end) s->range_end = at + bytes;
+    } else {
+        s->range_start = at;
+        s->range_end = at + bytes;
+    }
