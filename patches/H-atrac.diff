+/* Match the existing Windows diagnostics on POSIX, including macOS. */
+static void audio_trace_block(u64 blocks, u64 base_ns)
+{
+    static int peak = -1, rate, silent;
+    static FILE* wav;
+    static u64 last_ns, count;
+    if (peak < 0) {
+        peak = getenv("AUDIO_PEAK") != NULL;
+        rate = getenv("AUDIO_RATE") != NULL;
+        const char* path = getenv("AUDIO_WAV");
+        wav = path ? fopen(path, "wb") : NULL;
+        last_ns = base_ns;
+    }
+    if (peak || rate) {
+        float pk = 0;
+        for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++)
+            pk = fmaxf(pk, fabsf(s_mix_buffer[i]));
+        if (peak && (blocks % 200 == 0 || (pk > 0.001f && blocks < 40)))
+            fprintf(stderr, "[audio-peak] block#%llu peak=%.4f\n", (unsigned long long)blocks, pk);
+        count++;
+        if (pk == 0) silent++;
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        const u64 now = (u64)ts.tv_sec * 1000000000ULL + (u64)ts.tv_nsec;
+        if (rate && now - last_ns >= 5000000000ULL) {
+            fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%\n",
+                    count * 1000000000.0 / (now - last_ns), 100.0 * silent / count);
+            count = silent = 0;
+            last_ns = now;
+        }
+    }
+    if (wav) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, wav);
+}
