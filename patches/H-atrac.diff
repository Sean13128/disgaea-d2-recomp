+/* Allocation rebuilds global VLC/DSP/FFT tables in the standalone decoder.
+ * Keep it exclusive with both other allocations and in-flight decodes. */
+static std::shared_mutex s_at3p_tables;
+
+extern "C" void* at3p_open(int channels, int* block_align)
+{
+    std::unique_lock<std::shared_mutex> lock(s_at3p_tables);
+    return atrac3p_alloc(channels, block_align);
+}
 extern "C" void  at3p_close(void* dec) { atrac3p_free((ATRAC3PContext*)dec); }
