+static int64_t sys_spu_thread_bind_queue_handler(ppu_context* ctx)
+{
+    spu_thread_t* t = spu_find_thread((uint32_t)ctx->gpr[3]);
+    uint32_t qid = (uint32_t)ctx->gpr[4];
+    uint32_t number = (uint32_t)ctx->gpr[5];
+    uint32_t result = CELL_ESRCH;
+    if (t && qid && qid <= SYS_EVENT_QUEUE_MAX && g_sys_event_queues[qid - 1].active) {
+        result = CELL_EINVAL;
+        if (g_sys_event_queues[qid - 1].type == SYS_SPU_QUEUE) {
+            AcquireSRWLockExclusive(&s_spu_port_lock);
+            int slot = -1;
+            result = CELL_EAGAIN;
+            for (int i = 0; i < 32; i++) {
+                if (!t->receive_bind[i].queue) { if (slot < 0) slot = i; }
+                else if (t->receive_bind[i].number == number || t->receive_bind[i].queue == qid) {
+                    result = CELL_EBUSY;
+                    slot = -1;
+                    break;
+                }
+            }
+            if (slot >= 0) {
+                t->receive_bind[slot].number = number;
+                t->receive_bind[slot].queue = qid;
+                result = CELL_OK;
+            }
+            ReleaseSRWLockExclusive(&s_spu_port_lock);
+        }
+    }
+    fprintf(stderr, "[SPU] bind_queue tid=0x%X queue=%u number=0x%X -> 0x%X\n",
+            (uint32_t)ctx->gpr[3], qid, number, result);
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)result;
+    return (int64_t)(int32_t)result;
+}
+
+static int64_t sys_spu_thread_unbind_queue_handler(ppu_context* ctx)
+{
+    spu_thread_t* t = spu_find_thread((uint32_t)ctx->gpr[3]);
+    uint32_t result = CELL_ESRCH;
+    if (t) {
+        AcquireSRWLockExclusive(&s_spu_port_lock);
+        for (int i = 0; i < 32; i++) {
+            if (t->receive_bind[i].queue && t->receive_bind[i].number == (uint32_t)ctx->gpr[4]) {
+                t->receive_bind[i].queue = 0;
+                result = CELL_OK;
+                break;
+            }
+        }
+        ReleaseSRWLockExclusive(&s_spu_port_lock);
+    }
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)result;
+    return (int64_t)(int32_t)result;
+}
+
+/* stop 0x110 consumes a queue number from OutMbox and replies with four
+ * InMbox words. Keep this worker alive and wait on the real event queue. */
+static int spu_receive_event(spu_context* spu)
+{
+    if (spu->stop_code != 0x110 || !spu->spu_group_id) return 0;
+    uint32_t result = CELL_EINVAL;
+    uint32_t queue = 0;
+    sys_event_t event = {0};
+    if (spu->ch_out_mbox.count) {
+        uint32_t number = spu_channel_read(&spu->ch_out_mbox);
+        spu_thread_t* t = spu_find_thread(spu->spu_id);
+        AcquireSRWLockShared(&s_spu_port_lock);
+        if (t) {
+            for (int i = 0; i < 32; i++)
+                if (t->receive_bind[i].queue && t->receive_bind[i].number == number)
+                    queue = t->receive_bind[i].queue;
+        }
+        ReleaseSRWLockShared(&s_spu_port_lock);
+        if (spu->ch_in_mbox.count || spu->rcv_evt_n) result = CELL_EBUSY;
+        else if (queue) result = sys_event_queue_receive_spu(queue, &event);
+    }
+    spu->rcv_evt[0] = result;
+    spu->rcv_evt[1] = (uint32_t)event.data1;
+    spu->rcv_evt[2] = (uint32_t)event.data2;
+    spu->rcv_evt[3] = (uint32_t)event.data3;
+    spu->rcv_evt_i = 0;
+    spu->rcv_evt_n = result == CELL_OK ? 4 : 1;
+    spu->status = SPU_STATUS_RUNNING;
+    if (getenv("SPU_MBOXTRACE")) {
+        static int n;
+        if (n++ < 32) fprintf(stderr, "[SPU] receive_event tid=0x%X queue=%u -> 0x%X data=0x%X/0x%X/0x%X\n",
+            spu->spu_id, queue, result, spu->rcv_evt[1], spu->rcv_evt[2], spu->rcv_evt[3]);
+    }
+    return 1;
+}
