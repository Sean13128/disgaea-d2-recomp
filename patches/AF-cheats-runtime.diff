+int ps3_overlay_editor_update(uint64_t token, const SysOverlaySnapshot* request)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    int valid = s_ui.active && s_ui.token == token && s_ui.kind == SYS_OVERLAY_EDITOR &&
+        request->kind == SYS_OVERLAY_EDITOR && request->count >= 0 && request->count <= SYS_OVERLAY_MAX_ITEMS;
+    if (valid) {
+        uint64_t revision = s_ui.revision + 1;
+        int selected = request->selected < 0 ? s_ui.selected : request->selected;
+        if (strcmp(s_ui.title, request->title)) s_action_read = s_action_write;
+        s_ui = *request; s_ui.selected = selected < s_ui.count ? selected : 0; s_ui.token = token; s_ui.revision = revision; s_ui.active = 1;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return valid;
+}
+
+uint16_t ps3_overlay_editor_action(uint64_t token, int* selected)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    uint16_t action = 0;
+    if (s_ui.active && s_ui.token == token && s_ui.kind == SYS_OVERLAY_EDITOR) {
+        if (selected) *selected = s_ui.selected;
+        if (s_action_read != s_action_write) {
+            unsigned index = s_action_read++ % 32;
+            action = s_actions[index].buttons;
+            if (selected) *selected = s_actions[index].selected;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return action;
+}
