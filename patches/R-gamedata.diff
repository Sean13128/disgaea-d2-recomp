+/* Binary little-endian PARAM.SFO reader/writer shared by game and save data. */
+#ifndef PS3RECOMP_PARAM_SFO_H
+#define PS3RECOMP_PARAM_SFO_H
+#include "ps3emu/ps3types.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SAVE_SFO_MAX 256
+typedef struct SaveSfoEntry {
+    char key[64];
+    u16 format;
+    u32 size, capacity;
+    u8* data;
+} SaveSfoEntry;
+typedef struct SaveSfo { u32 count; SaveSfoEntry entries[SAVE_SFO_MAX]; } SaveSfo;
+
+static u32 sfo_le32(const u8* p)
+{
+    return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+static void sfo_put32(u8* p, u32 n)
+{
+    p[0] = (u8)n; p[1] = (u8)(n >> 8); p[2] = (u8)(n >> 16); p[3] = (u8)(n >> 24);
+}
+static void sfo_free(SaveSfo* s)
+{
+    for (u32 i = 0; i < s->count; i++) free(s->entries[i].data);
+    memset(s, 0, sizeof(*s));
+}
+static SaveSfoEntry* sfo_find(SaveSfo* s, const char* key)
+{
+    for (u32 i = 0; i < s->count; i++)
+        if (!strcmp(s->entries[i].key, key)) return &s->entries[i];
+    return NULL;
+}
+static int sfo_set(SaveSfo* s, const char* key, u16 format,
+                   const void* data, u32 size, u32 capacity)
+{
+    if (strlen(key) >= 64 || size > capacity || capacity > 65536) return 0;
+    SaveSfoEntry* e = sfo_find(s, key);
+    if (!e) {
+        if (s->count == SAVE_SFO_MAX) return 0;
+        e = &s->entries[s->count++];
+        strcpy(e->key, key);
+    }
+    u8* copy = calloc(1, capacity ? capacity : 1);
+    if (!copy) return 0;
+    if (size) memcpy(copy, data, size);
+    free(e->data); e->data = copy;
+    e->format = format; e->size = size; e->capacity = capacity;
+    return 1;
+}
+static int sfo_set_int(SaveSfo* s, const char* key, u32 n)
+{
+    u8 data[4]; sfo_put32(data, n);
+    return sfo_set(s, key, 0x0404, data, 4, 4);
+}
+static int sfo_set_str(SaveSfo* s, const char* key, const char* text, u32 capacity)
+{
+    u32 len = (u32)strnlen(text, capacity);
+    if (len == capacity) return 0;
+    return sfo_set(s, key, 0x0204, text, len + 1, capacity);
+}
+static void sfo_remove(SaveSfo* s, const char* key)
+{
+    SaveSfoEntry* e = sfo_find(s, key);
+    if (!e) return;
+    u32 i = (u32)(e - s->entries);
+    free(e->data);
+    memmove(e, e + 1, (s->count - i - 1) * sizeof(*e));
+    memset(&s->entries[--s->count], 0, sizeof(*e));
+}
+static int sfo_load(const char* path, SaveSfo* s)
+{
+    memset(s, 0, sizeof(*s));
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END); long length = ftell(f); rewind(f);
+    if (length < 20 || length > 1024 * 1024) { fclose(f); return 0; }
+    u8* bytes = malloc((size_t)length);
+    if (!bytes) { fclose(f); return 0; }
+    int ok = fread(bytes, 1, (size_t)length, f) == (size_t)length;
+    fclose(f);
+    if (!ok) { free(bytes); return 0; }
+    u32 keys = sfo_le32(bytes + 8), data = sfo_le32(bytes + 12);
+    u32 count = sfo_le32(bytes + 16);
+    ok = !memcmp(bytes, "\0PSF", 4) && sfo_le32(bytes + 4) == 0x101 &&
+         count <= SAVE_SFO_MAX &&
+         20 + count * 16 <= keys && keys <= data && data <= (u32)length;
+    for (u32 i = 0; ok && i < count; i++) {
+        const u8* e = bytes + 20 + i * 16;
+        u32 key = keys + ((u32)e[0] | (u32)e[1] << 8);
+        u32 size = sfo_le32(e + 4), cap = sfo_le32(e + 8), off = sfo_le32(e + 12);
+        ok = key < data && memchr(bytes + key, 0, data - key) &&
+             size <= cap && cap <= 65536 && (u64)data + off + cap <= (u32)length;
+        if (ok) ok = sfo_set(s, (char*)bytes + key, (u16)(e[2] | e[3] << 8),
+                             bytes + data + off, size, cap);
+    }
+    free(bytes);
+    if (!ok) sfo_free(s);
+    return ok;
+}
+static int sfo_entry_compare(const void* a, const void* b)
+{
+    return strcmp(((const SaveSfoEntry*)a)->key, ((const SaveSfoEntry*)b)->key);
+}
+static int sfo_store(const char* path, SaveSfo* s)
+{
+    qsort(s->entries, s->count, sizeof(s->entries[0]), sfo_entry_compare);
+    u32 key_size = 0, data_size = 0;
+    for (u32 i = 0; i < s->count; i++) {
+        key_size += (u32)strlen(s->entries[i].key) + 1;
+        data_size += (s->entries[i].capacity + 3) & ~3u;
