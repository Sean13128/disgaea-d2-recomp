+static int valid_content_name(const char* name)
+{
+    size_t len = strnlen(name, CELL_GAME_DIRNAME_SIZE);
+    if (!len || len >= CELL_GAME_DIRNAME_SIZE) return 0;
+    for (size_t i = 0; i < len; i++) {
+        char c = name[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+              (c >= '0' && c <= '9') || c == '_' || c == '-')) return 0;
+    }
+    return 1;
+}
+
+static const char* param_string(SaveSfo* sfo, const char* key)
+{
+    SaveSfoEntry* e = sfo_find(sfo, key);
+    if (!e || e->format != 0x0204 || !e->size ||
+        !memchr(e->data, 0, e->size)) return NULL;
+    return (const char*)e->data;
+}
+
+static void begin_content_check(int disc, const char* name, int can_create)
+{
+    sfo_free(&s_check_sfo);
+    s_check_is_disc = disc;
+    snprintf(s_check_dir, sizeof(s_check_dir), "%s", name);
+    s_check_can_create = can_create;
+    s_check_dirty = 0;
+    s_check_exists = 0;
+    s_create_dir[0] = 0;
+}
+
+static void load_disc_sfo(void)
+{
+    const char* root = getenv("PS3_VFS_ROOT");
+    if (!root || !*root) root = ppu_vfs_root;
+    char path[1100];
+    snprintf(path, sizeof(path), "%s/PS3_GAME/PARAM.SFO", root ? root : ".");
+    sfo_load(path, &s_check_sfo);
+    s_check_exists = 1;
+}
