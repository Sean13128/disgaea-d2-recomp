+static void test_imported_image_collision(void)
+{
+    // Two valid ELF containers with a shared CRT PC and different contents.
+    for (unsigned i = 0; i < 3; i++) {
+        uint32_t ea = 0x18000 + i * 0x100;
+        memcpy(vm_base + ea, "\177ELF\1\2", 6);
+        wr_be32(ea + 0x20, 0x100); // Size from the empty section table boundary.
+        vm_base[ea + 0x80] = (uint8_t)i;
+    }
+    spu_begin_image(90); spu_register_function(0xD0, code_a);
+    spu_begin_image(91); spu_register_function(0xD0, code_b);
+    spu_begin_image(0);
+    for (unsigned i = 0; i < 2; i++) {
+        uint32_t ea = 0x18000 + i * 0x100;
+        spu_workload_register_img(spu_workload_fingerprint(vm_base + ea, 0x100),
+                                  i ? code_b : code_a, 90 + i, "collision fixture");
+    }
+    spu_context* ctx = calloc(1, sizeof *ctx);
+    CHECK(ctx != NULL);
+    if (!ctx) return;
+    for (unsigned i = 0; i < 2; i++) {
+        spu_lifted_thread_desc d = {0};
+        d.entry = 0xD0; d.img_ea = 0x18400 + i * 0x100;
+        CHECK(spu_lifted_thread_available(d.entry, d.img_ea));
+        spu_lifted_thread_setup(ctx, &d);
+        CHECK(ctx->image_id == (int)(90 + i));
+    }
+    CHECK(!spu_lifted_thread_available(0xD0, 0x18600));
+    free(ctx);
+}
