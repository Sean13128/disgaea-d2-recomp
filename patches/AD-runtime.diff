  *
  * All three path translators call this -- sys_fs, cellFs and ppu_fs each do
  * their own translation (see docs), and a guest path can arrive at any of them. */
+/* Disc ports select an installed title update with PS3_GAME_UPDATE_ID. Only
+ * existing USRDIR files overlay disc assets; DLC and explicit hdd0 paths keep
+ * their own mount. All filesystem entry points share this helper. */
+static int ps3_vfs_game_overlay(char* path, size_t cap)
+{
+    const char* title = getenv("PS3_GAME_UPDATE_ID");
+    const char* hdd0 = getenv("PS3_HDD0_ROOT");
+    const char* disc = getenv("PS3_VFS_ROOT");
+    if (!path || !title || !*title || !hdd0 || !disc) return 0;
+    if (strspn(title, "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_") != strlen(title)) return 0;
+    size_t n = strlen(disc);
+    if (strncmp(path, disc, n) || path[n] != '/') return 0;
+    const char* rel = path + n;
+    if (!strncmp(rel, "/PS3_GAME/USRDIR/", 17)) rel += 17;
+    else if (!strncmp(rel, "/USRDIR/", 8)) rel += 8;
+    else return 0;
+    char update[1024];
+    snprintf(update, sizeof update, "%s/game/%s/USRDIR/%s", hdd0, title, rel);
+    struct stat st;
+    if (stat(update, &st) || (st.st_mode & S_IFMT) != S_IFREG) return 0;
+    snprintf(path, cap, "%s", update);
+    return 1;
+}
