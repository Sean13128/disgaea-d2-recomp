+static void sceNpDrmIsAvailable(ppu_context* ctx)
+{
+    uint32_t key_ea = (uint32_t)ctx->gpr[3], path_ea = (uint32_t)ctx->gpr[4];
+    if (!path_ea || !fs_guest_range(path_ea, 1) ||
+        (key_ea && !fs_guest_range(key_ea, 16))) {
+        ctx->gpr[3] = 0x80029502u; return;
+    }
+    char guest[1024], host[1100], cache[1200];
+    guest_strcpy(guest, path_ea, sizeof guest);
+    host_path(host, sizeof host, guest);
+    FILE* f = fopen(host, "rb");
+    uint32_t result = 0;
+    if (!f) result = 0x80010006u;
+    else {
+        fclose(f);
+        if (edat_is_npd(host)) {
+            uint8_t key[16] = {0};
+            if (key_ea) memcpy(key, vm_base + key_ea, 16);
+            if (!edat_resolve_key(host, cache, sizeof cache, key)) result = 0x80029513u;
+        }
+    }
+    fprintf(stderr, "[NPDRM] %s path='%s' caller=0x%08X result=0x%08X\n",
+            result ? "rejected" : "accepted", guest, (uint32_t)ctx->lr, result);
+    ctx->gpr[3] = result;
