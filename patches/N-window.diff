+/* Scale only the presentation layer. Guest targets and viewports keep their
+ * original pixel dimensions, including when entering a Retina full screen. */
+@interface Ps3MetalView : NSView
+@end
+@implementation Ps3MetalView
+- (void)layout
+{
+    [super layout];
+    CGSize pixels = s_layer.drawableSize;
+    if (!pixels.width || !pixels.height) return;
+    NSRect bounds = self.bounds;
+    CGFloat scale = MIN(bounds.size.width / pixels.width, bounds.size.height / pixels.height);
+    CGSize size = CGSizeMake(pixels.width * scale, pixels.height * scale);
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    s_layer.frame = CGRectMake((bounds.size.width - size.width) / 2,
+                              (bounds.size.height - size.height) / 2,
+                              size.width, size.height);
+    [CATransaction commit];
+}
+@end
+
+@interface Ps3MetalWindow : NSWindow
+@end
+@implementation Ps3MetalWindow
+- (BOOL)performKeyEquivalent:(NSEvent*)event
+{
+    NSEventModifierFlags flags = event.modifierFlags &
+        (NSEventModifierFlagCommand | NSEventModifierFlagControl |
+         NSEventModifierFlagOption | NSEventModifierFlagShift);
+    if ([event.charactersIgnoringModifiers.lowercaseString isEqualToString:@"f"] &&
+        (flags == NSEventModifierFlagCommand ||
+         flags == (NSEventModifierFlagCommand | NSEventModifierFlagControl))) {
+        [self toggleFullScreen:nil];
+        fprintf(stderr, "[RSX metal] fullscreen toggle\n");
+        return YES;
+    }
+    return [super performKeyEquivalent:event];
+}
+@end
