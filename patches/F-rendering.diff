+/* NV0039 memory-to-memory transfers (libgcm's default subchannel 1). */
+static struct {
+    u32 src_dma, dst_dma, src_offset, dst_offset;
+    s32 src_pitch, dst_pitch;
+    u32 length, count, format;
+} s_nv0039 = { .src_dma = 0xFEED0001u, .dst_dma = 0xFEED0000u };
+
+static u32 nv0039_address(u32 dma, s64 offset, u32 bytes)
+{
+    if (offset < 0 || (u64)offset + bytes > 0x100000000ull) return 0;
+    if (dma == 0xFEED0000u) {
+        if ((u64)offset + bytes > s_config.localSize) return 0;
+        return cellGcmResolveLocated(1, (u32)offset);
+    }
+    if (dma != 0xFEED0001u) return 0;
+    const u32 ea = cellGcmResolveIO((u32)offset);
+    if (!ea || (u64)ea + bytes > 0x100000000ull ||
+        cellGcmResolveIO((u32)offset + bytes - 1u) != ea + bytes - 1u)
+        return 0;
+    return ea;
+}
+
+static void nv0039_copy(void)
+{
+    const u32 in_stride = s_nv0039.format & 0xFFu;
+    const u32 out_stride = (s_nv0039.format >> 8) & 0xFFu;
+    const u64 total = (u64)s_nv0039.length * s_nv0039.count;
+    if (!total) return;
+    if (in_stride < 1 || in_stride > 4 || out_stride < 1 || out_stride > 4 ||
+        total > (256u << 20)) {
+        fprintf(stderr, "[NV0039] rejected transfer length=%u count=%u format=%04X\n",
+                s_nv0039.length, s_nv0039.count, s_nv0039.format);
+        return;
+    }
+    const u32 in_bytes = (s_nv0039.length - 1u) * in_stride + 1u;
+    const u32 out_bytes = (s_nv0039.length - 1u) * out_stride + 1u;
+    /* Validate every row before writing. Snapshot input to preserve overlapping
+     * and negative-pitch transfers, including byte-stride channel gathers. */
+    for (u32 y = 0; y < s_nv0039.count; y++) {
+        if (!nv0039_address(s_nv0039.src_dma,
+                            (s64)s_nv0039.src_offset + (s64)y * s_nv0039.src_pitch, in_bytes) ||
+            !nv0039_address(s_nv0039.dst_dma,
+                            (s64)s_nv0039.dst_offset + (s64)y * s_nv0039.dst_pitch, out_bytes)) {
+            fprintf(stderr, "[NV0039] rejected unmapped/out-of-range row %u\n", y);
+            return;
+        }
+    }
+    u8* copy = (u8*)malloc((size_t)total);
+    if (!copy) return;
+    for (u32 y = 0; y < s_nv0039.count; y++) {
+        const u8* src = vm_base + nv0039_address(s_nv0039.src_dma,
+            (s64)s_nv0039.src_offset + (s64)y * s_nv0039.src_pitch, in_bytes);
+        u8* row = copy + (size_t)y * s_nv0039.length;
+        if (in_stride == 1) memcpy(row, src, s_nv0039.length);
+        else for (u32 x = 0; x < s_nv0039.length; x++) row[x] = src[x * in_stride];
+    }
+    for (u32 y = 0; y < s_nv0039.count; y++) {
+        u8* dst = vm_base + nv0039_address(s_nv0039.dst_dma,
+            (s64)s_nv0039.dst_offset + (s64)y * s_nv0039.dst_pitch, out_bytes);
+        const u8* row = copy + (size_t)y * s_nv0039.length;
+        if (out_stride == 1) memcpy(dst, row, s_nv0039.length);
+        else for (u32 x = 0; x < s_nv0039.length; x++) dst[x * out_stride] = row[x];
+    }
+    free(copy);
+    { static u32 logs; if (logs++ < 24)
+        fprintf(stderr, "[NV0039] copied %ux%u stride=%u/%u %08X:%08X -> %08X:%08X\n",
+                s_nv0039.length, s_nv0039.count, in_stride, out_stride,
+                s_nv0039.src_dma, s_nv0039.src_offset, s_nv0039.dst_dma, s_nv0039.dst_offset); }
+}
 
