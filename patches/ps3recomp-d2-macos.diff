diff --git a/libs/video/cellGcm_fifo_snapshot.h b/libs/video/cellGcm_fifo_snapshot.h
new file mode 100644
index 0000000..38e0f82
--- /dev/null
+++ b/libs/video/cellGcm_fifo_snapshot.h
@@ -0,0 +1,187 @@
+/* Internal FIFO staging. One copy worker, one render consumer. Guest command
+ * bytes are immutable here; referenced vertex/texture memory stays live. */
+void* cellGcm_fifo_kick_event(void);
+
+#define GCM_HOST_SLOTS 64u
+#define GCM_HOST_BYTES 65536u
+static struct { u32 used; _Alignas(8) u8 data[GCM_HOST_BYTES]; } s_host_slots[GCM_HOST_SLOTS];
+static atomic_ullong s_host_head, s_host_tail, s_host_executed;
+static u64 s_host_submitted;
+static u32 s_host_get, s_host_call, s_host_read;
+static int s_host_initialized;
+static SRWLOCK s_host_copy_lock = SRWLOCK_INIT;
+static HANDLE s_host_event;
+static atomic_int s_host_started;
+/* Records include the resolved successor, so branches never reread a reused
+ * guest ring. Tickets disambiguate identical offsets on successive laps. */
+typedef struct { u64 ticket; u32 off, next, size, ea; } GcmHostPacket;
+static const GcmHostPacket* s_host_packet;
+
+static int gcm_host_copy_bytes(void* dst, u32 off, u32 size)
+{
+    while (size) {
+        u32 ea = gcm_io2ea(off);
+        if (!ea) return 0;
+        u32 n = 0x100000u - (off & 0xfffffu);
+        if (n > size) n = size;
+        memcpy(dst, vm_base + ea, n);
+        dst = (u8*)dst + n; off += n; size -= n;
+    }
+    return 1;
+}
+
+/* Called on the copy worker, or to establish a direct HLE flip boundary.
+ * Never takes the render lock or executes a guest-visible command. */
+static u64 gcm_host_snapshot(int flip_buffer)
+{
+    AcquireSRWLockExclusive(&s_host_copy_lock);
+    if (!s_host_initialized) {
+        s_host_get = vm_read32(GCM_CONTROL_GUEST_ADDR + 4);
+        s_host_initialized = 1;
+    }
+    u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR);
+    atomic_thread_fence(memory_order_acquire);
+    u32 budget = 0x100000;
+    while (s_host_get != put && budget) {
+        u64 tail = s_host_tail;
+        while (tail - atomic_load_explicit(&s_host_head, memory_order_acquire) >= GCM_HOST_SLOTS) {
+            u64 generation = gcm_progress_begin();
+            if (tail - s_host_head < GCM_HOST_SLOTS) break;
+            gcm_progress_wait(generation, 100);
+            if (!s_gcm_initialized) goto done;
+        }
+        u32 used = 0;
+        while (s_host_get != put && budget) {
+            budget--;
+            u32 raw, off = s_host_get;
+            if (!gcm_host_copy_bytes(&raw, off, 4)) goto publish;
+            u32 w = ps3_bswap32(raw), type = w >> 29;
+            u32 size = 4, next = off + 4, call = s_host_call;
+            int branch = (w & 0xffff0000u) != 0xfead0000u;
+            if (branch && type == 1) next = w & 0x1ffffffcu;
+            else if (branch && (w & 3u) == 2) { next = w & 0x1ffffffcu; call = off + 4; }
+            else if (branch && w == 0x00020000u) { next = call; call = 0; }
+            else {
+                branch = 0;
+                if (type == 0 || type == 2) size += ((w >> 18) & 0x7ffu) * 4;
+                next = off + size;
+            }
+            /* A partial packet at the committed write head is not readable.
+             * Subroutine bodies outside the linear ring are reached by CALL. */
+            if ((!branch && off < put && (u64)off + size > put) ||
+                (branch && (next == off || !gcm_io2ea(next)))) goto publish;
+            u32 span = (sizeof(GcmHostPacket) + size + 7u) & ~7u;
+            if (used + span > GCM_HOST_BYTES) break;
+            GcmHostPacket* p = (GcmHostPacket*)((u8*)s_host_slots[tail % GCM_HOST_SLOTS].data + used);
+            if (!gcm_host_copy_bytes(p + 1, off, size)) goto publish;
+            p->ticket = ++s_host_submitted;
+            p->off = off; p->next = next; p->size = size; p->ea = gcm_io2ea(off);
+            used += span;
+            s_host_get = next; s_host_call = call;
+        }
+    publish:
+        if (!used) break;
+        s_host_slots[tail % GCM_HOST_SLOTS].used = used;
+        atomic_store_explicit(&s_host_tail, tail + 1, memory_order_release);
+        /* Copy publication precedes GET: the producer may now overwrite every
+         * byte consumed above, including a JUMP at the end of a ring lap. */
+        vm_write32(GCM_CONTROL_GUEST_ADDR + 4, s_host_get);
+        atomic_store_explicit(&g_gcm_fifo_drained_ea, gcm_io2ea(s_host_get), memory_order_release);
+        ps3_poll_notify(GCM_CONTROL_GUEST_ADDR + 4, 4);
+        gcm_progress_notify();
+        SetEvent((HANDLE)cellGcm_fifo_kick_event());
+    }
+ done:;
+    u64 ticket = s_host_submitted;
+    /* Arm a direct flip while the copy lock still excludes later submissions.
+     * A render slice already in flight observes this ticket on every packet. */
+    if (flip_buffer >= 0)
+        gcm_queue_flip_at((u32)flip_buffer, 1, put, ticket);
+    ReleaseSRWLockExclusive(&s_host_copy_lock);
+    return ticket;
+}
+
+static int gcm_host_peek(u64 limit)
+{
+    if (s_host_head == atomic_load_explicit(&s_host_tail, memory_order_acquire)) return 0;
+    s_host_packet = (const GcmHostPacket*)((const u8*)s_host_slots[s_host_head % GCM_HOST_SLOTS].data + s_host_read);
+    u64 boundary = s_host_flip_ticket;
+    if (boundary < limit) limit = boundary;
+    if (s_host_packet->ticket > limit) { s_host_packet = NULL; return 0; }
+    s_fifo_getoff = s_host_packet->off;
+    return 1;
+}
+
+static void gcm_host_finish(void)
+{
+    if (!s_host_enabled) return;
+    s_fifo_getoff = s_host_packet->next;
+    atomic_store_explicit(&s_host_executed, s_host_packet->ticket, memory_order_release);
+    s_host_read += (sizeof(GcmHostPacket) + s_host_packet->size + 7u) & ~7u;
+    if (s_host_read == s_host_slots[s_host_head % GCM_HOST_SLOTS].used) {
+        s_host_read = 0;
+        atomic_fetch_add_explicit(&s_host_head, 1, memory_order_release);
+        gcm_progress_notify();
+    }
+    s_host_packet = NULL;
+}
+
+static u32 gcm_command_read(u32 off)
+{
+    if (!s_host_enabled) return vm_read32(gcm_io2ea(off));
+    u32 raw;
+    memcpy(&raw, (const u8*)(s_host_packet + 1) + off - s_host_packet->off, 4);
+    return ps3_bswap32(raw);
+}
+
+static DWORD WINAPI gcm_host_worker(LPVOID unused)
+{
+    (void)unused;
+    ps3_poll_thread_start("RSX copy", 1);
+    while (s_gcm_initialized) {
+        WaitForSingleObject(s_host_event, 100);
+        if (s_gcm_initialized) gcm_host_snapshot(-1);
+    }
+    s_host_started = 0;
+    return 0;
+}
+
+static void gcm_host_start(void)
+{
+    int expected = 0;
+    if (s_host_enabled && s_gcm_initialized &&
+        atomic_compare_exchange_strong(&s_host_started, &expected, 1)) {
+        HANDLE thread = CreateThread(NULL, 0, gcm_host_worker, NULL, 0, NULL);
+        if (thread) CloseHandle(thread);
+        else { s_host_started = 0; fprintf(stderr, "[cellGcmSys] FIFO copy worker creation failed\n"); abort(); }
+    }
+}
+
+void cellGcm_fifo_enable_snapshot(void)
+{
+    /* Runner enables before the first drain. Legacy consumers keep their
+     * synchronous API; GCM_FIFO_SNAPSHOT=0 permits matched host comparisons. */
+    if (s_host_enabled) return;
+    const char* e = getenv("GCM_FIFO_SNAPSHOT");
+    if (e && !atoi(e)) return;
+    s_host_event = CreateEventA(NULL, FALSE, TRUE, NULL);
+    if (!s_host_event) abort();
+    s_host_enabled = 1;
+}
+
+static void gcm_host_shutdown(void)
+{
+    if (!s_host_enabled) return;
+    gcm_progress_notify();
+    SetEvent(s_host_event);
+    while (s_host_started) Sleep(1);
+    AcquireSRWLockExclusive(&s_host_copy_lock);
+    AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    s_host_head = s_host_tail = s_host_executed = 0;
+    s_host_submitted = 0;
+    s_host_get = s_host_call = s_host_read = 0;
+    s_host_packet = NULL;
+    s_host_initialized = 0;
+    ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
+    ReleaseSRWLockExclusive(&s_host_copy_lock);
+}
