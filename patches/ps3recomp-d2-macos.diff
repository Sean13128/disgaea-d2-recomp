+    if (std::getenv("PS3RECOMP_AVC_TRACE")) std::fprintf(stderr, "[cellVdec] GetPicItem next=%u pts=%llu pending=%zu\n",
+        v->count + 1, (unsigned long long)f->pts, v->frames.size());
+    if (std::getenv("PS3RECOMP_CODEC_TRACE")) std::fprintf(stderr, "[cellVdec] progress AUDONE=%u PICOUT=%u jobs=%zu working=%d consumed=%u\n",
+        v->audone.load(), v->picout.load(), v->jobs.size(), v->working, v->count);
+    memset(vm_ptr8(it), 0, 512);
+    vm_write32(it, v->codec); vm_write32(it + 8, f->width * f->height * 3 / 2); vm_write8(it + 12, 1);
+    vm_write64(it + 16, f->pts); vm_write64(it + 24, UINT64_MAX); vm_write64(it + 32, f->dts); vm_write64(it + 40, UINT64_MAX);
+    vm_write64(it + 48, f->user); vm_write32(it + 72, info);
+    vm_write16(info, f->width); vm_write16(info + 2, f->height);
+    vm_write8(info + 12, 0); /* progressive frame */
+    vm_write8(info + 18, 1); vm_write8(info + 19, 1); /* VUI, frame_mbs_only */
+    vm_write8(info + 22, f->full_range); vm_write8(info + 23, 1);
+    vm_write8(info + 26, f->matrix); vm_write8(info + 27, 1);
+    vm_write8(info + 28, f->frame_rate_code); vm_write8(info + 29, 1);
+    vm_write32(GUEST_EA(item), it); return CELL_OK;
+}
+s32 cellVdecGetPicture(CellVdecHandle h, const void* format, void* out)
+{
+    VdecSlot* v = slot(h); if (!v || !format) return (s32)CELL_VDEC_ERROR_ARG;
+    u32 ea = GUEST_EA(format), fmt = vm_read32(ea), matrix = vm_read32(ea + 4);
+    if (fmt > 3 || matrix > 1) return (s32)CELL_VDEC_ERROR_ARG;
+    std::lock_guard<std::mutex> lock(v->mutex); if (v->frames.empty()) return (s32)CELL_VDEC_ERROR_EMPTY;
+    AvcFrame* f = &v->frames.front().frame;
+    if (out && video_convert(f->yuv, f->width, f->height, 0, 0, f->width, f->height, vm_ptr8(GUEST_EA(out)),
+        f->width, f->height, 0, 0, f->width, f->height, fmt, matrix, f->full_range ? 0 : 1, vm_read8(ea + 8))) return (s32)CELL_VDEC_ERROR_ARG;
+    if (++v->count <= 3 || !(v->count % 120) || std::getenv("PS3RECOMP_AVC_TRACE")) std::printf("[cellVdec] picture=%u %ux%u pts=%llu\n", v->count, f->width, f->height, (unsigned long long)f->pts);
+    avc_frame_release(f); v->frames.pop_front(); v->changed.notify_all(); return CELL_OK;
 }
+s32 cellVdecSetFrameRate(CellVdecHandle h, u32 code)
+{ (void)code; return slot(h) ? CELL_OK : (s32)CELL_VDEC_ERROR_ARG; }
