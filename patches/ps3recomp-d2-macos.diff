diff --git a/libs/codec/avc_packet.h b/libs/codec/avc_packet.h
new file mode 100644
index 0000000..e2bac35
--- /dev/null
+++ b/libs/codec/avc_packet.h
@@ -0,0 +1,76 @@
+/* Shared Annex-B -> AVCC packaging for VT and the strict offline checker.
+ * Lengths exclude byte-stream trailing_zero_8bits; EBSP bytes (including
+ * emulation prevention) and every slice/parameter set remain intact. */
+#ifndef PS3RECOMP_AVC_PACKET_H
+#define PS3RECOMP_AVC_PACKET_H
+#include "avc_sps.h"
+#include <vector>
+#include <cstdio>
+#include <cstdint>
+struct AvcPacket {
+    std::vector<uint8_t> bytes;
+    bool picture = false, idr = false, changed = false;
+    unsigned slices = 0, delay = 0;
+    bool timed = false;
+};
+/* Sparse PES clock anchors plus SEI display delay, shared by VT and tests. */
+struct AvcClock {
+    uint64_t count = 0;
+    int64_t base = 0;
+    bool valid = false;
+    void stamp(const AvcSpsInfo& info, const AvcPacket& packet, uint64_t& pts, uint64_t& dts)
+    {
+        uint64_t offset = count * 180000ull * info.units / info.scale;
+        if (dts != UINT64_MAX) { base = (int64_t)dts - (int64_t)offset; valid = true; }
+        else if (!valid && pts != UINT64_MAX) {
+            base = (int64_t)pts - (int64_t)offset -
+                (int64_t)(packet.delay * 90000ull * info.units / info.scale); valid = true;
+        }
+        if (dts == UINT64_MAX) dts = (uint64_t)(base + (int64_t)offset);
+        if (pts == UINT64_MAX) pts = dts + (packet.timed ? packet.delay * 90000ull * info.units / info.scale : 0);
+        count++;
+    }
+};
+static inline size_t avc_startcode(const uint8_t* p, size_t n, size_t at, size_t* prefix)
+{
+    for (; at + 3 <= n; at++) if (!p[at] && !p[at + 1]) {
+        if (p[at + 2] == 1) { *prefix = 3; return at; }
+        if (at + 4 <= n && !p[at + 2] && p[at + 3] == 1) { *prefix = 4; return at; }
+    }
+    *prefix = 0; return n;
+}
+static inline int avc_packet(const uint8_t* p, size_t n, std::vector<uint8_t>& sps,
+    std::vector<uint8_t>& pps, AvcSpsInfo& info, AvcPacket& packet, FILE* trace = nullptr)
+{
+    size_t prefix, pos = avc_startcode(p, n, 0, &prefix);
+    if (pos == n) return -1;
+    for (size_t i = 0; i < pos; i++) if (p[i]) return -1;
+    unsigned auds = 0;
+    while (pos < n) {
+        size_t begin = pos + prefix, nextPrefix, next = avc_startcode(p, n, begin, &nextPrefix), end = next;
+        while (end > begin && !p[end - 1]) end--;
+        if (end == begin || (p[begin] & 128)) return -1;
+        unsigned type = p[begin] & 31;
+        if (trace) std::fprintf(trace, " %u:%zu(sc=%zu,zero=%zu)", type, end - begin, prefix, next - end);
+        if (type == 7 || type == 8) {
+            auto& set = type == 7 ? sps : pps;
+            std::vector<uint8_t> value(p + begin, p + end);
+            if (value != set) { packet.changed = true; set = std::move(value); }
+            if (type == 7 && avc_parse_sps(sps.data(), sps.size(), &info)) return -1;
+        }
+        if (type == 9 && ++auds > 1) return -1; /* two pictures merged */
+        if (type == 1 || type == 5) { packet.picture = true; packet.slices++; packet.idr |= type == 5; }
+        if (type == 6 && !avc_parse_picture_timing(p + begin, end - begin, &info, &packet.delay)) packet.timed = true;
+        if (type != 9 && type != 12) {
+            uint32_t len = (uint32_t)(end - begin);
+            packet.bytes.push_back(len >> 24); packet.bytes.push_back(len >> 16);
+            packet.bytes.push_back(len >> 8); packet.bytes.push_back(len);
+            packet.bytes.insert(packet.bytes.end(), p + begin, p + end);
+        }
+        pos = next; prefix = nextPrefix;
+    }
+    if (trace) std::fprintf(trace, " slices=%u idr=%u changed=%u frame_only=%u delay=%u\n",
+        packet.slices, packet.idr, packet.changed, info.frame_only, packet.delay);
+    return packet.picture && (sps.empty() || pps.empty()) ? -1 : 0;
+}
+#endif
diff --git a/libs/codec/avc_sps.c b/libs/codec/avc_sps.c
new file mode 100644
index 0000000..81e2d70
--- /dev/null
+++ b/libs/codec/avc_sps.c
@@ -0,0 +1,131 @@
+/* Bounded SPS/VUI reader for frame dimensions, color and clock metadata. */
+#include "avc_sps.h"
+#include <stdlib.h>
+#include <string.h>
+typedef struct { uint8_t* p; size_t bytes, bit; int error; } Bits;
+static unsigned read_bits(Bits* b, unsigned n)
+{
+    if (n > 32 || b->bit + n > b->bytes * 8) { b->error = 1; return 0; }
+    unsigned v = 0;
+    while (n--) { v = (v << 1) | ((b->p[b->bit / 8] >> (7 - b->bit % 8)) & 1); b->bit++; }
+    return v;
+}
+static unsigned ue(Bits* b)
+{
+    unsigned n = 0;
+    while (!b->error && !read_bits(b, 1)) { if (++n > 30) { b->error = 1; return 0; } }
+    return ((1u << n) - 1) + read_bits(b, n);
+}
+static int se(Bits* b) { unsigned v = ue(b); return v & 1 ? (int)((v + 1) / 2) : -(int)(v / 2); }
+static void hrd(Bits* b, AvcSpsInfo* info)
+{
+    unsigned count = ue(b) + 1;
+    if (count > 32) { b->error = 1; return; }
+    read_bits(b, 8);
+    while (count--) { ue(b); ue(b); read_bits(b, 1); }
+    read_bits(b, 5);
+    info->cpb_delay_bits = read_bits(b, 5) + 1;
+    info->dpb_delay_bits = read_bits(b, 5) + 1;
+    read_bits(b, 5);
+}
+static int rbsp(Bits* b, const uint8_t* p, size_t n)
+{
+    b->p = malloc(n); if (!b->p) return -1;
+    for (size_t i = 1; i < n; i++) {
+        if (i >= 3 && p[i] == 3 && !p[i - 1] && !p[i - 2]) continue;
+        b->p[b->bytes++] = p[i];
+    }
+    return 0;
+}
+int avc_parse_picture_timing(const uint8_t* p, size_t n, const AvcSpsInfo* info, unsigned* delay)
+{
+    if (!p || !info || !delay || n < 2 || n > 65536 || (p[0] & 31) != 6 || !info->dpb_delay_bits) return -1;
+    Bits b = {0}; if (rbsp(&b, p, n)) return -1;
+    int result = -1;
+    for (size_t off = 0; off + 2 <= b.bytes;) {
+        unsigned type = 0, size = 0;
+        while (off < b.bytes && b.p[off] == 255) { type += 255; off++; }
+        if (off == b.bytes) break;
+        type += b.p[off++];
+        while (off < b.bytes && b.p[off] == 255) { size += 255; off++; }
+        if (off == b.bytes) break;
+        size += b.p[off++];
+        if (size > b.bytes - off) break;
+        if (type == 1 && size * 8 >= info->cpb_delay_bits + info->dpb_delay_bits) {
+            b.bit = off * 8; read_bits(&b, info->cpb_delay_bits);
+            *delay = read_bits(&b, info->dpb_delay_bits); result = b.error ? -1 : 0; break;
+        }
+        off += size;
+    }
+    free(b.p); return result;
+}
+int avc_parse_sps(const uint8_t* p, size_t n, AvcSpsInfo* out)
+{
+    if (!p || !out || n < 4 || n > 65536 || (p[0] & 31) != 7) return -1;
+    Bits b = {0}; if (rbsp(&b, p, n)) return -1;
+    AvcSpsInfo info = {0}; info.matrix = 1; info.units = 1001; info.scale = 60000;
+    unsigned profile = read_bits(&b, 8); read_bits(&b, 16); ue(&b);
+    unsigned chroma = 1, separate = 0;
+    if (profile == 100 || profile == 110 || profile == 122 || profile == 244 || profile == 44 ||
+        profile == 83 || profile == 86 || profile == 118 || profile == 128 || profile == 138 || profile == 139 || profile == 134 || profile == 135) {
+        chroma = ue(&b); if (chroma > 3) b.error = 1;
+        if (chroma == 3) separate = read_bits(&b, 1);
+        ue(&b); ue(&b); read_bits(&b, 1);
+        if (read_bits(&b, 1)) for (unsigned i = 0; i < (chroma == 3 ? 12u : 8u); i++) if (read_bits(&b, 1)) {
+            int last = 8, next = 8;
+            for (unsigned j = 0; j < (i < 6 ? 16u : 64u); j++) {
+                if (next) next = (last + se(&b) + 256) & 255;
+                last = next ? next : last;
+            }
+        }
+    }
+    ue(&b); unsigned poc = ue(&b);
+    if (!poc) ue(&b);
+    else if (poc == 1) {
+        read_bits(&b, 1); se(&b); se(&b); unsigned count = ue(&b);
+        if (count > 256) b.error = 1; else while (count--) se(&b);
+    } else if (poc > 2) b.error = 1;
+    ue(&b); read_bits(&b, 1);
+    unsigned mw = ue(&b) + 1, mh = ue(&b) + 1;
+    info.frame_only = read_bits(&b, 1);
+    if (!info.frame_only) read_bits(&b, 1);
+    read_bits(&b, 1);
+    unsigned left = 0, right = 0, top = 0, bottom = 0;
+    if (read_bits(&b, 1)) { left = ue(&b); right = ue(&b); top = ue(&b); bottom = ue(&b); }
+    unsigned cx = chroma == 1 || chroma == 2 ? 2 : 1;
+    unsigned cy = (chroma == 1 ? 2 : 1) * (2 - info.frame_only);
+    if (separate || chroma == 0) { cx = 1; cy = 2 - info.frame_only; }
+    if (mw > 512 || mh > 512 || (left + right) * cx >= mw * 16 || (top + bottom) * cy >= mh * 16 * (2 - info.frame_only)) b.error = 1;
+    info.width = mw * 16 - (left + right) * cx;
+    info.height = mh * 16 * (2 - info.frame_only) - (top + bottom) * cy;
+    if (read_bits(&b, 1)) {
+        if (read_bits(&b, 1)) { unsigned aspect = read_bits(&b, 8); if (aspect == 255) read_bits(&b, 32); }
+        if (read_bits(&b, 1)) read_bits(&b, 1);
+        if (read_bits(&b, 1)) {
+            read_bits(&b, 3); info.full_range = read_bits(&b, 1);
+            if (read_bits(&b, 1)) { read_bits(&b, 16); info.matrix = read_bits(&b, 8); }
+        }
+        if (read_bits(&b, 1)) { ue(&b); ue(&b); }
+        if (read_bits(&b, 1)) { info.units = read_bits(&b, 32); info.scale = read_bits(&b, 32); read_bits(&b, 1); }
+        unsigned nal_hrd = read_bits(&b, 1); if (nal_hrd) hrd(&b, &info);
+        unsigned vcl_hrd = read_bits(&b, 1); if (vcl_hrd) hrd(&b, &info);
+        if (nal_hrd || vcl_hrd) read_bits(&b, 1);
+        info.pic_struct = read_bits(&b, 1);
+        if (read_bits(&b, 1)) {
+            read_bits(&b, 1); ue(&b); ue(&b); ue(&b); ue(&b);
+            info.max_reorder = ue(&b); ue(&b);
+            if (info.max_reorder > 16) b.error = 1;
+        }
+    }
+    if (!info.units || !info.scale) b.error = 1;
+    /* Firmware frame-rate codes, as distinct from the universal 0x80 codes. */
+    static const unsigned num[] = {24000,24,25,30000,30,50,60000,60};
+    static const unsigned den[] = {1001,1,1,1001,1,1,1001,1};
+    uint64_t best = UINT64_MAX;
+    for (unsigned i = 0; i < 8; i++) {
+        int64_t delta = (int64_t)info.scale * den[i] - (int64_t)num[i] * 2 * info.units;
+        uint64_t dist = (uint64_t)(delta < 0 ? -delta : delta) / den[i];
+        if (dist < best) { best = dist; info.frame_rate_code = i; }
+    }
+    free(b.p); if (b.error) return -1; *out = info; return 0;
+}
