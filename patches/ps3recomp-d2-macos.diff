@@ -0,0 +1,96 @@
+#import "../rsx_metal_overlay.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+uint16_t ps3_pad_host_buttons(void) { return 0; }
+void ps3_pad_overlay_capture(int active) { (void)active; }
+static void ppm(const char* path, const unsigned char* pixels)
+{
+    FILE* file = fopen(path, "wb"); assert(file);
+    fprintf(file, "P6\n1280 720\n255\n");
+    for (size_t i = 0; i < 1280 * 720; i++) {
+        unsigned char rgb[] = { pixels[i*4+2], pixels[i*4+1], pixels[i*4] };
+        fwrite(rgb, 1, 3, file);
+    }
+    fclose(file);
+}
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        unsigned char* pixels = malloc(1280 * 720 * 4); assert(pixels);
+        SysOverlaySnapshot ui = {0}; ui.buttons = 1;
+        strcpy(ui.title, "Load saved data"); strcpy(ui.message, "There is no saved data.");
+        rsx_metal_overlay_raster(&ui, pixels);
+        assert(pixels[3] > 100 && pixels[3] < 150); /* translucent backdrop */
+        size_t panel = (150 * 1280 + 180) * 4;
+        assert(pixels[panel + 3] == 255);
+        /* A white guest title behind any part of the panel contributes zero
+         * to composition; outside the panel the backdrop remains translucent. */
+        for (unsigned y = 105; y < 615; y++) for (unsigned x = 170; x < 1110; x++)
+            assert(pixels[(y * 1280 + x) * 4 + 3] == 255);
+        puts("[AH-test] opaque panel rejects guest text bleed-through: PASS");
+        ppm("port/runs/P-overlay-notice.ppm", pixels);
+        ui.kind = SYS_OVERLAY_LIST; ui.count = 8; ui.selected = 6;
+        strcpy(ui.message, "Choose a save slot.");
+        for (int i = 0; i < 8; i++) snprintf(ui.items[i].label, 96, "BLUS31313_NORMAL_%02d", i);
+        rsx_metal_overlay_raster(&ui, pixels); ppm("port/runs/P-overlay-list.ppm", pixels);
+        puts("[P-test] CoreText bitmap alpha/layout and scrollable list raster: PASS");
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        if (!device) {
+            free(pixels); puts("[P-test] Metal composition SKIP: no device in sandbox");
+            return argc > 1 && !strcmp(argv[1], "--metal") ? 77 : 0;
+        }
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        rsx_metal_overlay_init(device, queue, nil, nil);
+        ps3_overlay_set_renderer(1);
+        ui.kind = SYS_OVERLAY_NOTICE; ui.count = 0;
+        strcpy(ui.message, "There is no saved data.");
+        uint64_t token = ps3_overlay_open(&ui, SYS_OVERLAY_OK); assert(token);
+        MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+            width:1280 height:720 mipmapped:NO];
+        desc.storageMode = MTLStorageModeShared; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        id<MTLTexture> guest = [device newTextureWithDescriptor:desc];
+        id<MTLTexture> display = [device newTextureWithDescriptor:desc];
+        for (size_t i = 0; i < 1280 * 720; i++) {
+            pixels[i*4] = 40; pixels[i*4+1] = 100; pixels[i*4+2] = 160; pixels[i*4+3] = 255;
+        }
+        [guest replaceRegion:MTLRegionMake2D(0,0,1280,720) mipmapLevel:0 withBytes:pixels bytesPerRow:1280*4];
+        [display replaceRegion:MTLRegionMake2D(0,0,1280,720) mipmapLevel:0 withBytes:pixels bytesPerRow:1280*4];
+        id<MTLCommandBuffer> cb = [queue commandBuffer];
+        rsx_metal_overlay_encode(cb, guest, display); [cb commit]; rsx_metal_overlay_end(); [cb waitUntilCompleted];
+        assert(cb.status != MTLCommandBufferStatusError);
+        [display getBytes:pixels bytesPerRow:1280*4 fromRegion:MTLRegionMake2D(0,0,1280,720) mipmapLevel:0];
+        assert(pixels[0] > 15 && pixels[0] < 25 && pixels[1] > 45 && pixels[1] < 60);
+        assert(pixels[2] > 75 && pixels[2] < 90 && pixels[3] == 255);
+        unsigned char panel_color[4]; memcpy(panel_color, pixels + panel, 4);
+        /* Switch pages over a completely different guest frame. Panel pixels
+         * must match a fresh raster, without the previous snapshot or guest. */
+        ps3_overlay_finish(token, SYS_OVERLAY_OK); ps3_overlay_take_result(token, NULL, NULL);
+        ui.kind = SYS_OVERLAY_EDITOR;
+        token = ps3_overlay_open(&ui, SYS_OVERLAY_BACK); assert(token);
+        strcpy(ui.title, "D2 cheats / Characters");
+        assert(ps3_overlay_editor_update(token, &ui));
+        memset(pixels, 255, 1280 * 720 * 4);
+        [guest replaceRegion:MTLRegionMake2D(0,0,1280,720) mipmapLevel:0 withBytes:pixels bytesPerRow:1280*4];
+        cb = [queue commandBuffer];
+        rsx_metal_overlay_encode(cb, guest, display); [cb commit]; rsx_metal_overlay_end(); [cb waitUntilCompleted];
+        assert(!cb.error);
+        [display getBytes:pixels bytesPerRow:1280*4 fromRegion:MTLRegionMake2D(0,0,1280,720) mipmapLevel:0];
+        assert(!memcmp(panel_color, pixels + panel, 4));
+        unsigned char* expected = malloc(1280 * 720 * 4); assert(expected);
+        rsx_metal_overlay_raster(&ui, expected);
+        for (unsigned y = 110; y < 184; y++) for (unsigned x = 170; x < 1110; x++) {
+            size_t offset = (y*1280+x)*4;
+            for (unsigned c = 0; c < 3; c++)
+                assert(abs((int)pixels[offset+c] - expected[offset+c]) <= 1);
+            assert(pixels[offset+3] == 255);
+        }
+        free(expected);
+        puts("[AH-test] opaque title/panel across guest and editor page changes: PASS");
+        ppm("port/runs/P-overlay-metal.ppm", pixels);
+        ps3_overlay_finish(token, SYS_OVERLAY_OK); ps3_overlay_take_result(token, NULL, NULL);
+        rsx_metal_overlay_shutdown(); free(pixels);
+        puts("[P-test] Metal guest-frame preservation + premultiplied overlay composition: PASS");
+    }
+}
