+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+#define EA(T,x) ((T*)(uintptr_t)(x))
+int main(int argc, char** argv)
+{
+    vm_base = calloc(1, 8 * 1024 * 1024); assert(vm_base);
+    vm_write32(0x1000, 1280); vm_write32(0x1004, 720); vm_write32(0x1010, 1280); vm_write32(0x1014, 720);
+    vm_write32(0x1040, 0x10000); vm_write32(0x1044, 0x10000);
+    assert(cellVpostQueryAttr(EA(CellVpostCfgParam, 0x1000), EA(void, 0x1080)) == 0);
+    assert(vm_read32(0x1080) == 0x10000 && vm_read8(0x1084) == 0);
+    assert(cellVpostOpen(EA(CellVpostCfgParam, 0x1000), EA(CellVpostResource, 0x1040), EA(u32, 0x10a0)) == 0);
+    u32 h = vm_read32(0x10a0); assert(h);
+    memset(vm_ptr8(0x20000), 16, 16); memset(vm_ptr8(0x20010), 128, 8);
+    vm_write32(0x110c, 4); vm_write32(0x1110, 4); vm_write32(0x1118, 1); vm_write32(0x111c, 1);
+    vm_write32(0x1128, 4); vm_write32(0x112c, 4);
+    vm_write32(0x1130, 4); vm_write32(0x1134, 4);
+    vm_write32(0x1138, 1); vm_write32(0x113c, 1); vm_write32(0x1140, 2); vm_write32(0x1144, 2);
+    vm_write8(0x1148, 0xa5); vm_write64(0x1150, 0x1122334455667788ull);
+    memset(vm_ptr8(0x30000), 0xcc, 68);
+    assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x30000), EA(CellVpostPictureInfo, 0x1200)) == 0);
+    assert(vm_read64(0x1248) == 0x1122334455667788ull && vm_read32(0x1224) == 4);
+    for (unsigned y = 0; y < 4; y++) for (unsigned x = 0; x < 4; x++) {
+        u32 p = 0x30000 + (y * 4 + x) * 4;
+        if (x >= 1 && x < 3 && y >= 1 && y < 3) {
+            assert(vm_read8(p) == 0 && vm_read8(p+1) == 0 && vm_read8(p+2) == 0 && vm_read8(p+3) == 0xa5);
+        } else assert(vm_read32(p) == 0xcccccccc);
+    }
+    assert(vm_read32(0x30040) == 0xcccccccc);
+    memset(vm_ptr8(0x20000), 235, 16);
+    assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x30000), EA(CellVpostPictureInfo, 0x1200)) == 0);
+    assert(vm_read32(0x30014) == 0xffffffa5);
+    memset(vm_ptr8(0x20000), 81, 16); memset(vm_ptr8(0x20010), 90, 4); memset(vm_ptr8(0x20014), 240, 4);
+    vm_write32(0x111c, 0);
+    assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x30000), EA(CellVpostPictureInfo, 0x1200)) == 0);
+    assert(vm_read32(0x30014) == 0xff0000a5); /* broadcast BT.601 red */
+    memset(vm_ptr8(0x20000), 63, 16); memset(vm_ptr8(0x20010), 102, 4); vm_write32(0x111c, 1);
+    assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x30000), EA(CellVpostPictureInfo, 0x1200)) == 0);
+    assert(vm_read32(0x30014) == 0xff0100a5); /* BT.709 red, one quantization step in G */
+    memset(vm_ptr8(0x20000), 81, 16);
+    vm_write8(0x20010, 0); vm_write8(0x20011, 255); vm_write8(0x20012, 0); vm_write8(0x20013, 255);
+    vm_write8(0x20014, 255); vm_write8(0x20015, 0); vm_write8(0x20016, 255); vm_write8(0x20017, 0);
+    assert(video_convert(vm_ptr8(0x20000), 4, 4, 0, 0, 4, 4, vm_ptr8(0x30000), 4, 4, 0, 0, 4, 4, 2, 0, 1, 255) == 0);
+    assert(vm_read32(0x30000) == 0x0051ff51 && vm_read32(0x30004) == 0xff510051);
+    vm_write32(0x1128, 5);
+    assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x30000), EA(CellVpostPictureInfo, 0x1200)) == (s32)0x806104a5);
+    printf("[K-test] vpost black/white, BT.601/709 red, UYVY pairs, scaling, window canaries, alpha, u64 guest ABI and invalid crop PASS\n");
+    if (argc > 2) {
+        FILE* f = fopen(argv[1], "rb"); assert(f);
+        assert(fread(vm_ptr8(0x20000), 1, 1280 * 720 * 3 / 2, f) == 1280 * 720 * 3 / 2); fclose(f);
+        vm_write32(0x110c, 1280); vm_write32(0x1110, 720); vm_write32(0x1128, 1280); vm_write32(0x112c, 720);
+        vm_write32(0x1130, 640); vm_write32(0x1134, 360); vm_write32(0x1138, 0); vm_write32(0x113c, 0);
+        vm_write32(0x1140, 640); vm_write32(0x1144, 360); vm_write8(0x1148, 255);
+        assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x200000), EA(CellVpostPictureInfo, 0x1200)) == 0);
+        f = fopen(argv[2], "wb"); assert(f); fprintf(f, "P6\n640 360\n255\n");
+        for (unsigned i = 0; i < 640 * 360; i++) fwrite(vm_ptr8(0x200000 + i * 4), 1, 3, f);
+        fclose(f); printf("[K-test] vpost real decoded frame -> %s\n", argv[2]);
+    }
+    assert(cellVpostClose(h) == 0); free(vm_base); return 0;
+}
diff --git a/libs/codec/tests/test_vt_mock.cpp b/libs/codec/tests/test_vt_mock.cpp
new file mode 100644
index 0000000..c5b8727
--- /dev/null
+++ b/libs/codec/tests/test_vt_mock.cpp
@@ -0,0 +1,71 @@
+/* Test-only VT interposition: synchronous, decode-order output. No H.264
+ * decoding; exercises the real guest/demux/vdec/vpost handshake in the sandbox. */
+#include <VideoToolbox/VideoToolbox.h>
+#include <cassert>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <cstdlib>
+#include <chrono>
+#include <thread>
+struct Session { VTDecompressionOutputCallbackRecord cb; CVPixelBufferRef image; };
+static std::map<VTDecompressionSessionRef, Session> sessions;
+static std::mutex mutex;
+static OSStatus create(CFAllocatorRef, CMVideoFormatDescriptionRef format,
+    CFDictionaryRef, CFDictionaryRef, const VTDecompressionOutputCallbackRecord* cb, VTDecompressionSessionRef* out)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+    *out = reinterpret_cast<VTDecompressionSessionRef>(CFDictionaryCreateMutable(nullptr, 0, nullptr, nullptr));
+    CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(format);
+    Session s{*cb, nullptr};
+    assert(CVPixelBufferCreate(nullptr, dim.width, dim.height, kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange,
+        nullptr, &s.image) == 0);
+    sessions.emplace(*out, s);
+    fprintf(stderr, "[K4-mockVT] synthetic %dx%d output; NO native decode verification; latency_us=%s pace_us=%s\n",
+        dim.width, dim.height, std::getenv("K4_MOCK_VT_LATENCY_US") ? std::getenv("K4_MOCK_VT_LATENCY_US") : "0",
+        std::getenv("K4_MOCK_VT_PACE_US") ? std::getenv("K4_MOCK_VT_PACE_US") : "0");
+    return 0;
+}
+static Boolean accepts(VTDecompressionSessionRef, CMFormatDescriptionRef) { return true; }
+static void invalidate(VTDecompressionSessionRef ref)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+    auto it = sessions.find(ref);
+    if (it != sessions.end()) { CFRelease(it->second.image); sessions.erase(it); }
+}
+static OSStatus finish(VTDecompressionSessionRef) { return 0; }
+static OSStatus wait_frames(VTDecompressionSessionRef) { return 0; }
+static OSStatus decode(VTDecompressionSessionRef ref, CMSampleBufferRef sample,
+    VTDecodeFrameFlags flags, void* tag, VTDecodeInfoFlags*)
+{
+    assert(flags == 0);
+    static unsigned count = 0;
+    const char* latency = std::getenv("K4_MOCK_VT_LATENCY_US");
+    ++count;
+    const char* start = std::getenv("K4_MOCK_VT_LATENCY_START_AU");
+    if (latency && (!start || count >= (unsigned)std::atoi(start)))
+        std::this_thread::sleep_for(std::chrono::microseconds(std::atoi(latency) / 2 + (count % 11) * std::atoi(latency) / 10));
+    const char* pace = std::getenv("K4_MOCK_VT_PACE_US");
+    if (pace) {
+        static auto next = std::chrono::steady_clock::now();
+        next += std::chrono::microseconds(std::atoi(pace));
+        std::this_thread::sleep_until(next);
+    }
+    Session s;
+    { std::lock_guard<std::mutex> lock(mutex); s = sessions.at(ref); }
+    CMSampleTimingInfo timing;
+    assert(CMSampleBufferGetSampleTimingInfo(sample, 0, &timing) == 0);
+    s.cb.decompressionOutputCallback(s.cb.decompressionOutputRefCon, tag, 0, 0, s.image,
+        timing.presentationTimeStamp, timing.duration);
+    return 0;
+}
+#define INTERPOSE(replacement, original) \
+    __attribute__((used)) static const struct { const void* replace; const void* original; } \
+    interpose_##replacement __attribute__((section("__DATA,__interpose"))) = { \
+        reinterpret_cast<const void*>(replacement), reinterpret_cast<const void*>(original) }
+INTERPOSE(create, VTDecompressionSessionCreate);
+INTERPOSE(accepts, VTDecompressionSessionCanAcceptFormatDescription);
+INTERPOSE(invalidate, VTDecompressionSessionInvalidate);
+INTERPOSE(finish, VTDecompressionSessionFinishDelayedFrames);
+INTERPOSE(wait_frames, VTDecompressionSessionWaitForAsynchronousFrames);
+INTERPOSE(decode, VTDecompressionSessionDecodeFrame);
diff --git a/libs/codec/video_convert.c b/libs/codec/video_convert.c
new file mode 100644
index 0000000..765e16c
--- /dev/null
+++ b/libs/codec/video_convert.c
@@ -0,0 +1,59 @@
+#include "video_convert.h"
+#include <stddef.h>
+static uint8_t clamp(int v) { return v < 0 ? 0 : v > 255 ? 255 : (uint8_t)v; }
+static int sample(const uint8_t* p, unsigned w, unsigned h, unsigned x, unsigned y)
+{
+    unsigned ax = x >> 16, ay = y >> 16, bx = ax + 1 < w ? ax + 1 : ax, by = ay + 1 < h ? ay + 1 : ay;
+    unsigned fx = (x >> 8) & 255, fy = (y >> 8) & 255;
+    unsigned a = p[(size_t)ay * w + ax] * (256 - fx) + p[(size_t)ay * w + bx] * fx;
+    unsigned b = p[(size_t)by * w + ax] * (256 - fx) + p[(size_t)by * w + bx] * fx;
+    return (int)((a * (256 - fy) + b * fy + 32768) >> 16);
+}
+static unsigned coordinate(unsigned at, unsigned count, unsigned begin, unsigned length)
+{
+    /* Pixel centers, clamped at the crop edges. */
+    int64_t v = ((int64_t)(2 * at + 1) * length * 32768 / count) - 32768;
+    if (v < 0) v = 0;
+    if (v > (int64_t)(length - 1) * 65536) v = (int64_t)(length - 1) * 65536;
+    return begin * 65536 + (unsigned)v;
+}
+int video_convert(const uint8_t* src, unsigned iw, unsigned ih,
+    unsigned ix, unsigned iy, unsigned cw, unsigned ch, uint8_t* dst,
+    unsigned ow, unsigned oh, unsigned ox, unsigned oy, unsigned dw, unsigned dh,
+    unsigned format, unsigned matrix, unsigned range, uint8_t alpha)
+{
+    if (!src || !dst || !iw || !ih || !cw || !ch || !dw || !dh ||
+        (iw & 1) || (ih & 1) || iw > 8192 || ih > 8192 || ow > 8192 || oh > 8192 ||
+        ix > iw || cw > iw - ix || iy > ih || ch > ih - iy ||
+        ox > ow || dw > ow - ox || oy > oh || dh > oh - oy || format > 3 || matrix > 1 || range > 1)
+        return -1;
+    if ((format == 2 && ((ox | dw) & 1)) || (format == 3 && ((ow | oh | ox | oy | dw | dh) & 1))) return -1;
+    const uint8_t* up = src + (size_t)iw * ih; const uint8_t* vp = up + (size_t)iw * ih / 4;
+    for (unsigned y = 0; y < dh; y++) for (unsigned x = 0; x < dw; x++) {
+        unsigned sx = coordinate(x, dw, ix, cw), sy = coordinate(y, dh, iy, ch);
+        int yy = sample(src, iw, ih, sx, sy);
+        unsigned csx = format == 2 ? coordinate(x & ~1u, dw, ix, cw) / 2 : sx / 2;
+        int u = sample(up, iw / 2, ih / 2, csx, sy / 2), v = sample(vp, iw / 2, ih / 2, csx, sy / 2);
+        size_t at = (size_t)(oy + y) * ow + ox + x;
+        if (format == 3) {
+            dst[at] = yy;
+            if (!((x | y) & 1)) {
+                size_t c = (size_t)((oy + y) / 2) * (ow / 2) + (ox + x) / 2;
+                dst[(size_t)ow * oh + c] = u; dst[(size_t)ow * oh * 5 / 4 + c] = v;
+            }
+        } else if (format == 2) {
+            dst[at * 2] = (x & 1) ? v : u; dst[at * 2 + 1] = yy;
+        } else {
+            int lum = range ? (yy - 16) * 298 : yy * 256;
+            u -= 128; v -= 128;
+            int r = (lum + v * (matrix ? (range ? 459 : 403) : (range ? 409 : 359)) + 128) >> 8;
+            int g = (lum - u * (matrix ? (range ? 55 : 48) : (range ? 100 : 88)) -
+                     v * (matrix ? (range ? 136 : 120) : (range ? 208 : 183)) + 128) >> 8;
+            int b = (lum + u * (matrix ? (range ? 541 : 475) : (range ? 516 : 454)) + 128) >> 8;
+            uint8_t* p = dst + at * 4;
+            if (format == 0) { p[0] = alpha; p[1] = clamp(r); p[2] = clamp(g); p[3] = clamp(b); }
+            else { p[0] = clamp(r); p[1] = clamp(g); p[2] = clamp(b); p[3] = alpha; }
+        }
+    }
+    return 0;
+}
