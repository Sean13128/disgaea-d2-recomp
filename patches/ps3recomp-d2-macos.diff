index 0000000..b497768
--- /dev/null
+++ b/libs/system/tests/test_gamedata_roundtrip.c
@@ -0,0 +1,152 @@
+/* Separate create/check processes exercise actual metadata persistence. */
+#include "../cellGame.c"
+#include <assert.h>
+#include <pthread.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+const char* ppu_vfs_root = ".";
+
+static void string_param(s32 id, const char* expected)
+{
+    assert(cellGameGetParamString(id, (void*)0x800, 256) == CELL_OK);
+    assert(!strcmp((char*)vm_base + 0x800, expected));
+}
+static void* parallel_check(void* arg)
+{
+    (void)arg;
+    for (int i = 0; i < 20; i++)
+        assert(cellGameDataCheck(3, (void*)0x100, NULL) == CELL_OK);
+    return NULL;
+}
+int main(int argc, char** argv)
+{
+    assert(argc == 3);
+    vm_base = calloc(1, 65536); assert(vm_base);
+    cellGame_set_content_path(argv[2]);
+    cellGame_set_title_id("BLUS31313"); cellGame_set_title("Disc title");
+    strcpy((char*)vm_base + 0x100, "NPUB31321");
+    char target[1200], sfo[1200], file[1200];
+    snprintf(target, sizeof(target), "%s/NPUB31321", argv[2]);
+    snprintf(sfo, sizeof(sfo), "%s/PARAM.SFO", target);
+    snprintf(file, sizeof(file), "%s/USRDIR/payload.bin", target);
+    if (!strcmp(argv[1], "create") || !strcmp(argv[1], "heal")) {
+        if (!strcmp(argv[1], "heal")) {
+            ensure_dirs(target);
+            char usr[1200]; snprintf(usr, sizeof(usr), "%s/USRDIR", target);
+            ensure_dirs(usr);
+            FILE* f = fopen(file, "wb"); assert(f);
+            assert(fwrite("keep", 1, 4, f) == 4); assert(fclose(f) == 0);
+        }
+        assert(cellGameDataCheck(3, (void*)0x100, (void*)0x200) == CELL_GAME_RET_NONE);
+        assert(vm_read32(0x200) > 0 && vm_read32(0x204) == 0 && vm_read32(0x208) == 0);
+        assert(cellGameContentPermit((void*)0x400, (void*)0x500) == CELL_OK);
+        assert(!vm_base[0x400] && !vm_base[0x500]);
+        if (!strcmp(argv[1], "create")) assert(!dir_exists(target));
+        assert(access(sfo, F_OK) != 0);
+        CellGameSetInitParams* init = (void*)(vm_base + 0x1000);
+        strcpy(init->title, "Installed guest title");
+        strcpy(init->titleId, "NPUB31321"); strcpy(init->version, "02.34");
+        assert(cellGameCreateGameData((void*)0x1000, (void*)0x400, (void*)0x500) == CELL_OK);
+        string_param(CELL_GAME_PARAMID_TITLE_ID, "NPUB31321");
+        string_param(CELL_GAME_PARAMID_VERSION, "02.34");
+        strcpy((char*)vm_base + 0x600, "Updated guest title");
+        assert(cellGameSetParamString(CELL_GAME_PARAMID_TITLE, (void*)0x600) == CELL_OK);
+        strcpy((char*)vm_base + 0x600, "Localized guest title");
+        assert(cellGameSetParamString(CELL_GAME_PARAMID_TITLE_JAPANESE, (void*)0x600) == CELL_OK);
+        assert(access(sfo, F_OK) != 0); /* metadata has not been published */
+        char staged[1200];
+        snprintf(staged, sizeof(staged), "%s/%s/USRDIR/new.bin", argv[2],
+                 s_create_dir[0] ? s_create_dir : "NPUB31321");
+        FILE* f = fopen(staged, "wb"); assert(f);
+        char data[1025] = { 1 }; assert(fwrite(data, 1, sizeof(data), f) == sizeof(data));
+        assert(fclose(f) == 0);
+        assert(cellGameGetSizeKB((void*)0x900) == CELL_OK);
+        assert(vm_read32(0x900) == (!strcmp(argv[1], "heal") ? 3 : 2));
+        assert(cellGameContentPermit((void*)0x400, (void*)0x500) == CELL_OK);
+        assert(!strcmp((char*)vm_base + 0x400, "/dev_hdd0/game/NPUB31321"));
+        assert(access(sfo, F_OK) == 0);
+        assert(cellGameCreateGameData((void*)0x1000, NULL, NULL) == CELL_GAME_ERROR_EXIST);
+        puts("PASS create/legacy repair: NONE has empty paths; Create + Set + Permit publishes binary SFO");
+    } else if (!strcmp(argv[1], "invalid")) {
+        ensure_dirs(target);
+        FILE* f = fopen(sfo, "wb"); assert(f);
+        assert(fwrite("invalid PARAM.SFO", 1, 17, f) == 17); assert(fclose(f) == 0);
+        assert(cellGameDataCheck(3, (void*)0x100, (void*)0x200) == CELL_GAME_RET_NONE);
+        assert(vm_read32(0x204) == 0 && vm_read32(0x208) == 0);
+        assert(cellGameContentPermit((void*)0x400, (void*)0x500) == CELL_OK);
+        assert(!vm_base[0x400] && !vm_base[0x500]);
+        puts("PASS malformed SFO: NONE, zero sizes, empty permission paths");
+    } else {
+        assert(!strcmp(argv[1], "check"));
+        assert(cellGameDataCheck(3, (void*)0x100, (void*)0x200) == CELL_OK);
+        assert(vm_read32(0x200) > 0 && vm_read32(0x204) == (u32)-1 && vm_read32(0x208) == 0);
+        string_param(CELL_GAME_PARAMID_TITLE_ID, "NPUB31321");
+        string_param(CELL_GAME_PARAMID_TITLE, "Updated guest title");
+        string_param(CELL_GAME_PARAMID_TITLE_JAPANESE, "Localized guest title");
+        string_param(CELL_GAME_PARAMID_VERSION, "02.34");
+        string_param(CELL_GAME_PARAMID_APP_VER, "02.34");
+        assert(cellGameGetParamInt(CELL_GAME_PARAMID_PARENTAL_LEVEL, (void*)0x900) == CELL_OK);
+        assert(vm_read32(0x900) == 0);
+        SaveSfo disk; assert(sfo_load(sfo, &disk));
+        assert(!strcmp(param_string(&disk, "CATEGORY"), "GD"));
+        assert(sfo_le32(sfo_find(&disk, "ATTRIBUTE")->data) == 0); sfo_free(&disk);
+        assert(cellGameGetSizeKB((void*)0x900) == CELL_OK);
+        HOST_STAT_T st; assert(HOST_STAT(sfo, &st) == 0);
+        u32 expected = 2 + ((u64)st.st_size + 1023) / 1024;
+        if (access(file, F_OK) == 0) {
+            FILE* f = fopen(file, "rb"); assert(f); char data[5] = {0};
+            assert(fread(data, 1, 4, f) == 4 && !strcmp(data, "keep")); fclose(f);
+            expected++;
+        }
+        assert(vm_read32(0x900) == expected);
+        strcpy((char*)vm_base + 0x600, "Reboot update");
+        assert(cellGameSetParamString(CELL_GAME_PARAMID_TITLE, (void*)0x600) == CELL_OK);
+        char temp[1200]; snprintf(temp, sizeof(temp), "%s.tmp", sfo);
+        assert(mkdir(temp, 0700) == 0);
+        char blocker[1300]; snprintf(blocker, sizeof(blocker), "%s/blocker", temp);
+        FILE* block = fopen(blocker, "wb"); assert(block); assert(fclose(block) == 0);
+        assert(cellGameContentPermit((void*)0x400, (void*)0x500) == CELL_GAME_ERROR_ACCESS_ERROR);
+        SaveSfo unchanged; assert(sfo_load(sfo, &unchanged));
+        assert(!strcmp(param_string(&unchanged, "TITLE"), "Updated guest title"));
+        sfo_free(&unchanged); assert(unlink(blocker) == 0); assert(rmdir(temp) == 0);
+        assert(cellGameContentPermit((void*)0x400, (void*)0x500) == CELL_OK);
+        assert(cellGameDataCheck(3, (void*)0x100, NULL) == CELL_OK);
+        string_param(CELL_GAME_PARAMID_TITLE, "Reboot update");
+        strcpy((char*)vm_base + 0x600, "99.99");
+        assert(cellGameSetParamString(CELL_GAME_PARAMID_VERSION, (void*)0x600) == CELL_GAME_ERROR_NOTSUPPORTED);
+        puts("PASS atomic update: failed Permit retained original SFO, retry committed update");
+        /* Imported unknown keys survive ordinary metadata updates. */
+        assert(sfo_set_int(&s_check_sfo, "ATTRIBUTE", 7));
+        assert(sfo_set_int(&s_check_sfo, "PARENTAL_LEVEL", 5));
+        assert(sfo_set_str(&s_check_sfo, "EXTRA", "preserved", 16));
+        s_check_dirty = 1;
+        assert(cellGameContentPermit((void*)0x400, (void*)0x500) == CELL_OK);
+        assert(cellGameDataCheck(3, (void*)0x100, NULL) == CELL_OK);
+        assert(cellGameGetParamInt(CELL_GAME_PARAMID_PARENTAL_LEVEL, (void*)0x900) == CELL_OK);
+        assert(vm_read32(0x900) == 5 && sfo_le32(sfo_find(&s_check_sfo, "ATTRIBUTE")->data) == 7);
+        assert(!strcmp(param_string(&s_check_sfo, "EXTRA"), "preserved"));
+        assert(!strcmp(cellGame_get_title_id(), "BLUS31313"));
+        pthread_t a, b;
+        assert(!pthread_create(&a, NULL, parallel_check, NULL));
+        assert(!pthread_create(&b, NULL, parallel_check, NULL));
+        pthread_join(a, NULL); pthread_join(b, NULL);
+        puts("PASS reboot: stored strings/integers, content size, unknown fields, disc identity, concurrent checks");
+    }
+    assert(cellGameBootCheck((void*)0x900, (void*)0x904, (void*)0xA00, NULL) == CELL_OK);
+    assert(vm_read32(0x900) == 1 && vm_read32(0x904) == 0);
+    assert(vm_read32(0xA04) == (u32)-1 && vm_read32(0xA08) == 4);
+    assert(cellGameDataCheck(3, NULL, NULL) == CELL_GAME_ERROR_PARAM);
+    strcpy((char*)vm_base + 0x100, "../escape");
+    assert(cellGameDataCheck(3, (void*)0x100, NULL) == CELL_GAME_ERROR_PARAM);
+    sfo_free(&s_check_sfo); free(vm_base);
+    return 0;
+}
