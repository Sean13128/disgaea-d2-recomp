+/* half units: 2=1x, 3=1.5x, 4=2x, 6=3x. */
+static inline unsigned rsx_host_scale_edge(unsigned native, unsigned half_units)
+{
+    return (unsigned)(((uint64_t)native * half_units + 1) / 2);
+}
+static inline unsigned rsx_host_scale_extent(unsigned start, unsigned extent, unsigned half_units)
+{
+    return rsx_host_scale_edge(start + extent, half_units) - rsx_host_scale_edge(start, half_units);
+}
