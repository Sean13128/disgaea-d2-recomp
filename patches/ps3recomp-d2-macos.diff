+static pthread_mutex_t s_keys_lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned char s_keys[128];
+static NSWindow* s_input_window;
+static id s_monitor, s_resign_observer;
+static pthread_once_t s_enabled_once = PTHREAD_ONCE_INIT;
+static int s_enabled;
+
+static void keyboard_init(void)
+{
+    const char* off = getenv("PAD_NO_KEYBOARD");
+    s_enabled = !off || strcmp(off, "1") != 0;
+}
+
+int pad_macos_keyboard_enabled(void)
+{
+    pthread_once(&s_enabled_once, keyboard_init);
+    return s_enabled;
+}
+
+void pad_macos_run_main(void (*fn)(void))
+{
+    if ([NSThread isMainThread]) fn();
+    else dispatch_sync(dispatch_get_main_queue(), ^{ fn(); });
+}
+
+static void release_keys(void)
+{
+    pthread_mutex_lock(&s_keys_lock);
+    memset(s_keys, 0, sizeof(s_keys));
+    pthread_mutex_unlock(&s_keys_lock);
+}
+
+/* Shared by the local monitor and the synthetic NSEvent regression. */
+int pad_macos_process_event(void* native_event)
+{
+    NSEvent* event = (__bridge NSEvent*)native_event;
+    if (!s_input_window ||
+        [event window] != s_input_window || ![s_input_window isKeyWindow]) return 0;
+    unsigned code = [event keyCode];
+    if (ps3_host_key_event && [event type] != NSEventTypeFlagsChanged &&
+        ps3_host_key_event(code, (unsigned)[event modifierFlags],
+            [event type] == NSEventTypeKeyDown, [event isARepeat])) return 1;
+    if (!pad_macos_keyboard_enabled() || code >= sizeof(s_keys)) return 0;
+    switch (code) {
+    case 126: case 125: case 123: case 124: case 6: case 36: case 76:
+    case 7: case 53: case 51: case 0: case 1: case 12: case 13:
+    case 18: case 19: case 49: case 56: case 60: break;
+    default: return 0;
+    }
+    pthread_mutex_lock(&s_keys_lock);
+    if ([event type] == NSEventTypeFlagsChanged) {
+        s_keys[56] = s_keys[60] = ([event modifierFlags] & NSEventModifierFlagShift) != 0;
+    } else s_keys[code] = [event type] == NSEventTypeKeyDown;
+    pthread_mutex_unlock(&s_keys_lock);
+    return [event type] != NSEventTypeFlagsChanged;
+}
+
+void pad_macos_attach_window(void* window)
+{
+    if (s_monitor) { [NSEvent removeMonitor:s_monitor]; s_monitor = nil; }
+    if (s_resign_observer) {
+        [[NSNotificationCenter defaultCenter] removeObserver:s_resign_observer];
+        s_resign_observer = nil;
+    }
+    release_keys();
+    s_input_window = (__bridge NSWindow*)window;
+    if (!s_input_window || !pad_macos_keyboard_enabled()) return;
+    s_monitor = [NSEvent addLocalMonitorForEventsMatchingMask:
+        (NSEventMaskKeyDown | NSEventMaskKeyUp | NSEventMaskFlagsChanged)
+        handler:^NSEvent*(NSEvent* event) {
+            /* Consume mapped game keys to avoid AppKit's unhandled-key beep. */
+            return pad_macos_process_event((__bridge void*)event) ? nil : event;
+        }];
+    s_resign_observer = [[NSNotificationCenter defaultCenter]
+        addObserverForName:NSWindowDidResignKeyNotification object:s_input_window
+        queue:nil usingBlock:^(NSNotification* notification) { (void)notification; release_keys(); }];
+    printf("[cellPad] macOS keyboard monitor installed on Metal window\n");
+}
+
+uint16_t pad_macos_buttons(void)
+{
+    if (!pad_macos_keyboard_enabled()) return 0;
+    static const struct { unsigned code; uint16_t button; } map[] = {
+        {126, CELL_PAD_CTRL_UP}, {125, CELL_PAD_CTRL_DOWN},
+        {123, CELL_PAD_CTRL_LEFT}, {124, CELL_PAD_CTRL_RIGHT},
+        {6, CELL_PAD_CTRL_CROSS}, {36, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_START},
+        {76, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_START},
+        {7, CELL_PAD_CTRL_CIRCLE}, {53, CELL_PAD_CTRL_CIRCLE}, {51, CELL_PAD_CTRL_CIRCLE},
+        {0, CELL_PAD_CTRL_SQUARE}, {1, CELL_PAD_CTRL_TRIANGLE},
+        {12, CELL_PAD_CTRL_L1}, {13, CELL_PAD_CTRL_R1},
+        {18, CELL_PAD_CTRL_L2}, {19, CELL_PAD_CTRL_R2},
+        {49, CELL_PAD_CTRL_START}, {56, CELL_PAD_CTRL_SELECT}, {60, CELL_PAD_CTRL_SELECT}
+    };
+    uint16_t buttons = 0;
+    pthread_mutex_lock(&s_keys_lock);
+    for (unsigned i = 0; i < sizeof(map) / sizeof(map[0]); i++)
+        if (s_keys[map[i].code]) buttons |= map[i].button;
+    pthread_mutex_unlock(&s_keys_lock);
+    return buttons;
+}
diff --git a/libs/input/tests/test_pad_macos.m b/libs/input/tests/test_pad_macos.m
new file mode 100644
index 0000000..de6381f
--- /dev/null
+++ b/libs/input/tests/test_pad_macos.m
@@ -0,0 +1,197 @@
+/* Native event monitor -> cellPadGetData -> big-endian guest memory.
+ * Run on a macOS host with WindowServer access; no Metal device required. */
+#import <AppKit/AppKit.h>
+#include <SDL2/SDL.h>
+#include <assert.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include "../cellPad.h"
+#include "../pad_macos.h"
+#include "../../../runtime/ppu/ppu_memory.h"
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+static int native_events;
+
+/* WindowServer focus is unavailable in the Codex sandbox. Synthetic events
+ * still go through NSApplication's queue/local monitor; control focus only. */
+@interface ITestWindow : NSWindow
+@property BOOL testFocus;
+@end
+@implementation ITestWindow
+- (BOOL)isKeyWindow { return native_events ? [super isKeyWindow] : self.testFocus; }
+@end
+
+@interface ITestKeyEvent : NSEvent
+@property(assign) NSWindow* target;
+@property unsigned short code;
+@property NSEventType kind;
+@property NSUInteger flags;
+@end
+@implementation ITestKeyEvent
+- (NSWindow*)window { return self.target; }
+- (unsigned short)keyCode { return self.code; }
+- (NSEventType)type { return self.kind; }
+- (NSEventModifierFlags)modifierFlags { return self.flags; }
+@end
+
+static uint16_t read_pad(unsigned port)
+{
+    usleep(6000);
+    assert(cellPadGetData(port, (CellPadData*)(uintptr_t)0x1000) == CELL_OK);
+    assert(vm_read32(0x1000) >= 8);
+    return vm_read16(0x1008) | (vm_read16(0x100A) << 8);
+}
+
+static void key(NSWindow* window, unsigned code, NSEventType type, NSUInteger flags)
+{
+    NSEvent* event = [NSEvent keyEventWithType:type location:NSZeroPoint
+        modifierFlags:flags timestamp:0 windowNumber:[window windowNumber]
+        context:nil characters:@"" charactersIgnoringModifiers:@""
+        isARepeat:NO keyCode:code];
+    if (!native_events) {
+        ITestKeyEvent* synthetic = [[ITestKeyEvent alloc] init];
+        synthetic.target = window; synthetic.code = code; synthetic.kind = type; synthetic.flags = flags;
+        pad_macos_process_event((__bridge void*)synthetic);
+        return;
+    }
+    [NSApp postEvent:event atStart:NO];
+    NSEvent* queued = [NSApp nextEventMatchingMask:NSEventMaskAny
+        untilDate:[NSDate distantPast] inMode:NSDefaultRunLoopMode dequeue:YES];
+    while (queued) {
+        [NSApp sendEvent:queued];
+        queued = [NSApp nextEventMatchingMask:NSEventMaskAny untilDate:[NSDate distantPast]
+            inMode:NSDefaultRunLoopMode dequeue:YES];
+    }
+}
+
+static atomic_int worker_done;
+static void* read_on_guest_worker(void* unused)
+{
+    (void)unused;
+    assert(read_pad(0) == (pad_macos_keyboard_enabled() ? CELL_PAD_CTRL_CROSS : 0));
+    atomic_store(&worker_done, 1);
+    return NULL;
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        vm_base = calloc(1, 0x10000);
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+        ITestWindow* window = [[ITestWindow alloc] initWithContentRect:NSMakeRect(0, 0, 240, 120)
+            styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];
+        [window setTitle:@"ps3recomp keyboard regression"];
+        pad_macos_attach_window((__bridge void*)window);
+        [window makeKeyAndOrderFront:nil];
+        [NSApp activateIgnoringOtherApps:YES];
+        [window makeKeyWindow];
+        native_events = [window windowNumber] != 0;
+        if (argc > 1 && strcmp(argv[1], "--native") == 0 && !native_events) {
+            fprintf(stderr, "[I-test] native event queue needs WindowServer access (exit 77)\n");
+            return 77;
+        }
+        window.testFocus = YES;
+        if (native_events) {
+            for (int i = 0; i < 30 && ![window isKeyWindow]; i++)
+                CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, true);
+        }
+        printf("[I-test] event source: %s\n", native_events ? "NSApplication queue/local monitor" : "synthetic NSEvent/shared monitor handler (no WindowServer)");
+        assert([window isKeyWindow]);
+        assert(cellPadInit(2) == CELL_OK);
+        assert(cellPadGetInfo2((CellPadInfo2*)(uintptr_t)0x2000) == CELL_OK);
+        assert(vm_read32(0x2004) >= 1 && (vm_read32(0x200C) & CELL_PAD_STATUS_CONNECTED));
+        assert(cellPadSetPortSetting(0, CELL_PAD_SETTING_PRESS_ON) == CELL_OK);
+        const struct { unsigned code; uint16_t mask; } keys[] = {
+            {126,0x10},{125,0x40},{123,0x80},{124,0x20},
+            {6,0x4000},{36,0x4008},{76,0x4008},{7,0x2000},{53,0x2000},{51,0x2000},
+            {0,0x8000},{1,0x1000},{12,0x400},{13,0x800},{18,0x100},{19,0x200},{49,8}
+        };
+        for (unsigned i = 0; i < sizeof(keys)/sizeof(keys[0]); i++) {
+            key(window, keys[i].code, NSEventTypeKeyDown, 0);
+            uint16_t got = read_pad(0);
+            if (got != (pad_macos_keyboard_enabled() ? keys[i].mask : 0))
+                fprintf(stderr, "key %u: got %04x expected %04x; event window number %ld\n", keys[i].code, got, keys[i].mask, (long)[window windowNumber]);
+            assert(got == (pad_macos_keyboard_enabled() ? keys[i].mask : 0));
+            if (pad_macos_keyboard_enabled() && keys[i].code == 6)
+                assert(vm_read16(0x1004 + CELL_PAD_BTN_OFFSET_PRESS_CROSS * 2) == 255);
+            key(window, keys[i].code, NSEventTypeKeyUp, 0);
+            assert(read_pad(0) == 0);
+        }
+        window.testFocus = NO;
+        if (!native_events) {
+            key(window, 6, NSEventTypeKeyDown, 0);
+            assert(read_pad(0) == 0);
+        }
+        window.testFocus = YES;
+        key(window, 6, NSEventTypeKeyDown, 0);
+        pthread_t worker;
+        assert(pthread_create(&worker, NULL, read_on_guest_worker, NULL) == 0);
+        while (!atomic_load(&worker_done)) CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, true);
+        pthread_join(worker, NULL);
+        key(window, 6, NSEventTypeKeyUp, 0);
+        usleep(6000);
+        assert(cellPadGetDataExtra(0, (u32*)(uintptr_t)0x2400, (CellPadData*)(uintptr_t)0x1000) == CELL_OK);
+        assert(vm_read32(0x2400) == CELL_PAD_DEV_TYPE_STANDARD);
+        printf("[I-test] guest worker/main-queue polling and GetDataExtra: PASS\n");
+        key(window, 56, NSEventTypeFlagsChanged, NSEventModifierFlagShift);
+        assert(read_pad(0) == (pad_macos_keyboard_enabled() ? 1 : 0));
+        key(window, 60, NSEventTypeFlagsChanged, 0);
+        assert(read_pad(0) == 0);
+        /* Releasing one alias must not release another held alias. */
+        key(window, 6, NSEventTypeKeyDown, 0); key(window, 36, NSEventTypeKeyDown, 0);
+        key(window, 36, NSEventTypeKeyUp, 0);
+        assert(read_pad(0) == (pad_macos_keyboard_enabled() ? 0x4000 : 0));
+        [[NSNotificationCenter defaultCenter] postNotificationName:NSWindowDidResignKeyNotification object:window];
+        assert(read_pad(0) == 0);
+        printf("[I-test] AppKit key events, aliases, Shift, focus loss, guest endian/pressure/status: PASS (keyboard=%d)\n", pad_macos_keyboard_enabled());
+
+        /* First device is NOT a GameController. Index 1 must still occupy port 0. */
+        key(window, 1, NSEventTypeKeyDown, 0);
+        int raw = SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_UNKNOWN, 2, 2, 0);
+        SDL_VirtualJoystickDesc desc = {0}; desc.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+        desc.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER; desc.naxes = SDL_CONTROLLER_AXIS_MAX;
+        desc.nbuttons = SDL_CONTROLLER_BUTTON_MAX;
+        desc.button_mask = (1u << SDL_CONTROLLER_BUTTON_MAX) - 1;
+        desc.axis_mask = (1u << SDL_CONTROLLER_AXIS_MAX) - 1; desc.name = "I virtual Xbox/PS/MFi mapping";
+        int device = SDL_JoystickAttachVirtualEx(&desc); assert(raw >= 0 && device >= 0);
+        SDL_Joystick* joystick = SDL_JoystickOpen(device); assert(joystick);
+        SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERLEFT, -32768);
+        SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_A, 1);
+        assert(read_pad(0) == CELL_PAD_CTRL_CROSS);
+        assert(vm_read16(0x1010) == 128 && vm_read16(0x1012) == 128);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_A, 0);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_B, 1);
+        assert(read_pad(0) == CELL_PAD_CTRL_CIRCLE);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_B, 0);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_Y, 1);
+        assert(read_pad(0) == CELL_PAD_CTRL_TRIANGLE);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_Y, 0);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_X, 1);
+        assert(read_pad(0) == CELL_PAD_CTRL_SQUARE);
+        SDL_JoystickClose(joystick); SDL_JoystickDetachVirtual(device);
+        assert(read_pad(0) == (pad_macos_keyboard_enabled() ? CELL_PAD_CTRL_TRIANGLE : 0));
+        key(window, 1, NSEventTypeKeyUp, 0);
+        device = SDL_JoystickAttachVirtualEx(&desc); joystick = SDL_JoystickOpen(device);
+        SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERLEFT, -32768);
+        SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_START, 1);
+        assert(read_pad(0) == CELL_PAD_CTRL_START);
+        SDL_JoystickClose(joystick); SDL_JoystickDetachVirtual(device); SDL_JoystickDetachVirtual(raw);
+        cellPadEnd(); pad_macos_attach_window(NULL); [window orderOut:nil];
+        printf("[I-test] SDL without video, unmapped device, face buttons, centered sticks, disconnect/reconnect: PASS\n");
+        free(vm_base);
+    }
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_overlay.m b/libs/input/tests/test_pad_overlay.m
new file mode 100644
index 0000000..ff52cba
--- /dev/null
+++ b/libs/input/tests/test_pad_overlay.m
@@ -0,0 +1,114 @@
+/* Reuse the established AppKit/SDL event fixture and its endian/memory hooks. */
+#define main pad_base_test_main
+#include "test_pad_macos.m"
+#undef main
+#include "../../system/sys_overlay.h"
+
+static uint16_t host_pad(void) { usleep(6000); return ps3_pad_host_buttons(); }
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        vm_base = calloc(1, 0x10000);
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+        ITestWindow* window = [[ITestWindow alloc] initWithContentRect:NSMakeRect(0, 0, 240, 120)
+            styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];
+        pad_macos_attach_window((__bridge void*)window);
+        [window makeKeyAndOrderFront:nil]; [NSApp activateIgnoringOtherApps:YES];
+        native_events = argc > 1 && !strcmp(argv[1], "--native");
+        if (native_events && !window.windowNumber) return 77;
+        window.testFocus = YES;
+        if (native_events) {
+            for (int i = 0; i < 30 && ![window isKeyWindow]; i++)
+                CFRunLoopRunInMode(kCFRunLoopDefaultMode, .01, true);
+            assert([window isKeyWindow]);
+        }
+        key(window, 6, NSEventTypeKeyDown, 0);
+        assert(host_pad() == 0x4000);
+        assert(cellPadGetData(0, (CellPadData*)(uintptr_t)0x1000) == CELL_PAD_ERROR_NOT_OPENED);
+        key(window, 6, NSEventTypeKeyUp, 0); assert(host_pad() == 0);
+        /* System UI can open a real controller before guest libpad starts.
+         * Repeated host reads and guest Init must retain exactly one handle. */
+        SDL_VirtualJoystickDesc early_desc = {0};
+        early_desc.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+        early_desc.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER;
+        early_desc.naxes = SDL_CONTROLLER_AXIS_MAX;
+        early_desc.nbuttons = SDL_CONTROLLER_BUTTON_MAX;
+        early_desc.button_mask = (1u << SDL_CONTROLLER_BUTTON_MAX) - 1;
+        early_desc.axis_mask = (1u << SDL_CONTROLLER_AXIS_MAX) - 1;
+        early_desc.name = "P pre-libpad controller";
+        int early_device = SDL_JoystickAttachVirtualEx(&early_desc); assert(early_device >= 0);
+        SDL_Joystick* early_pad = SDL_JoystickOpen(early_device); assert(early_pad);
+        SDL_JoystickID early_id = SDL_JoystickInstanceID(early_pad);
+        SDL_JoystickSetVirtualAxis(early_pad, SDL_CONTROLLER_AXIS_TRIGGERLEFT, -32768);
+        SDL_JoystickSetVirtualAxis(early_pad, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);
+        assert(host_pad() == 0);
+        SDL_JoystickSetVirtualButton(early_pad, SDL_CONTROLLER_BUTTON_A, 1);
+        assert(host_pad() == 0x4000);
+        SDL_JoystickSetVirtualButton(early_pad, SDL_CONTROLLER_BUTTON_A, 0);
+        assert(host_pad() == 0);
+        assert(cellPadInit(2) == CELL_OK);
+        assert(read_pad(0) == 0);
+        assert(cellPadEnd() == CELL_OK);
+        assert(SDL_GameControllerFromInstanceID(early_id) == NULL);
+        SDL_JoystickClose(early_pad); SDL_JoystickDetachVirtual(early_device);
+        puts("[P-test] pre-libpad controller ownership survives host reads/guest Init and closes at End: PASS");
+        assert(cellPadInit(2) == CELL_OK);
+        assert(cellPadSetPortSetting(0, CELL_PAD_SETTING_PRESS_ON) == CELL_OK);
+        ps3_overlay_set_renderer(1);
+        unsetenv("PS3_SAVEDATA_UI"); unsetenv("PS3RECOMP_METAL_HEADLESS");
+        key(window, 36, NSEventTypeKeyDown, 0); /* Enter = Cross + Start */
+        assert(host_pad() == 0x4008);
+        SysOverlaySnapshot ui = {0}; ui.buttons = 1;
+        uint64_t token = ps3_overlay_open(&ui, SYS_OVERLAY_OK); assert(token);
+        ps3_overlay_poll(); assert(read_pad(0) == 0);
+        assert(vm_read16(0x1004 + CELL_PAD_BTN_OFFSET_PRESS_CROSS * 2) == 0);
+        key(window, 36, NSEventTypeKeyUp, 0); usleep(6000); ps3_overlay_poll();
+        key(window, 125, NSEventTypeKeyDown, 0);
+        assert(host_pad() == 0x40); assert(read_pad(0) == 0);
+        assert(vm_read16(0x1004 + CELL_PAD_BTN_OFFSET_PRESS_DOWN * 2) == 0);
+        assert(vm_read16(0x1004 + CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y * 2) == 128);
+        key(window, 125, NSEventTypeKeyUp, 0); usleep(6000); ps3_overlay_poll();
+        key(window, 6, NSEventTypeKeyDown, 0); usleep(6000); ps3_overlay_poll();
+        int result; assert(ps3_overlay_take_result(token, &result, NULL) && result == 1);
+        assert(host_pad() == 0x4000 && read_pad(0) == 0); /* dismissal held */
+        key(window, 6, NSEventTypeKeyUp, 0); assert(read_pad(0) == 0);
+        key(window, 6, NSEventTypeKeyDown, 0); assert(read_pad(0) == 0x4000);
+        key(window, 6, NSEventTypeKeyUp, 0); assert(read_pad(0) == 0);
+        puts("[P-test] AppKit/host snapshot, digital/pressure/stick/Enter suppression, dismissal release: PASS");
+
+        token = ps3_overlay_open(&ui, SYS_OVERLAY_OK); ps3_overlay_poll();
+        key(window, 6, NSEventTypeKeyDown, 0); usleep(6000); ps3_overlay_poll();
+        assert(ps3_overlay_take_result(token, &result, NULL) && result == 1);
+        /* Guest can resume after a different button has already been pressed. */
+        key(window, 125, NSEventTypeKeyDown, 0);
+        assert(host_pad() == 0x4040 && read_pad(0) == 0x40);
+        key(window, 125, NSEventTypeKeyUp, 0);
+        key(window, 6, NSEventTypeKeyUp, 0); assert(host_pad() == 0);
+        /* Host sees release, then a fresh press before any guest read. */
+        key(window, 6, NSEventTypeKeyDown, 0);
+        assert(host_pad() == 0x4000 && read_pad(0) == 0x4000);
+        key(window, 6, NSEventTypeKeyUp, 0); assert(read_pad(0) == 0);
+        puts("[P-test] only dismissal-held buttons suppressed; host-observed release before guest resumes: PASS");
+
+        SDL_VirtualJoystickDesc desc = {0}; desc.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+        desc.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER; desc.naxes = SDL_CONTROLLER_AXIS_MAX;
+        desc.nbuttons = SDL_CONTROLLER_BUTTON_MAX; desc.button_mask = (1u << SDL_CONTROLLER_BUTTON_MAX) - 1;
+        desc.axis_mask = (1u << SDL_CONTROLLER_AXIS_MAX) - 1; desc.name = "P overlay virtual controller";
+        int device = SDL_JoystickAttachVirtualEx(&desc); assert(device >= 0);
+        SDL_Joystick* joystick = SDL_JoystickOpen(device); assert(joystick);
+        SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERLEFT, -32768);
+        SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);
+        assert(host_pad() == 0);
+        token = ps3_overlay_open(&ui, SYS_OVERLAY_OK); ps3_overlay_poll();
+        SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_B, 1);
+        assert(host_pad() == 0x2000 && read_pad(0) == 0);
