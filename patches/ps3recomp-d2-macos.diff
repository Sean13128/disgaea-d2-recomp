diff --git a/libs/video/rsx_metal_overlay.h b/libs/video/rsx_metal_overlay.h
new file mode 100644
index 0000000..90f87b5
--- /dev/null
+++ b/libs/video/rsx_metal_overlay.h
@@ -0,0 +1,14 @@
+#ifndef PS3RECOMP_RSX_METAL_OVERLAY_H
+#define PS3RECOMP_RSX_METAL_OVERLAY_H
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+#include "../system/sys_overlay.h"
+/* Encode locks the compositor until end, which must follow cb commit. */
+void rsx_metal_overlay_init(id<MTLDevice>, id<MTLCommandQueue>, CAMetalLayer*, dispatch_semaphore_t);
+void rsx_metal_overlay_shutdown(void);
+void rsx_metal_overlay_encode(id<MTLCommandBuffer>, id<MTLTexture> guest, id<MTLTexture> display);
+void rsx_metal_overlay_end(void);
+id<MTLTexture> rsx_metal_overlay_capture(void);
+/* BGRA premultiplied pixels; also used by the no-device raster regression. */
+void rsx_metal_overlay_raster(const SysOverlaySnapshot*, unsigned char* pixels);
+#endif
diff --git a/libs/video/rsx_metal_overlay.m b/libs/video/rsx_metal_overlay.m
new file mode 100644
index 0000000..dbf0a9a
--- /dev/null
+++ b/libs/video/rsx_metal_overlay.m
@@ -0,0 +1,289 @@
+/* CoreText rasterizes on model changes. A compositor timer keeps UI alive
+ * over the preserved guest frame while blocking SaveData stops guest flips. */
+#import <CoreText/CoreText.h>
+#import "rsx_metal_overlay.h"
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#define UI_WIDTH 1280
+#define UI_HEIGHT 720
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+static id<MTLDevice> s_device;
+static id<MTLCommandQueue> s_queue;
+static CAMetalLayer* s_layer;
+static dispatch_semaphore_t s_inflight;
+static dispatch_source_t s_timer;
+static id<MTLLibrary> s_library;
+static id<MTLRenderPipelineState> s_copy, s_blend, s_display_copy;
+static MTLPixelFormat s_display_format;
+static id<MTLTexture> s_background, s_composed, s_text;
+static uint64_t s_revision;
+static int s_was_active;
+static SysOverlaySnapshot s_snapshot; /* protected by compositor lock */
+static unsigned s_capture_frame;
+static uint64_t s_capture_revision;
+
+static void rectangle(CGContextRef cg, double x, double y, double w, double h,
+                      double r, double g, double b, double a)
+{
+    CGContextSetRGBFillColor(cg, r, g, b, a);
+    CGContextFillRect(cg, CGRectMake(x, UI_HEIGHT - y - h, w, h));
+}
+static void text(CGContextRef cg, const char* string, double x, double y,
+                 double w, double h, double size)
+{
+    CFStringRef value = CFStringCreateWithCString(NULL, string, kCFStringEncodingUTF8);
+    if (!value) return;
+    CTFontRef font = CTFontCreateWithName(CFSTR("Helvetica"), size, NULL);
+    CGColorRef color = CGColorCreateGenericRGB(.94, .96, 1, 1);
+    const void* keys[] = { kCTFontAttributeName, kCTForegroundColorAttributeName };
+    const void* values[] = { font, color };
+    CFDictionaryRef attributes = CFDictionaryCreate(NULL, keys, values, 2,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFAttributedStringRef attributed = CFAttributedStringCreate(NULL, value, attributes);
+    CTFramesetterRef setter = CTFramesetterCreateWithAttributedString(attributed);
+    CGPathRef path = CGPathCreateWithRect(CGRectMake(x, UI_HEIGHT - y - h, w, h), NULL);
+    CTFrameRef frame = CTFramesetterCreateFrame(setter, CFRangeMake(0, 0), path, NULL);
+    CTFrameDraw(frame, cg);
+    CFRelease(frame); CFRelease(path); CFRelease(setter); CFRelease(attributed);
+    CFRelease(attributes); CFRelease(color); CFRelease(font); CFRelease(value);
+}
+void rsx_metal_overlay_raster(const SysOverlaySnapshot* ui, unsigned char* pixels)
+{
+    memset(pixels, 0, UI_WIDTH * UI_HEIGHT * 4);
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGContextRef cg = CGBitmapContextCreate(pixels, UI_WIDTH, UI_HEIGHT, 8, UI_WIDTH * 4,
+        space, kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+    CGColorSpaceRelease(space);
+    if (!cg) return;
+    rectangle(cg, 0, 0, UI_WIDTH, UI_HEIGHT, 0, 0, 0, .48);
+    /* Guest dialogue may keep changing under the editor. Only the backdrop
+     * is translucent; text behind the panel must not show through. */
+    rectangle(cg, 170, 105, 940, 510, .045, .065, .11, 1);
+    rectangle(cg, 170, 105, 940, 4, .35, .65, .95, 1);
+    text(cg, ui->title, 210, 128, 860, 48, 30);
+    rectangle(cg, 210, 184, 860, 1, .45, .52, .65, .65);
+    text(cg, ui->message, 210, 205, 860, (ui->kind == SYS_OVERLAY_LIST || ui->kind == SYS_OVERLAY_EDITOR) ? 65 : 140, 25);
+    if ((ui->kind == SYS_OVERLAY_LIST || ui->kind == SYS_OVERLAY_EDITOR)) {
+        int first = ui->selected >= 5 ? ui->selected - 4 : 0;
+        for (int row = 0; row < 5 && first + row < ui->count; row++) {
+            int item = first + row;
+            if (item == ui->selected) rectangle(cg, 205, 282 + row * 48, 870, 44, .16, .36, .61, .96);
+            text(cg, ui->items[item].label, 225, 289 + row * 48, 830, 35, 23);
+        }
+        char position[64];
+        snprintf(position, sizeof position, "%d / %d", ui->selected + 1, ui->count);
+        text(cg, position, 930, 535, 140, 28, 19);
+    }
+    if (ui->kind == SYS_OVERLAY_YESNO) {
+        for (int i = 0; i < 2; i++) {
+            if (ui->selected == i) rectangle(cg, 385 + i * 270, 395, 230, 56, .16, .36, .61, .96);
+            text(cg, i ? "No" : "Yes", 465 + i * 270, 406, 140, 40, 27);
+        }
+    }
+    for (int i = 0; i < ui->progress_count; i++) {
+        double y = 365 + i * 85;
+        text(cg, ui->progress_message[i], 215, y - 29, 850, 30, 20);
+        rectangle(cg, 215, y + 10, 850, 18, .18, .22, .29, 1);
+        rectangle(cg, 215, y + 10, 850 * ui->progress[i] / 100., 18, .3, .62, .91, 1);
+    }
+    rectangle(cg, 210, 567, 860, 1, .45, .52, .65, .65);
+    text(cg, ui->footer[0] ? ui->footer : ui->buttons ? (ui->cancel_disabled ? "✕ OK" : "✕ OK     ○ Back") :
+                          (ui->cancel_disabled ? "Please wait…" : "○ Back"),
+         215, 580, 850, 30, 22);
+    CGContextRelease(cg);
+}
+static id<MTLTexture> sized_texture(NSUInteger width, NSUInteger height)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+        width:width height:height mipmapped:NO];
+    td.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+    td.storageMode = MTLStorageModeShared;
+    return [s_device newTextureWithDescriptor:td];
+}
+static id<MTLTexture> texture(void) { return sized_texture(UI_WIDTH, UI_HEIGHT); }
+static id<MTLRenderPipelineState> pipeline(MTLPixelFormat format, int blend)
+{
+    MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [s_library newFunctionWithName:@"overlay_vs"];
+    pd.fragmentFunction = [s_library newFunctionWithName:@"overlay_fs"];
+    pd.colorAttachments[0].pixelFormat = format;
+    pd.colorAttachments[0].blendingEnabled = blend;
+    pd.colorAttachments[0].sourceRGBBlendFactor = MTLBlendFactorOne;
+    pd.colorAttachments[0].destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+    pd.colorAttachments[0].sourceAlphaBlendFactor = MTLBlendFactorOne;
+    pd.colorAttachments[0].destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+    NSError* error = nil;
+    id<MTLRenderPipelineState> pso = [s_device newRenderPipelineStateWithDescriptor:pd error:&error];
+    if (!pso) fprintf(stderr, "[sys overlay/metal] pipeline error: %s\n", error.localizedDescription.UTF8String);
+    return pso;
+}
+static void draw(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst, int blend)
+{
+    if (!src || !dst) return;
+    id<MTLRenderPipelineState> pso = blend ? s_blend : s_copy;
+    if (dst.pixelFormat != MTLPixelFormatBGRA8Unorm) {
+        if (!s_display_copy || s_display_format != dst.pixelFormat) {
+            s_display_format = dst.pixelFormat;
+            s_display_copy = pipeline(s_display_format, 0);
+        }
+        pso = s_display_copy;
+    }
+    if (!pso) return;
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture = dst;
+    rp.colorAttachments[0].loadAction = blend ? MTLLoadActionLoad : MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:rp];
+    [enc setRenderPipelineState:pso]; [enc setFragmentTexture:src atIndex:0];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [enc endEncoding];
+}
+static void compose(id<MTLCommandBuffer> cb, const SysOverlaySnapshot* ui)
+{
+    draw(cb, s_background, s_composed, 0);
+    if (!ui->active) return;
+    if (!s_text || s_revision != ui->revision) {
+        unsigned char* pixels = malloc(UI_WIDTH * UI_HEIGHT * 4);
+        if (!pixels) return;
+        rsx_metal_overlay_raster(ui, pixels);
+        s_text = texture(); /* immutable to pending command buffers */
+        [s_text replaceRegion:MTLRegionMake2D(0, 0, UI_WIDTH, UI_HEIGHT) mipmapLevel:0
+            withBytes:pixels bytesPerRow:UI_WIDTH * 4];
+        free(pixels); s_revision = ui->revision;
+    }
+    draw(cb, s_text, s_composed, 1);
+}
+/* Capture a private texture in the same command buffer. Readback is done on
+ * completion, so neither AppKit nor presentation waits for the GPU/disk. */
+static void capture(id<MTLCommandBuffer> cb, const SysOverlaySnapshot* ui, id<MTLTexture> source)
+{
+    const char* path = getenv("PS3RECOMP_METAL_FRAME_DUMP");
+    if (!path || !*path) return;
+    unsigned frame = ++s_capture_frame;
+    const char* setting = getenv("PS3RECOMP_METAL_FRAME_DUMP_EVERY");
+    unsigned every = setting ? (unsigned)atoi(setting) : 120;
+    if (!every) every = 120;
+    if (frame % every && (!ui->active || s_capture_revision == ui->revision)) return;
+    s_capture_revision = ui->revision;
+    char numbered[1024];
+    if (strstr(path, "%u")) snprintf(numbered, sizeof numbered, path, frame);
+    else snprintf(numbered, sizeof numbered, "%s", path);
+    NSString* filename = [NSString stringWithUTF8String:numbered];
+    const NSUInteger width = source.width, height = source.height;
+    id<MTLTexture> image = sized_texture(width, height);
+    if (!image) return;
+    draw(cb, source, image, 0);
+    int active = ui->active;
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        if (done.status == MTLCommandBufferStatusError) return;
+        unsigned char* pixels = malloc(width * height * 4);
+        if (!pixels) return;
+        [image getBytes:pixels bytesPerRow:width * 4
+            fromRegion:MTLRegionMake2D(0, 0, width, height) mipmapLevel:0];
+        FILE* file = fopen(filename.UTF8String, "wb");
+        if (file) {
+            fprintf(file, "P6\n%zu %zu\n255\n", (size_t)width, (size_t)height);
+            for (size_t i = 0; i < width * height; i++) {
+                unsigned char rgb[] = { pixels[i*4+2], pixels[i*4+1], pixels[i*4] };
+                fwrite(rgb, 1, 3, file);
+            }
+            fclose(file);
+            fprintf(stderr, "[sys overlay/metal] captured frame %u overlay=%d to %s\n",
+                    frame, active, filename.UTF8String);
+        }
+        free(pixels);
+    }];
+}
+static void repaint(void)
+{
+    ps3_overlay_poll(); /* no renderer lock across main-queue pad polling */
+    pthread_mutex_lock(&s_lock);
+    ps3_overlay_snapshot(&s_snapshot);
+    if ((!s_snapshot.active && !s_was_active) || !s_background || !s_layer || !s_device) {
+        pthread_mutex_unlock(&s_lock); return;
+    }
+    /* Skip saturated GPU frames; AppKit never waits for this compositor. */
+    if (dispatch_semaphore_wait(s_inflight, DISPATCH_TIME_NOW)) {
+        pthread_mutex_unlock(&s_lock); return;
+    }
+    id<CAMetalDrawable> drawable = [s_layer nextDrawable];
+    if (!drawable) {
+        dispatch_semaphore_signal(s_inflight); pthread_mutex_unlock(&s_lock); return;
+    }
+    id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+    compose(cb, &s_snapshot); capture(cb, &s_snapshot, s_composed); draw(cb, s_composed, drawable.texture, 0);
+    [cb presentDrawable:drawable];
+    dispatch_semaphore_t sem = s_inflight;
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) { (void)done; dispatch_semaphore_signal(sem); }];
+    [cb commit]; s_was_active = s_snapshot.active;
+    pthread_mutex_unlock(&s_lock);
+}
+void rsx_metal_overlay_init(id<MTLDevice> device, id<MTLCommandQueue> queue,
+                            CAMetalLayer* layer, dispatch_semaphore_t inflight)
+{
+    s_device = device; s_queue = queue; s_layer = layer; s_inflight = inflight;
+    NSString* shader = @"#include <metal_stdlib>\nusing namespace metal;\n"
+        "struct V { float4 p [[position]]; float2 uv; };\n"
+        "vertex V overlay_vs(uint i [[vertex_id]]) { float2 p=float2((i<<1)&2,i&2);"
+        "V v; v.p=float4(p*2-1,0,1); v.uv=float2(p.x,1-p.y); return v; }\n"
+        "fragment float4 overlay_fs(V v [[stage_in]], texture2d<float> t [[texture(0)]]) {"
+        "constexpr sampler s(coord::normalized,filter::linear,address::clamp_to_edge); return t.sample(s,v.uv); }\n";
+    NSError* error = nil;
+    s_library = [device newLibraryWithSource:shader options:nil error:&error];
+    s_copy = pipeline(MTLPixelFormatBGRA8Unorm, 0); s_blend = pipeline(MTLPixelFormatBGRA8Unorm, 1);
+    if (!s_library || !s_copy || !s_blend) {
+        fprintf(stderr, "[sys overlay/metal] initialization failed: %s\n", error.localizedDescription.UTF8String);
+        ps3_overlay_set_renderer(0); return;
+    }
+    s_composed = texture(); s_background = texture();
+    unsigned char* black = calloc(UI_WIDTH * UI_HEIGHT, 4);
+    if (!s_composed || !s_background || !black) { free(black); ps3_overlay_set_renderer(0); return; }
+    for (size_t i = 0; i < UI_WIDTH * UI_HEIGHT; i++) black[i*4+3] = 255;
+    [s_background replaceRegion:MTLRegionMake2D(0, 0, UI_WIDTH, UI_HEIGHT) mipmapLevel:0
+        withBytes:black bytesPerRow:UI_WIDTH * 4];
+    free(black);
+    if (layer) {
+        layer.allowsNextDrawableTimeout = YES;
+        dispatch_queue_t timer_queue = dispatch_queue_create("ps3recomp.system-overlay", DISPATCH_QUEUE_SERIAL);
+        s_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, timer_queue);
+        dispatch_source_set_timer(s_timer, dispatch_time(DISPATCH_TIME_NOW, 0), NSEC_PER_SEC / 30, NSEC_PER_MSEC * 2);
+        dispatch_source_set_event_handler(s_timer, ^{ @autoreleasepool { repaint(); } });
+        dispatch_resume(s_timer);
+    }
+    ps3_overlay_set_renderer(layer != nil);
+    fprintf(stderr, "[sys overlay/metal] compositor ready\n");
+}
+void rsx_metal_overlay_encode(id<MTLCommandBuffer> cb, id<MTLTexture> guest, id<MTLTexture> display)
+{
+    pthread_mutex_lock(&s_lock);
+    if (!s_copy || !guest) return;
+    /* UI coordinates remain native, but composition and captures retain the
+     * guest target's pixels. Text is sampled as an overlay at that resolution. */
+    if (s_background.width != guest.width || s_background.height != guest.height) {
+        id<MTLTexture> background = sized_texture(guest.width, guest.height);
+        id<MTLTexture> composed = sized_texture(guest.width, guest.height);
+        if (!background || !composed) return;
+        s_background = background; s_composed = composed;
+    }
+    draw(cb, guest, s_background, 0);
+    ps3_overlay_snapshot(&s_snapshot);
+    if (s_snapshot.active) compose(cb, &s_snapshot);
+    capture(cb, &s_snapshot, s_snapshot.active ? s_composed : guest);
+    if (s_snapshot.active) draw(cb, s_composed, display, 0);
+    s_was_active = s_snapshot.active;
+}
+void rsx_metal_overlay_end(void) { pthread_mutex_unlock(&s_lock); }
+id<MTLTexture> rsx_metal_overlay_capture(void) { return s_composed; }
+void rsx_metal_overlay_shutdown(void)
+{
+    pthread_mutex_lock(&s_lock);
+    if (s_timer) { dispatch_source_cancel(s_timer); s_timer = nil; }
+    s_layer = nil; s_device = nil; s_queue = nil; s_inflight = nil;
+    s_background = nil; s_composed = nil; s_text = nil;
+    s_library = nil; s_copy = nil; s_blend = nil; s_display_copy = nil;
+    s_was_active = 0; s_revision = 0;
+    pthread_mutex_unlock(&s_lock);
+    ps3_overlay_set_renderer(0);
+}
