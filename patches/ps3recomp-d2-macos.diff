+        assert(err < 1e-3);
+        printf("stream loop/reset: %u samples, seam error %.2e; cached replay PASS\n", ns, err);
+        free(streamed);
+    }
+    assert(cellAtracDeleteDecoder(H) == CELL_OK);
+
+    /* Seek into data that has never been submitted. BufferInfo includes the
+     * preceding frame needed by decoder overlap; reset must not start at 0. */
+    memcpy(vm_base + FILE_EA, source, initial);
+    assert(cellAtracSetDataAndGetMemSize(H, FILE_EA, initial, 102400, ARGS) == CELL_OK);
+    assert(cellAtracCreateDecoder(H, WORK, 0, 0) == CELL_OK);
+    const u32 sample = fact0 * 9 / 10;
+    assert(cellAtracGetBufferInfoForResetting(H, sample, ARGS + 24) == CELL_OK);
+    const u32 ea = rd32(ARGS + 24), n = rd32(ARGS + 28), min = rd32(ARGS + 32), at = rd32(ARGS + 36);
+    assert(min > 0 && min <= n && n <= 102400 && at + n <= bytes);
+    assert(cellAtracResetPlayPosition(H, sample, 0) == (s32)CELL_ATRAC_ERROR_ILLEGAL_RESET_BYTE);
+    memcpy(vm_base + ea, source + at, n);
+    assert(cellAtracResetPlayPosition(H, sample, n) == CELL_OK);
+    streamed = decode_all(ch, 0, &ns);
+    assert(ns == fact0 - sample);
+    double seek_err = 0;
+    for (u32 i = 2048 * ch; i < ns * ch; i++)
+        seek_err = fmax(seek_err, fabs(streamed[i] - once[sample * ch + i]));
+    assert(seek_err < 1e-3);
+    printf("uncached seek: %u samples, post-preroll error %.2e PASS\n", ns, seek_err);
+    free(streamed);
+    if (t.loop_start == t.first && t.loop_end == t.end) {
+        assert(cellAtracResetPlayPosition(H, sample, 0) == CELL_OK);
+        const u32 before = stream_refills;
+        streamed = decode_all(ch, 1, &ns);
+        assert(ns == fact0 - sample + fact0 && stream_refills > before);
+        double err = 0;
+        for (u32 i = 2048 * ch; i < fact0 * ch; i++)
+            err = fmax(err, fabs(streamed[(fact0 - sample) * ch + i] - once[i]));
+        assert(err < 1e-3);
+        printf("loop after seek: uncached gap refilled (%u calls), error %.2e PASS\n",
+               stream_refills - before, err);
+        free(streamed);
+    }
+    assert(cellAtracDeleteDecoder(H) == CELL_OK);
+    free(source);
     free(once);
+    free(vm_base);
     puts("ok");
     return 0;
 }
diff --git a/libs/codec/tests/test_dmux_handshake.cpp b/libs/codec/tests/test_dmux_handshake.cpp
new file mode 100644
index 0000000..7c1930e
--- /dev/null
+++ b/libs/codec/tests/test_dmux_handshake.cpp
@@ -0,0 +1,86 @@
+/* Completion callbacks must observe an idle demux and may refill it directly. */
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include "../cellDmux.h"
+#include "../../../runtime/ppu/ppu_memory.h"
+#include "ps3emu/guest_call.h"
+extern "C" {
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t) {}
+void ps3_ww_report_inline(uint32_t, uint64_t, int) {}
+int spu_coh_is_reserved(uint32_t) { return 0; }
+void spu_coh_notify_write(uint32_t) {}
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+}
+
+#define EA(T, x) ((T*)(uintptr_t)(x))
+static u32 handle, es[2];
+static std::atomic<unsigned> flushes{0};
+static std::atomic<bool> callback_retired{false};
+static std::atomic<unsigned> callbacks{0};
+static std::atomic<bool> finished{false};
+static std::atomic<s32> failure{0};
+static void callback(u32 opd, u64 h, u64 msg, u64 arg, u64, u64, u64, u64, u64)
+{
+    if (opd == 2) {
+        assert(h == handle && vm_read32((u32)arg) == CELL_DMUX_ES_MSG_TYPE_FLUSH_DONE);
+        flushes++;
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        return;
+    }
+    assert(opd == 1 && h == handle && arg == 0x1234);
+    assert(vm_read32((u32)msg) == CELL_DMUX_MSG_TYPE_DEMUX_DONE);
+    unsigned n = ++callbacks;
+    assert(vm_read64((u32)msg + 8) == n);
+    if (n < 64) {
+        s32 ret = cellDmuxSetStream(handle, 0x20000, 1024, false, n + 1);
+        if (ret) { failure = ret; finished = true; return; }
+        /* Leave the callback active after submitting the replacement stream.
+         * The retiring worker must not overwrite the new stream's busy flag. */
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        assert(cellDmuxSetStream(handle, 0x20000, 1024, false, 999) == (s32)CELL_DMUX_ERROR_BUSY);
+    } else {
+        finished = true;
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        callback_retired = true;
+    }
+}
+int main()
+{
+    vm_base = (u8*)calloc(1, 4 << 20); assert(vm_base);
+    g_ps3_guest_caller = callback;
+    vm_write32(0x1000, 1); vm_write32(0x1020, 0x10000); vm_write32(0x1024, 0x10000);
+    vm_write32(0x1040, 1); vm_write32(0x1044, 0x1234);
+    assert(cellDmuxOpen(EA(CellDmuxType, 0x1000), EA(CellDmuxResource, 0x1020), EA(CellDmuxCb, 0x1040), EA(u32, 0x1060)) == 0);
+    handle = vm_read32(0x1060);
+    for (unsigned i = 0; i < 2; i++) {
+        vm_write32(0x1100, i ? 0xbd : 0xe0); vm_write32(0x1104, 0);
+        vm_write32(0x1120, i ? 0x200000 : 0x100000); vm_write32(0x1124, i ? 0x2000 : 0x80000);
+        vm_write32(0x1140, 2); vm_write32(0x1144, 0);
+        assert(cellDmuxEnableEs(handle, EA(CellDmuxEsFilterId, 0x1100), EA(CellDmuxEsResource, 0x1120),
+            EA(CellDmuxEsCb, 0x1140), nullptr, EA(u32, 0x1160)) == 0);
+        es[i] = vm_read32(0x1160);
+    }
+    assert(cellDmuxFlushEs(es[0]) == 0);
+    while (!flushes) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    assert(cellDmuxFlushEs(es[1]) == 0);
+    for (unsigned i = 0; flushes < 2 && i < 5000; i++) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    assert(flushes == 2);
+    printf("[K4-dmux] concurrent ES flush callbacks=2 PASS\n");
+    assert(cellDmuxSetStream(handle, 0x20000, 1024, true, 1) == 0);
+    for (unsigned i = 0; !finished && i < 5000; i++) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    assert(finished);
+    assert(cellDmuxResetStreamAndWaitDone(handle) == 0);
+    if (!failure) assert(callback_retired);
+    printf("[K4-dmux] callback refill callbacks=%u status=%08X %s\n", callbacks.load(), (u32)failure.load(), failure ? "FAIL" : "PASS");
+    assert(cellDmuxClose(handle) == 0); free(vm_base);
+    return failure ? 1 : 0;
+}
diff --git a/libs/codec/tests/test_movie.cpp b/libs/codec/tests/test_movie.cpp
new file mode 100644
index 0000000..a425783
--- /dev/null
+++ b/libs/codec/tests/test_movie.cpp
@@ -0,0 +1,203 @@
+/* Real PAMF -> guest demux callbacks -> vdec/adec -> vpost. No window/RSX. */
+#include <atomic>
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <string>
+#include <thread>
+#include <chrono>
+#include "../cellDmux.h"
+#include "../avc_sps.h"
+#include "../cellVdec.h"
+#include "../cellAdec.h"
+#include "../cellVpost.h"
+#include "../../../runtime/ppu/ppu_memory.h"
+#include "ps3emu/guest_call.h"
+extern "C" {
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t) {}
+void ps3_ww_report_inline(uint32_t, uint64_t, int) {}
+int spu_coh_is_reserved(uint32_t) { return 0; }
+void spu_coh_notify_write(uint32_t) {}
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+}
+#define EA(T, x) ((T*)(uintptr_t)(x))
+static u32 dmux, video, audio, vdec, adec, vpost;
+static std::atomic<bool> done{false}, flushed{false}, sequence_done{false}, consumer_stop{false};
+static std::atomic<unsigned> audone{0}, picout{0}, credits{0}, seqdone{0};
+static std::atomic<unsigned> pictures{0}, pcm{0}, errors{0};
+static double peak;
+static unsigned first_sound;
+static std::string directory;
+static u64 last_pts;
+static bool demux_only;
+static FILE* elementary;
+static void picture(u32 it = 0)
+{
+    if (!it) {
+        assert(cellVdecGetPicItem(vdec, EA(const CellVdecPicItem*, 0x1800)) == 0);
+        it = vm_read32(0x1800);
+    }
+    u32 inf = vm_read32(it + 72);
+    u32 w = vm_read16(inf), h = vm_read16(inf + 2); assert(w == 1280 && h == 720);
+    u64 pts = vm_read64(it + 16);
+    if (pictures && pts < last_pts) { fprintf(stderr, "PTS went backwards: %llu -> %llu\n", last_pts, pts); errors++; }
+    last_pts = pts;
+    vm_write32(0x1810, 3); vm_write32(0x1814, 1); vm_write8(0x1818, 255);
+    assert(cellVdecGetPicture(vdec, EA(void, 0x1810), EA(void, 0x1000000)) == 0);
+    memset(vm_ptr8(0x1900), 0, 96);
+    vm_write32(0x190c, w); vm_write32(0x1910, h); vm_write32(0x1918, 1); vm_write32(0x191c, 1);
+    vm_write32(0x1928, w); vm_write32(0x192c, h);
+    vm_write32(0x1930, 640); vm_write32(0x1934, 360); vm_write32(0x1940, 640); vm_write32(0x1944, 360); vm_write8(0x1948, 255);
+    assert(cellVpostExec(vpost, EA(void, 0x1000000), EA(CellVpostCtrlParam, 0x1900), EA(void, 0x1400000), EA(CellVpostPictureInfo, 0x1a00)) == 0);
+    assert(vm_read32(0x1a24) == 640 && vm_read32(0x1a28) == 360);
+    unsigned count = ++pictures;
+    if (count == 1 || count == 30 || count == 90 || count == 180 || count == 300 || count == 390 || count == 480 || count == 900) {
+        char name[512]; snprintf(name, sizeof(name), "%s/movie-%04u.ppm", directory.c_str(), count);
+        FILE* f = fopen(name, "wb"); assert(f); fprintf(f, "P6\n640 360\n255\n");
+        const u8* p = vm_ptr8(0x1400000);
+        for (unsigned i = 0; i < 640 * 360; i++) assert(fwrite(p + i * 4, 1, 3, f) == 3);
+        fclose(f); printf("[K-test] image=%s pts=%llu\n", name, (unsigned long long)pts);
+    }
+}
+static void callback(u32 opd, u64 a0, u64 a1, u64 a2, u64 a3, u64, u64, u64, u64)
+{
+    if (opd == 1) {
+        assert(a0 == dmux && a2 == 0x12345678);
+        u32 type = vm_read32((u32)a1);
+        if (type == CELL_DMUX_MSG_TYPE_FATAL_ERR) errors++;
+        if (type != CELL_DMUX_MSG_TYPE_PROG_END_CODE) done = true;
+    } else if (opd == 2 || opd == 3) {
+        assert(a0 == dmux && a3 == 0x87654321);
+        u32 type = vm_read32((u32)a2);
+        if (type == CELL_DMUX_ES_MSG_TYPE_FLUSH_DONE) { flushed = true; return; }
+        assert(type == CELL_DMUX_ES_MSG_TYPE_AU_FOUND);
+        u32 es = (u32)a1;
+        assert(cellDmuxGetAu(es, EA(CellDmuxAuInfo*, 0x1500), EA(u32, 0x1504)) == 0);
+        u32 au = vm_read32(0x1500), target = opd == 2 ? 0x1600 : 0x1700;
+        vm_write32(target, vm_read32(au)); vm_write32(target + 4, vm_read32(au + 4)); vm_write64(target + 8, vm_read64(au + 24));
+        if (opd == 2) { vm_write64(target + 16, vm_read64(au + 32)); vm_write64(target + 24, vm_read64(au + 16));
+            if (demux_only) {
+                u32 start = vm_read32(target), bytes = vm_read32(target + 4);
+                assert(fwrite(vm_ptr8(start), 1, bytes, elementary) == bytes); pictures++;
+            } else {
+                s32 status;
+                do { status = cellVdecDecodeAu(vdec, 0, EA(CellVdecAuInfo, target));
+                    if (status == (s32)CELL_VDEC_ERROR_BUSY) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+                } while (status == (s32)CELL_VDEC_ERROR_BUSY);
+                assert(status == 0);
+            } }
+        else { vm_write64(target + 16, vm_read64(au + 16)); assert(cellAdecDecodeAu(adec, EA(CellAdecAuInfo, target)) == 0); }
+        if (opd == 3 || demux_only) assert(cellDmuxReleaseAu(es) == 0);
+    } else if (opd == 4) {
+        if (a1 == CELL_VDEC_MSG_TYPE_AUDONE) { assert(cellDmuxReleaseAu(video) == 0); audone++; }
+        if (a1 == CELL_VDEC_MSG_TYPE_PICOUT) { picout++; credits++; }
+        if (a1 == CELL_VDEC_MSG_TYPE_SEQDONE) { if (a2) errors++; seqdone++; sequence_done = true; }
+        if (a1 == CELL_VDEC_MSG_TYPE_ERROR) errors++;
+    } else if (opd == 5) {
+        if (a1 == CELL_ADEC_MSG_TYPE_PCMOUT) {
+            assert(cellAdecGetPcmItem(adec, EA(const CellAdecPcmItem*, 0x1c00)) == 0);
+            u32 it = vm_read32(0x1c00), count = vm_read32(it + 12); assert(count == 16384);
+            u32 bsi = vm_read32(it + 16); assert(vm_read32(bsi) == 48000 && vm_read32(bsi + 4) == 2 && vm_read32(bsi + 8) == 688);
+            assert(cellAdecGetPcm(adec, EA(void, 0x1d00000)) == 0);
+            for (u32 i = 0; i < count / 4; i++) { float v = vm_read_f32(0x1d00000 + i * 4); assert(std::isfinite(v)); if (std::fabs(v) > peak) peak = std::fabs(v); }
+            unsigned block = ++pcm;
+            if (!first_sound && peak > 0.000001) { first_sound = block; printf("[K-test] first audible PCM=%u pts=%llu\n", block, (unsigned long long)vm_read64(it + 32)); }
+        }
+        if (a1 == CELL_ADEC_MSG_TYPE_ERROR) errors++;
+    }
+}
+static void resource(u32 ea, u32 base, u32 size) { vm_write32(ea, base); vm_write32(ea + 4, size); }
+static void cb(u32 ea, u32 opd, u32 arg) { vm_write32(ea, opd); vm_write32(ea + 4, arg); }
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, nullptr, _IOLBF, 0);
+    assert(argc >= 3); directory = argv[2]; demux_only = argc > 4 && !strcmp(argv[4], "--demux");
+    if (demux_only) { elementary = fopen((directory + "/movie.h264").c_str(), "wb"); assert(elementary); }
+    unsigned goal = argc > 3 ? (unsigned)atoi(argv[3]) : 900;
+    vm_base = (u8*)calloc(1, 32 * 1024 * 1024); assert(vm_base); g_ps3_guest_caller = callback;
+    vm_write32(0x1000, 1); resource(0x1020, 0x10000, 0x10000); cb(0x1040, 1, 0x12345678);
+    assert(cellDmuxQueryAttr(EA(CellDmuxType, 0x1000), EA(void, 0x1080)) == 0);
+    assert(cellDmuxOpen(EA(CellDmuxType, 0x1000), EA(CellDmuxResource, 0x1020), EA(CellDmuxCb, 0x1040), EA(u32, 0x1060)) == 0); dmux = vm_read32(0x1060);
+    for (int n = 0; n < 2; n++) {
+        vm_write32(0x1100, n ? 0xbd : 0xe0); vm_write32(0x1104, 0);
+        resource(0x1120, n ? 0x600000 : 0x100000, n ? 0x80000 : 0x400000); cb(0x1140, n ? 3 : 2, 0x87654321);
+        assert(cellDmuxEnableEs(dmux, EA(CellDmuxEsFilterId, 0x1100), EA(CellDmuxEsResource, 0x1120), EA(CellDmuxEsCb, 0x1140), nullptr, EA(u32, 0x1160)) == 0);
+        (n ? audio : video) = vm_read32(0x1160);
+    }
+    vm_write32(0x1200, 1); resource(0x1220, 0x800000, 0x100000); cb(0x1240, 4, 0);
+    assert(cellVdecOpen(EA(CellVdecType, 0x1200), EA(CellVdecResource, 0x1220), EA(CellVdecCb, 0x1240), EA(u32, 0x1260)) == 0); vdec = vm_read32(0x1260);
+    assert(cellVdecStartSeq(vdec) == 0);
+    vm_write32(0x1300, 3); resource(0x1320, 0xa00000, 0x40000); cb(0x1340, 5, 0);
+    assert(cellAdecOpen(EA(CellAdecType, 0x1300), EA(CellAdecResource, 0x1320), EA(CellAdecCb, 0x1340), EA(u32, 0x1360)) == 0); adec = vm_read32(0x1360);
+    vm_write32(0x1380, 48000); vm_write32(0x1384, 2); vm_write32(0x1388, 2); vm_write32(0x1394, 0x84);
+    assert(cellAdecStartSeq(adec, EA(void, 0x1380)) == 0);
+    vm_write32(0x1400, 1280); vm_write32(0x1404, 720); vm_write32(0x1410, 1280); vm_write32(0x1414, 720);
+    resource(0x1430, 0xb00000, 0x10000);
+    assert(cellVpostOpen(EA(CellVpostCfgParam, 0x1400), EA(CellVpostResource, 0x1430), EA(u32, 0x1450)) == 0); vpost = vm_read32(0x1450);
+    std::thread consumer([] {
+        /* Force the real 64-picture/8-ES-slot back-pressure path when requested. */
+        if (std::getenv("K3_DEFER_PICTURES")) {
+            while (credits < 64 && !errors) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            if (!errors) {
+                u32 items[64]; u64 pts[64];
+                for (unsigned i = 0; i < 64; i++) {
+                    assert(cellVdecGetPicItem(vdec, EA(const CellVdecPicItem*, 0x1800)) == 0);
+                    items[i] = vm_read32(0x1800); pts[i] = vm_read64(items[i] + 16);
+                    if (i) assert(items[i] != items[i - 1] && pts[i] > pts[i - 1]);
+                }
+                assert(cellVdecGetPicItem(vdec, EA(const CellVdecPicItem*, 0x1800)) == (s32)CELL_VDEC_ERROR_EMPTY);
+                for (unsigned i = 0; i < 64; i++) { assert(vm_read64(items[i] + 16) == pts[i]); picture(items[i]); credits--; }
+                printf("[K3-test] 64 deferred pictures, independent PicItems, ES back-pressure PASS\n");
+            }
+        }
+        while (!consumer_stop || credits) {
+            if (credits) { picture(); credits--; }
+            else std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+    });
+    FILE* f = fopen(argv[1], "rb"); assert(f);
+    u8 header[4096]; assert(fread(header, 1, sizeof(header), f) == sizeof(header));
+    bool sps_found = false;
+    for (unsigned i = 2048; i + 64 < sizeof(header); i++) if (!header[i] && !header[i+1] && header[i+2] == 1 && (header[i+3] & 31) == 7) {
+        unsigned end = i + 4;
+        while (end + 3 < sizeof(header) && (header[end] || header[end+1] || header[end+2] != 1)) end++;
+        AvcSpsInfo info;
+        assert(avc_parse_sps(header + i + 3, end - i - 3, &info) == 0);
+        assert(info.width == 1280 && info.height == 720 && info.frame_rate_code == 0 && info.units == 5005 && info.scale == 240000);
+        sps_found = true; break;
+    }
+    assert(sps_found); printf("[K-test] real SPS: 1280x720 progressive 24000/1001 fps PASS\n");
+    fseek(f, 2048, SEEK_SET);
+    /* Prime-sized chunks deliberately split pack, PES, AVC and ATS headers. */
+    unsigned blocks = 0; bool eof = false;
+    while ((!goal || pictures < goal) && !errors) {
+        size_t n = fread(vm_ptr8(0xc00000), 1, 65521, f); if (!n) { eof = true; break; }
+        done = false; assert(cellDmuxSetStream(dmux, 0xc00000, (u32)n, blocks++ == 0, 0x1122334455667788ull) == 0);
+        for (int wait = 0; !done && wait < 10000; wait++) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        assert(done);
+    }
+    fclose(f);
+    /* A goal-limited run may end mid-picture. Only submit the pending AU
+     * at actual EOF; flushing a partial PES/AU created a spurious bad-data error. */
+    if (eof) {
+        flushed = false; assert(cellDmuxFlushEs(video) == 0);
+        while (!flushed) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    assert(cellVdecEndSeq(vdec) == 0);
+    for (int wait = 0; !sequence_done && wait < 10000; wait++) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    assert(sequence_done); consumer_stop = true; consumer.join();
+    if (!demux_only && !errors) assert(audone == picout && picout == pictures && seqdone == 1);
+    printf("[K3-test] AUDONE=%u PICOUT=%u SEQDONE=%u\n", audone.load(), picout.load(), seqdone.load());
+    if (elementary) fclose(elementary);
+    printf("[K-test] frames=%u PCM=%u peak=%.6f errors=%u blocks=%u\n", pictures.load(), pcm.load(), peak, errors.load(), blocks);
+    bool ok = pictures && (!goal ? pictures == 2793 : pictures >= goal) && pcm && peak > 0.01 && !errors;
+    assert(cellDmuxClose(dmux) == 0); assert(cellVdecClose(vdec) == 0); assert(cellAdecClose(adec) == 0); assert(cellVpostClose(vpost) == 0);
+    free(vm_base); return ok ? 0 : 1;
+}
diff --git a/libs/codec/tests/test_pamf.c b/libs/codec/tests/test_pamf.c
new file mode 100644
index 0000000..a9b6be0
--- /dev/null
+++ b/libs/codec/tests/test_pamf.c
@@ -0,0 +1,61 @@
+/* ABI/header regression; optionally checks the actual movie's first sector. */
+#include "../cellPamf.h"
+#include "../../../runtime/ppu/ppu_memory.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+#define EA(type, address) ((type*)(uintptr_t)(address))
+int main(int argc, char** argv)
+{
+    vm_base = calloc(1, 0x10000);
+    if (argc > 1) {
+        FILE* f = fopen(argv[1], "rb"); assert(f);
+        assert(fread(vm_ptr8(0x1000), 1, 2048, f) == 2048); fclose(f);
+    } else {
+        memcpy(vm_ptr8(0x1000), "PAMF0041", 8);
+        vm_write32(0x1008, 1); vm_write32(0x100C, 144459);
+        vm_write8(0x1087, 2);
+        vm_write8(0x1088, 0x1B); vm_write8(0x108C, 0xE0);
+        vm_write8(0x1098, 100); vm_write8(0x1099, 41); vm_write8(0x109A, 0xC1);
+        vm_write8(0x10A1, 80); vm_write8(0x10A3, 45);
+        vm_write8(0x10B8, 0xDC); vm_write8(0x10BC, 0xBD);
+        vm_write8(0x10CA, 2); vm_write8(0x10CB, 1);
+    }
+    const u64 fileSize = 295854080;
+    assert(cellPamfGetHeaderSize(EA(void,0x1000), fileSize, EA(u64,0x2000)) == CELL_OK);
+    assert(vm_read64(0x2000) == 2048);
+    assert(cellPamfGetStreamOffsetAndSize(EA(void,0x1000), fileSize, EA(u64,0x2008), EA(u64,0x2010)) == CELL_OK);
+    assert(vm_read64(0x2008) == 2048 && vm_read64(0x2010) == 295852032);
+    assert(cellPamfGetHeaderSize(EA(void,0x1000), fileSize-1, EA(u64,0x2000)) == (s32)CELL_PAMF_ERROR_INVALID_HEADER);
+    CellPamfReader* reader = EA(CellPamfReader,0x2100);
+    memset(vm_ptr8(0x2100), 0xA5, 64);
+    assert(cellPamfReaderInitialize(reader, EA(void,0x1000), fileSize, 1) == CELL_OK);
+    for (int i=0;i<64;i++) assert(vm_read8(0x2100+i) == 0xA5); /* host layout never overwrites guest */
+    assert(cellPamfReaderGetNumberOfSpecificStreams(reader, CELL_PAMF_STREAM_TYPE_VIDEO) == 1);
+    assert(cellPamfReaderGetNumberOfSpecificStreams(reader, CELL_PAMF_STREAM_TYPE_AUDIO) == 1);
+    assert(cellPamfReaderSetStreamWithTypeAndIndex(reader, CELL_PAMF_STREAM_TYPE_VIDEO, 0) == 0);
+    assert(cellPamfReaderGetStreamTypeAndChannel(reader, EA(u8,0x2020), EA(u8,0x2021)) == CELL_OK);
+    assert(vm_read8(0x2020) == 0 && vm_read8(0x2021) == 0);
+    assert(cellPamfReaderGetStreamInfo(reader, EA(void,0x2200), 32) == CELL_OK);
+    assert(vm_read16(0x220A) == 1280 && vm_read16(0x220C) == 720);
+    assert(cellPamfReaderSetStreamWithTypeAndIndex(reader, CELL_PAMF_STREAM_TYPE_AUDIO, 0) == 1);
+    assert(cellPamfReaderGetStreamTypeAndChannel(reader, EA(u8,0x2020), EA(u8,0x2021)) == CELL_OK);
+    assert(vm_read8(0x2020) == 2 && vm_read8(0x2021) == 0);
+    assert(cellPamfReaderGetStreamInfo(reader, EA(void,0x2200), 8) == CELL_OK);
+    assert(vm_read32(0x2200) == 1 && vm_read8(0x2204) == 2);
+    assert(cellPamfStreamTypeToEsFilterId(CELL_PAMF_STREAM_TYPE_ATRAC3PLUS, 0, EA(void,0x2300)) == CELL_OK);
+    assert(vm_read32(0x2300) == 0xBD && vm_read32(0x2304) == 0);
+    assert(cellPamfStreamTypeToEsFilterId(CELL_PAMF_STREAM_TYPE_AVC, 0, EA(void,0x2300)) == CELL_OK);
+    assert(vm_read32(0x2300) == 0xE0 && vm_read32(0x2308) == 1);
+    printf("[I-test] PAMF sectors, 64-bit guest outputs, stream selection, AVC/audio ABI: PASS (%s)\n", argc>1 ? "dis3_0.dat header" : "synthetic");
+    free(vm_base); return 0;
+}
