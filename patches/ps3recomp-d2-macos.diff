diff --git a/runtime/platform/guest_poll.c b/runtime/platform/guest_poll.c
new file mode 100644
index 0000000..1426c8d
--- /dev/null
+++ b/runtime/platform/guest_poll.c
@@ -0,0 +1,184 @@
+/* Polling is a scheduling hint, never a substitute for a guest read/DMA.
+ * Notifications cover PPU stores and SPU writes. HLE/direct mapped writes
+ * need not notify: every wait is bounded to 100 us and callers re-read.
+ * No guest reservation is created, consumed, or invalidated by a poll. */
+#include "guest_poll.h"
+#include "win32_compat.h"
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+int ps3_poll_enabled = 1;
+#ifndef _WIN32
+#include <pthread.h>
+#include <time.h>
+#include <sched.h>
+#include <stdatomic.h>
+
+#define POLL_BUCKETS 256
+/* A finer line filter avoids broadcasting to unrelated waiters sharing a
+ * mutex bucket. Collisions only cause extra work, never missed wakeups. */
+#define POLL_LINES 4096
+static atomic_uint s_lines[POLL_LINES];
+typedef struct poll_bucket {
+    pthread_mutex_t lock;
+    pthread_cond_t changed;
+    atomic_uint waiters;
+} poll_bucket;
+static poll_bucket s_buckets[POLL_BUCKETS];
+static pthread_once_t s_init = PTHREAD_ONCE_INIT;
+static poll_bucket* poll_slot(uint32_t ea)
+{
+    return &s_buckets[((ea >> 7) ^ (ea >> 15)) & (POLL_BUCKETS - 1)];
+}
+static void poll_init(void)
+{
+    const char* e = getenv("PS3_POLL_BACKOFF");
+    ps3_poll_enabled = !(e && *e == '0');
+#ifndef __APPLE__
+    pthread_condattr_t attr;
+    pthread_condattr_init(&attr);
+    pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+#endif
+    for (unsigned i = 0; i < POLL_BUCKETS; i++) {
+        pthread_mutex_init(&s_buckets[i].lock, NULL);
+#ifdef __APPLE__
+        pthread_cond_init(&s_buckets[i].changed, NULL);
+#else
+        pthread_cond_init(&s_buckets[i].changed, &attr);
+#endif
+    }
+#ifndef __APPLE__
+    pthread_condattr_destroy(&attr);
+#endif
+}
+void ps3_poll_backoff(uint32_t repeats, uint32_t ea, const void* value, uint32_t size)
+{
+    if (!ps3_poll_enabled || repeats < 32 || !size) return;
+    pthread_once(&s_init, poll_init);
+    if (!ps3_poll_enabled) return;
+    if (repeats < 40) { sched_yield(); return; }
+    /* A condition belongs to the first line's bucket. A value spanning lines
+     * could be changed by a store into a different bucket; yield/re-read for
+     * those rare unaligned polls rather than relying on its notification. */
+    if (size > 128 - (ea & 127)) { sched_yield(); return; }
+    extern uint8_t* vm_base;
+    poll_bucket* b = poll_slot(ea);
+    pthread_mutex_lock(&b->lock);
+    atomic_fetch_add_explicit(&b->waiters, 1, memory_order_seq_cst);
+    atomic_fetch_add_explicit(&s_lines[(ea >> 7) & (POLL_LINES - 1)], 1, memory_order_seq_cst);
+    /* Register before checking the value, under the same lock as notify.
+     * A store racing registration is either seen here or wakes the wait. */
+    if (!memcmp(vm_base + ea, value, size)) {
+#ifdef __APPLE__
+        struct timespec delay = {0, 100000};
+        pthread_cond_timedwait_relative_np(&b->changed, &b->lock, &delay);
+#else
+        struct timespec deadline;
+        clock_gettime(CLOCK_MONOTONIC, &deadline);
+        deadline.tv_nsec += 100000;
+        if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+        pthread_cond_timedwait(&b->changed, &b->lock, &deadline);
+#endif
+    }
+    atomic_fetch_sub_explicit(&s_lines[(ea >> 7) & (POLL_LINES - 1)], 1, memory_order_seq_cst);
+    atomic_fetch_sub_explicit(&b->waiters, 1, memory_order_seq_cst);
+    pthread_mutex_unlock(&b->lock);
+}
+void ps3_poll_notify(uint32_t ea, uint32_t size)
+{
+    if (!size) return;
+    uint32_t last = (uint32_t)(((uint64_t)ea + size - 1) >> 7);
+    for (uint32_t line = ea >> 7; line <= last; line++) {
+        /* Register the filter before the under-lock value recheck, just like
+         * the bucket count. A racing store is observed or wakes the waiter. */
+        if (!atomic_load_explicit(&s_lines[line & (POLL_LINES - 1)], memory_order_seq_cst)) continue;
+        poll_bucket* b = poll_slot(line << 7);
+        if (!atomic_load_explicit(&b->waiters, memory_order_seq_cst)) continue;
+        pthread_mutex_lock(&b->lock);
+        pthread_cond_broadcast(&b->changed);
+        pthread_mutex_unlock(&b->lock);
+    }
+}
+
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <sys/resource.h>
+static pthread_once_t s_profile_once = PTHREAD_ONCE_INIT;
+static void* cpu_profile(void* unused)
+{
+    (void)unused;
+    struct rusage prev;
+    getrusage(RUSAGE_SELF, &prev);
+    uint64_t previous[1024] = {0};
+    mach_port_t previous_port[1024] = {0};
+    struct timespec prior_time;
+    clock_gettime(CLOCK_MONOTONIC, &prior_time);
+    for (;;) {
+        struct timespec delay = {5, 0};
+        nanosleep(&delay, NULL);
+        struct timespec current_time;
+        clock_gettime(CLOCK_MONOTONIC, &current_time);
+        double elapsed = current_time.tv_sec - prior_time.tv_sec +
+                         (current_time.tv_nsec - prior_time.tv_nsec) / 1e9;
+        prior_time = current_time;
+        struct rusage cur;
+        getrusage(RUSAGE_SELF, &cur);
+        double cpu = cur.ru_utime.tv_sec - prev.ru_utime.tv_sec +
+                     cur.ru_stime.tv_sec - prev.ru_stime.tv_sec +
+                     (cur.ru_utime.tv_usec - prev.ru_utime.tv_usec +
+                      cur.ru_stime.tv_usec - prev.ru_stime.tv_usec) / 1e6;
+        fprintf(stderr, "[HOSTCPU] process=%.1f%% interval=%.3fs\n", cpu * 100 / elapsed, elapsed);
+        prev = cur;
+        thread_act_array_t threads;
+        mach_msg_type_number_t count;
+        if (task_threads(mach_task_self(), &threads, &count) != KERN_SUCCESS) continue;
+        for (unsigned i = 0; i < count; i++) {
+            thread_basic_info_data_t info;
+            mach_msg_type_number_t n = THREAD_BASIC_INFO_COUNT;
+            if (thread_info(threads[i], THREAD_BASIC_INFO, (thread_info_t)&info, &n) == KERN_SUCCESS) {
+                uint64_t us = (uint64_t)(info.user_time.seconds + info.system_time.seconds) * 1000000 +
+                              info.user_time.microseconds + info.system_time.microseconds;
+                unsigned slot = (threads[i] >> 8) & 1023;
+                uint64_t old = previous_port[slot] == threads[i] ? previous[slot] : 0;
+                double pct = us >= old ? (us - old) / (elapsed * 10000) : 0;
