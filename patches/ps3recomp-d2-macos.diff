diff --git a/libs/system/param_sfo.h b/libs/system/param_sfo.h
new file mode 100644
index 0000000..1f5d04a
--- /dev/null
+++ b/libs/system/param_sfo.h
@@ -0,0 +1,142 @@
+/* Binary little-endian PARAM.SFO reader/writer shared by game and save data. */
+#ifndef PS3RECOMP_PARAM_SFO_H
+#define PS3RECOMP_PARAM_SFO_H
+#include "ps3emu/ps3types.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SAVE_SFO_MAX 256
+typedef struct SaveSfoEntry {
+    char key[64];
+    u16 format;
+    u32 size, capacity;
+    u8* data;
+} SaveSfoEntry;
+typedef struct SaveSfo { u32 count; SaveSfoEntry entries[SAVE_SFO_MAX]; } SaveSfo;
+
+static u32 sfo_le32(const u8* p)
+{
+    return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+static void sfo_put32(u8* p, u32 n)
+{
+    p[0] = (u8)n; p[1] = (u8)(n >> 8); p[2] = (u8)(n >> 16); p[3] = (u8)(n >> 24);
+}
+static void sfo_free(SaveSfo* s)
+{
+    for (u32 i = 0; i < s->count; i++) free(s->entries[i].data);
+    memset(s, 0, sizeof(*s));
+}
+static SaveSfoEntry* sfo_find(SaveSfo* s, const char* key)
+{
+    for (u32 i = 0; i < s->count; i++)
+        if (!strcmp(s->entries[i].key, key)) return &s->entries[i];
+    return NULL;
+}
+static int sfo_set(SaveSfo* s, const char* key, u16 format,
+                   const void* data, u32 size, u32 capacity)
+{
+    if (strlen(key) >= 64 || size > capacity || capacity > 65536) return 0;
+    SaveSfoEntry* e = sfo_find(s, key);
+    if (!e) {
+        if (s->count == SAVE_SFO_MAX) return 0;
+        e = &s->entries[s->count++];
+        strcpy(e->key, key);
+    }
+    u8* copy = calloc(1, capacity ? capacity : 1);
+    if (!copy) return 0;
+    if (size) memcpy(copy, data, size);
+    free(e->data); e->data = copy;
+    e->format = format; e->size = size; e->capacity = capacity;
+    return 1;
+}
+static int sfo_set_int(SaveSfo* s, const char* key, u32 n)
+{
+    u8 data[4]; sfo_put32(data, n);
+    return sfo_set(s, key, 0x0404, data, 4, 4);
+}
+static int sfo_set_str(SaveSfo* s, const char* key, const char* text, u32 capacity)
+{
+    u32 len = (u32)strnlen(text, capacity);
+    if (len == capacity) return 0;
+    return sfo_set(s, key, 0x0204, text, len + 1, capacity);
+}
+static void sfo_remove(SaveSfo* s, const char* key)
+{
+    SaveSfoEntry* e = sfo_find(s, key);
+    if (!e) return;
+    u32 i = (u32)(e - s->entries);
+    free(e->data);
+    memmove(e, e + 1, (s->count - i - 1) * sizeof(*e));
+    memset(&s->entries[--s->count], 0, sizeof(*e));
+}
+static int sfo_load(const char* path, SaveSfo* s)
+{
+    memset(s, 0, sizeof(*s));
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END); long length = ftell(f); rewind(f);
+    if (length < 20 || length > 1024 * 1024) { fclose(f); return 0; }
+    u8* bytes = malloc((size_t)length);
+    if (!bytes) { fclose(f); return 0; }
+    int ok = fread(bytes, 1, (size_t)length, f) == (size_t)length;
+    fclose(f);
+    if (!ok) { free(bytes); return 0; }
+    u32 keys = sfo_le32(bytes + 8), data = sfo_le32(bytes + 12);
+    u32 count = sfo_le32(bytes + 16);
+    ok = !memcmp(bytes, "\0PSF", 4) && sfo_le32(bytes + 4) == 0x101 &&
+         count <= SAVE_SFO_MAX &&
+         20 + count * 16 <= keys && keys <= data && data <= (u32)length;
+    for (u32 i = 0; ok && i < count; i++) {
+        const u8* e = bytes + 20 + i * 16;
+        u32 key = keys + ((u32)e[0] | (u32)e[1] << 8);
+        u32 size = sfo_le32(e + 4), cap = sfo_le32(e + 8), off = sfo_le32(e + 12);
+        ok = key < data && memchr(bytes + key, 0, data - key) &&
+             size <= cap && cap <= 65536 && (u64)data + off + cap <= (u32)length;
+        if (ok) ok = sfo_set(s, (char*)bytes + key, (u16)(e[2] | e[3] << 8),
+                             bytes + data + off, size, cap);
+    }
+    free(bytes);
+    if (!ok) sfo_free(s);
+    return ok;
+}
+static int sfo_entry_compare(const void* a, const void* b)
+{
+    return strcmp(((const SaveSfoEntry*)a)->key, ((const SaveSfoEntry*)b)->key);
+}
+static int sfo_store(const char* path, SaveSfo* s)
+{
+    qsort(s->entries, s->count, sizeof(s->entries[0]), sfo_entry_compare);
+    u32 key_size = 0, data_size = 0;
+    for (u32 i = 0; i < s->count; i++) {
+        key_size += (u32)strlen(s->entries[i].key) + 1;
+        data_size += (s->entries[i].capacity + 3) & ~3u;
+    }
+    u32 keys = 20 + s->count * 16, data = (keys + key_size + 3) & ~3u;
+    u32 size = data + data_size;
+    u8* bytes = calloc(1, size);
+    if (!bytes) return 0;
+    memcpy(bytes, "\0PSF", 4); sfo_put32(bytes + 4, 0x101);
+    sfo_put32(bytes + 8, keys); sfo_put32(bytes + 12, data); sfo_put32(bytes + 16, s->count);
+    u32 k = 0, d = 0;
+    for (u32 i = 0; i < s->count; i++) {
+        SaveSfoEntry* entry = &s->entries[i];
+        u8* e = bytes + 20 + i * 16;
+        e[0] = (u8)k; e[1] = (u8)(k >> 8);
+        e[2] = (u8)entry->format; e[3] = (u8)(entry->format >> 8);
+        sfo_put32(e + 4, entry->size); sfo_put32(e + 8, entry->capacity); sfo_put32(e + 12, d);
+        strcpy((char*)bytes + keys + k, entry->key);
+        memcpy(bytes + data + d, entry->data, entry->size);
+        k += (u32)strlen(entry->key) + 1; d += (entry->capacity + 3) & ~3u;
+    }
+    char temp[1100]; snprintf(temp, sizeof(temp), "%s.tmp", path);
+    FILE* f = fopen(temp, "wb");
+    int ok = f && fwrite(bytes, 1, size, f) == size;
+    if (f && fclose(f) != 0) ok = 0;
+    free(bytes);
+    if (ok) ok = rename(temp, path) == 0;
+    if (!ok) remove(temp);
+    return ok;
+}
+#endif
diff --git a/libs/system/savedata_sfo.h b/libs/system/savedata_sfo.h
new file mode 100644
index 0000000..2ef9b6f
--- /dev/null
+++ b/libs/system/savedata_sfo.h
@@ -0,0 +1,67 @@
+/* Binary PSF metadata used by cellSaveData and RPCS3 (little endian on disk).
+ * Keep unknown entries when updating imported saves. Secure-file flags are
+ * integer entries named *<filename>; PARAM.PFD is not a plaintext manifest. */
+#ifndef PS3RECOMP_SAVEDATA_SFO_H
+#define PS3RECOMP_SAVEDATA_SFO_H
+
+#include "param_sfo.h"
+
+static int read_param_sfo(const char* save_path, CellSaveDataSystemFileParam* param)
+{
+    memset(param, 0, sizeof(*param));
+    char path[1024]; snprintf(path, sizeof(path), "%s/PARAM.SFO", save_path);
+    SaveSfo s;
+    if (!sfo_load(path, &s)) return 0;
+    const char* keys[] = { "TITLE", "SUB_TITLE", "DETAIL", "SAVEDATA_LIST_PARAM" };
+    char* dest[] = { param->title, param->subTitle, param->detail, param->listParam };
+    u32 sizes[] = { 128, 128, 1024, 8 };
+    for (u32 i = 0; i < 4; i++) {
+        SaveSfoEntry* e = sfo_find(&s, keys[i]);
+        if (e) memcpy(dest[i], e->data, e->size < sizes[i] ? e->size : sizes[i] - 1);
+    }
+    SaveSfoEntry* e = sfo_find(&s, "ATTRIBUTE");
+    if (e && e->size == 4) param->attribute = sfo_le32(e->data);
+    sfo_free(&s);
+    return 1;
+}
+static int write_param_sfo(const char* save_path, const CellSaveDataSystemFileParam* param)
+{
+    char path[1024]; snprintf(path, sizeof(path), "%s/PARAM.SFO", save_path);
+    SaveSfo s; sfo_load(path, &s);
+    const char* name = strrchr(save_path, '/'); name = name ? name + 1 : save_path;
+    int ok = (sfo_find(&s, "ACCOUNT_ID") ||
+              sfo_set(&s, "ACCOUNT_ID", 0x0004, "0000000000000000", 16, 16)) &&
+             sfo_set_int(&s, "ATTRIBUTE", param->attribute) &&
+             sfo_set_str(&s, "CATEGORY", "SD", 4) &&
+             (sfo_find(&s, "PARAMS") || sfo_set_str(&s, "PARAMS", "", 1024)) &&
+             (sfo_find(&s, "PARAMS2") || sfo_set_str(&s, "PARAMS2", "", 12)) &&
+             (sfo_find(&s, "PARENTAL_LEVEL") || sfo_set_int(&s, "PARENTAL_LEVEL", 0)) &&
+             sfo_set_str(&s, "SAVEDATA_DIRECTORY", name, 32) &&
+             sfo_set_str(&s, "TITLE", param->title, 128) &&
+             sfo_set_str(&s, "SUB_TITLE", param->subTitle, 128) &&
+             sfo_set_str(&s, "DETAIL", param->detail, 1024) &&
+             sfo_set_str(&s, "SAVEDATA_LIST_PARAM", param->listParam, 8);
+    if (ok) ok = sfo_store(path, &s);
+    sfo_free(&s);
+    return ok;
+}
+static int sfo_file_flag(const char* save_path, const char* name, int value)
+{
+    char path[1024], key[64];
+    snprintf(path, sizeof(path), "%s/PARAM.SFO", save_path);
+    snprintf(key, sizeof(key), "*%s", name);
+    SaveSfo s;
+    if (!sfo_load(path, &s)) return 0;
+    int ok;
+    if (value == -2) {
+        SaveSfoEntry* e = sfo_find(&s, key);
+        ok = e && e->size == 4 && sfo_le32(e->data) != 0;
+    } else {
+        if (value < 0) { sfo_remove(&s, key); ok = 1; }
+        else ok = sfo_set_int(&s, key, (u32)value);
+        if (ok) ok = sfo_store(path, &s);
+    }
+    sfo_free(&s);
+    return ok;
+}
+#endif
diff --git a/libs/system/sys_overlay.c b/libs/system/sys_overlay.c
new file mode 100644
index 0000000..3bc1217
--- /dev/null
+++ b/libs/system/sys_overlay.c
@@ -0,0 +1,231 @@
+/* System UI state is independent of AppKit and RSX. Save callers may wait on
+ * their guest thread; the renderer/input pump never waits for the guest. */
+#include "sys_overlay.h"
+#include "../input/cellPad.h"
+#include "../../runtime/platform/win32_compat.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static SRWLOCK s_poll_lock = SRWLOCK_INIT;
+static SysOverlaySnapshot s_ui;
+static uint64_t s_serial, s_headless_deadline;
+static int s_renderer, s_completed, s_result, s_armed, s_auto_result;
+static uint16_t s_previous, s_repeat_button;
+static uint64_t s_repeat_deadline;
+#define OVERLAY_INPUT 0xFFFFu
+static struct { uint16_t buttons; int selected; } s_actions[32];
+static unsigned s_action_read, s_action_write;
+
+static void finish_locked(int result)
+{
+    s_ui.active = 0;
+    s_ui.revision++;
+    s_completed = 1;
+    s_result = result;
+    ps3_pad_overlay_capture(0);
+    fprintf(stderr, "[sys overlay] closed token=%llu result=%d selected=%d\n",
+            (unsigned long long)s_ui.token, result, s_ui.selected);
+}
+
+void ps3_overlay_set_renderer(int available)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    s_renderer = available;
+    if (!available && s_ui.active && s_ui.kind != SYS_OVERLAY_EDITOR) s_headless_deadline = GetTickCount64() + 1;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+uint64_t ps3_overlay_open(const SysOverlaySnapshot* request, int headless_result)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_ui.active || s_completed || request->count < 0 ||
+        request->count > SYS_OVERLAY_MAX_ITEMS || request->progress_count < 0 ||
+        request->progress_count > 2) {
+        ReleaseSRWLockExclusive(&s_lock);
+        return 0;
+    }
+    s_ui = *request;
+    s_ui.token = ++s_serial;
+    s_ui.revision = s_serial << 32;
+    s_ui.active = 1;
+    if (s_ui.selected < 0 || s_ui.selected >= (s_ui.count ? s_ui.count : 2)) s_ui.selected = 0;
+    s_previous = s_repeat_button = 0; s_repeat_deadline = 0;
+    s_action_read = s_action_write = 0;
+    s_armed = 0; /* require release of the button that opened the UI */
+    s_auto_result = headless_result;
+    const char* ui = getenv("PS3_SAVEDATA_UI");
+    const char* headless = getenv("PS3RECOMP_METAL_HEADLESS");
+    int automatic = !s_renderer || (ui && !strcmp(ui, "headless")) ||
+                    (headless && *headless && strcmp(headless, "0"));
+    s_headless_deadline = automatic && s_ui.kind != SYS_OVERLAY_EDITOR ? GetTickCount64() +
+        (s_ui.kind == SYS_OVERLAY_PROGRESS ? 2000 : 0) : 0;
+    ps3_pad_overlay_capture(1);
+    fprintf(stderr, "[sys overlay] open token=%llu title='%s' message='%s' items=%d%s\n",
+            (unsigned long long)s_ui.token, s_ui.title, s_ui.message, s_ui.count,
+            automatic ? " headless" : "");
+    uint64_t token = s_ui.token;
+    ReleaseSRWLockExclusive(&s_lock);
+    return token;
+}
+
+void ps3_overlay_snapshot(SysOverlaySnapshot* snapshot)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    *snapshot = s_ui;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+static void input_locked(uint16_t buttons)
+{
+    if (s_ui.active) {
+        uint16_t current = buttons & OVERLAY_INPUT;
+        if (!s_armed) { if (!current) s_armed = 1; }
+        else {
+            uint16_t pressed = current & ~s_previous;
+            if (s_ui.kind == SYS_OVERLAY_EDITOR) {
+                uint16_t direction = current & 0xF0;
+                uint64_t now = GetTickCount64();
+                if (direction != s_repeat_button) {
+                    s_repeat_button = direction; s_repeat_deadline = now + 400;
+                } else if (direction && now >= s_repeat_deadline) {
+                    pressed |= direction; s_repeat_deadline = now + 80;
+                }
+                if ((pressed & 0x10) && s_ui.selected > 0) { s_ui.selected--; s_ui.revision++; }
+                if ((pressed & 0x40) && s_ui.selected + 1 < s_ui.count) { s_ui.selected++; s_ui.revision++; }
+                uint16_t action = pressed & ~0x50u;
+                if (action && s_action_write - s_action_read < 32) {
+                    unsigned index = s_action_write++ % 32;
+                    s_actions[index].buttons = action;
+                    s_actions[index].selected = s_ui.selected;
+                }
+            } else if ((pressed & 0x2000) && !s_ui.cancel_disabled) finish_locked(SYS_OVERLAY_BACK);
+            else if ((pressed & 0x4000) && s_ui.buttons)
+                finish_locked(s_ui.kind == SYS_OVERLAY_YESNO && s_ui.selected ? SYS_OVERLAY_NO : SYS_OVERLAY_OK);
+            else if (s_ui.kind == SYS_OVERLAY_LIST && s_ui.count) {
+                if ((pressed & 0x90) && s_ui.selected > 0) { s_ui.selected--; s_ui.revision++; }
+                if ((pressed & 0x60) && s_ui.selected + 1 < s_ui.count) { s_ui.selected++; s_ui.revision++; }
+            } else if (s_ui.kind == SYS_OVERLAY_YESNO && (pressed & 0xF0)) {
+                s_ui.selected ^= 1; s_ui.revision++;
+            }
+        }
+        s_previous = current;
+    }
+}
+
+void ps3_overlay_input(uint16_t buttons)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    input_locked(buttons);
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+void ps3_overlay_poll(void)
+{
+    /* Host reads can dispatch to AppKit. Never wait for another poll here:
+     * main must remain free to service that dispatch, and snapshots must be
+     * applied in the order they were read. */
+    if (!TryAcquireSRWLockExclusive(&s_poll_lock)) return;
+    AcquireSRWLockExclusive(&s_lock);
+    int active = s_ui.active;
+    uint64_t token = s_ui.token;
+    if (active && s_headless_deadline && GetTickCount64() >= s_headless_deadline) {
+        finish_locked(s_auto_result);
+        active = 0;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    if (active) {
+        uint16_t buttons = ps3_pad_host_buttons();
+        AcquireSRWLockExclusive(&s_lock);
+        if (s_ui.token == token) input_locked(buttons);
+        ReleaseSRWLockExclusive(&s_lock);
+    }
+    ReleaseSRWLockExclusive(&s_poll_lock);
+}
+
+void ps3_overlay_finish(uint64_t token, int result)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_ui.active && s_ui.token == token) finish_locked(result);
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+void ps3_overlay_close_after(uint64_t token, unsigned delay_ms, int result)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_ui.active && s_ui.token == token) {
+        s_auto_result = result;
+        s_headless_deadline = GetTickCount64() + delay_ms;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+int ps3_overlay_take_result(uint64_t token, int* result, int* selected)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    int done = s_completed && s_ui.token == token;
+    if (done) {
+        if (result) *result = s_result;
+        if (selected) *selected = s_ui.selected;
+        s_completed = 0;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return done;
+}
+
+int ps3_overlay_wait(uint64_t token, int* selected)
+{
+    if (!token) return SYS_OVERLAY_BACK;
+    int result;
+    do { ps3_overlay_poll(); if (ps3_overlay_take_result(token, &result, selected)) return result;
+         Sleep(8); } while (1);
+}
+
+int ps3_overlay_progress(uint64_t token, unsigned index, const char* message,
+                         unsigned value, int increment)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    int valid = s_ui.active && s_ui.token == token && index < (unsigned)s_ui.progress_count;
+    if (valid) {
+        if (message) snprintf(s_ui.progress_message[index], sizeof s_ui.progress_message[index], "%s", message);
+        else {
+            uint64_t v = increment ? (uint64_t)s_ui.progress[index] + value : value;
+            s_ui.progress[index] = v > 100 ? 100 : (unsigned)v;
+        }
+        s_ui.revision++;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return valid;
+}
+
+int ps3_overlay_editor_update(uint64_t token, const SysOverlaySnapshot* request)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    int valid = s_ui.active && s_ui.token == token && s_ui.kind == SYS_OVERLAY_EDITOR &&
+        request->kind == SYS_OVERLAY_EDITOR && request->count >= 0 && request->count <= SYS_OVERLAY_MAX_ITEMS;
+    if (valid) {
+        uint64_t revision = s_ui.revision + 1;
+        int selected = request->selected < 0 ? s_ui.selected : request->selected;
+        if (strcmp(s_ui.title, request->title)) s_action_read = s_action_write;
+        s_ui = *request; s_ui.selected = selected < s_ui.count ? selected : 0; s_ui.token = token; s_ui.revision = revision; s_ui.active = 1;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return valid;
+}
+
+uint16_t ps3_overlay_editor_action(uint64_t token, int* selected)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    uint16_t action = 0;
+    if (s_ui.active && s_ui.token == token && s_ui.kind == SYS_OVERLAY_EDITOR) {
+        if (selected) *selected = s_ui.selected;
+        if (s_action_read != s_action_write) {
+            unsigned index = s_action_read++ % 32;
+            action = s_actions[index].buttons;
+            if (selected) *selected = s_actions[index].selected;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return action;
+}
