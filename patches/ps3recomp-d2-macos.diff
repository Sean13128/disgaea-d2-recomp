+/* Native PRXs must be lifted ahead of time. Return a real id only when that
+ * module is already resident; do not claim to have loaded uncompiled code. */
+static void hle_prx_load_path(ppu_context* ctx)
+{
+    uint32_t ea = (uint32_t)ctx->gpr[3];
+    if (!fs_guest_range(ea, 1)) { ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x8001000d; return; }
+    const char* path = (const char*)(vm_base + ea);
+    uint32_t id = prx_loaded_module_id(path);
+    if (id) { ctx->gpr[3] = id; return; }
+    char host[1200]; host_path(host, sizeof host, path);
+    FILE* f = fopen(host, "rb");
+    if (f) fclose(f);
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)(f ? 0x80011148 : 0x80010006);
+}
+static void hle_prx_load_fd(ppu_context* ctx)
+{
+    int fd = (int)(uint32_t)ctx->gpr[3];
+    if (fd < 3 || fd >= FS_MAX || !g_files[fd]) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x8001002a; return;
+    }
+    uint32_t id = ctx->gpr[4] ? 0 : prx_loaded_module_id(g_fd_path[fd]);
+    ctx->gpr[3] = id ? id : (uint64_t)(int64_t)(int32_t)0x80011148;
+}
