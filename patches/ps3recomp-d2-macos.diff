diff --git a/libs/audio/cellAudio_host.h b/libs/audio/cellAudio_host.h
new file mode 100644
index 0000000..ec0ddf1
--- /dev/null
+++ b/libs/audio/cellAudio_host.h
@@ -0,0 +1,20 @@
+/* Host output gain, independent of the guest's port levels and ring clock. */
+#ifndef PS3RECOMP_CELL_AUDIO_HOST_H
+#define PS3RECOMP_CELL_AUDIO_HOST_H
+#include <math.h>
+static inline float cellAudioHostSample(float sample, float gain)
+{
+    if (!isfinite(sample)) return 0.0f;
+    if (sample > 1.0f) sample = 1.0f;
+    if (sample < -1.0f) sample = -1.0f;
+    return sample * gain;
+}
+#ifdef __cplusplus
+extern "C" {
+#endif
+void cellAudioHostSetGain(float gain, int muted);
+float cellAudioHostGetGain(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/codec/avc_decoder.cpp b/libs/codec/avc_decoder.cpp
new file mode 100644
index 0000000..94091c3
--- /dev/null
+++ b/libs/codec/avc_decoder.cpp
@@ -0,0 +1,192 @@
+#include "avc_decoder.h"
+#include "avc_packet.h"
+#include <cstdlib>
+#include <cstring>
+#ifdef __APPLE__
+#include <VideoToolbox/VideoToolbox.h>
+#include <deque>
+#include <vector>
+#include <mutex>
+#include <atomic>
+#include <cstdio>
+#include <algorithm>
+struct AvcDecoder {
+    VTDecompressionSessionRef session = nullptr;
+    CMVideoFormatDescriptionRef format = nullptr;
+    std::vector<uint8_t> sps, pps;
+    std::mutex mutex;
+    std::deque<AvcFrame> frames;
+    std::atomic<int> error{0};
+    AvcSpsInfo info{};
+    AvcClock clock;
+    uint64_t au_count = 0;
+    bool waiting_idr = false, format_dirty = false;
+    unsigned recoveries = 0, skipped = 0, format_changes = 0;
+    bool draining = false;
+};
+struct FrameTag { uint64_t pts, dts, user; AvcSpsInfo info; };
+static void output(void* arg, void* ref, OSStatus status, VTDecodeInfoFlags flags,
+                    CVImageBufferRef image, CMTime, CMTime)
+{
+    auto* d = static_cast<AvcDecoder*>(arg);
+    auto* tag = static_cast<FrameTag*>(ref);
+    std::lock_guard<std::mutex> lock(d->mutex);
+    if (status || !image) {
+        if (status || !(flags & kVTDecodeInfo_FrameDropped)) d->error = status ? status : -1;
+        delete tag; return;
+    }
+    CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    unsigned w = (unsigned)CVPixelBufferGetWidth(image), h = (unsigned)CVPixelBufferGetHeight(image);
+    AvcFrame f{w, h, tag->info.frame_rate_code, tag->info.full_range, tag->info.matrix,
+               tag->pts, tag->dts, tag->user, nullptr};
+    f.yuv = static_cast<uint8_t*>(std::malloc((size_t)w * h * 3 / 2));
+    if (f.yuv && !(w & 1) && !(h & 1) && CVPixelBufferGetPlaneCount(image) == 2) {
+        const auto* y = static_cast<const uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(image, 0));
+        const auto* uv = static_cast<const uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(image, 1));
+        size_t ys = CVPixelBufferGetBytesPerRowOfPlane(image, 0), cs = CVPixelBufferGetBytesPerRowOfPlane(image, 1);
+        for (unsigned row = 0; row < h; row++) std::memcpy(f.yuv + row * w, y + row * ys, w);
+        uint8_t* u = f.yuv + w * h; uint8_t* v = u + w * h / 4;
+        for (unsigned row = 0; row < h / 2; row++) for (unsigned x = 0; x < w / 2; x++) {
+            u[row * (w / 2) + x] = uv[row * cs + x * 2];
+            v[row * (w / 2) + x] = uv[row * cs + x * 2 + 1];
+        }
+        auto at = std::upper_bound(d->frames.begin(), d->frames.end(), f.pts,
+            [](uint64_t pts, const AvcFrame& frame) { return pts < frame.pts; });
+        d->frames.insert(at, f);
+    } else { std::free(f.yuv); d->error = -1; }
+    CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    delete tag;
+}
+static int make_session(AvcDecoder* d)
+{
+    OSStatus status;
+    int pixel = d->info.full_range ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    CFNumberRef number = CFNumberCreate(nullptr, kCFNumberIntType, &pixel);
+    const void* keys[] = {kCVPixelBufferPixelFormatTypeKey}; const void* values[] = {number};
+    CFDictionaryRef attrs = CFDictionaryCreate(nullptr, keys, values, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    VTDecompressionOutputCallbackRecord cb{output, d};
+    /* Allow Apple's software decoder too; no Metal device/window is needed. */
+    status = VTDecompressionSessionCreate(nullptr, d->format, nullptr, attrs, &cb, &d->session);
+    CFRelease(attrs); CFRelease(number);
+    if (status) {
+        std::fprintf(stderr, "[avc] VideoToolbox session error=%d\n", (int)status);
+        CFRelease(d->format); d->format = nullptr;
+    }
+    return status;
+}
+extern "C" AvcDecoder* avc_decoder_create(void) { return new AvcDecoder; }
+extern "C" int avc_decoder_flush(AvcDecoder* d)
+{
+    if (!d || !d->session) return 0;
+    OSStatus s = VTDecompressionSessionWaitForAsynchronousFrames(d->session);
+    { std::lock_guard<std::mutex> lock(d->mutex); d->draining = true; }
+    int error = s ? (int)s : d->error.exchange(0);
+    return error;
+}
+static void close_session(AvcDecoder* d)
+{
+    if (d->session) {
+        avc_decoder_flush(d); VTDecompressionSessionInvalidate(d->session);
+        CFRelease(d->session); d->session = nullptr;
+    }
+    d->error = 0;
+}
+extern "C" void avc_decoder_destroy(AvcDecoder* d)
+{
+    if (!d) return;
+    avc_decoder_flush(d);
+    if (d->session) { VTDecompressionSessionInvalidate(d->session); CFRelease(d->session); }
+    if (d->format) CFRelease(d->format);
+    if (d->au_count) std::fprintf(stderr, "[avc] AUs=%llu format_changes=%u recoveries=%u skipped=%u\n",
+        (unsigned long long)d->au_count, d->format_changes, d->recoveries, d->skipped);
+    for (auto& f : d->frames) std::free(f.yuv);
+    delete d;
+}
+extern "C" int avc_decoder_feed(AvcDecoder* d, const uint8_t* p, size_t n,
+                                 uint64_t pts, uint64_t dts, uint64_t user)
+{
+    if (!d || !p || !n) return -1;
+    FILE* trace = std::getenv("PS3RECOMP_AVC_TRACE") ? stderr : nullptr;
+    if (trace) std::fprintf(trace, "[avc] AU=%llu size=%zu pts=%llu dts=%llu NALs:",
+        (unsigned long long)++d->au_count, n, (unsigned long long)pts, (unsigned long long)dts);
+    else d->au_count++;
+    AvcPacket packet;
+    if (avc_packet(p, n, d->sps, d->pps, d->info, packet, trace)) {
+        std::fprintf(stderr, "[avc] malformed AU=%llu size=%zu; recover at next IDR\n", (unsigned long long)d->au_count, n);
+        close_session(d); d->waiting_idr = true; d->recoveries++; return 0;
+    }
+    d->format_dirty |= packet.changed;
+    if (!packet.picture) return 0;
+    /* PES timestamps are sparse. Supply VT a complete presentation/decode
+     * timeline; pic_timing SEI gives B-picture display delay in SPS ticks. */
+    d->clock.stamp(d->info, packet, pts, dts);
+    if (trace) std::fprintf(trace, "[avc] sample AU=%llu avcc=%zu pts=%llu dts=%llu\n",
+        (unsigned long long)d->au_count, packet.bytes.size(), (unsigned long long)pts, (unsigned long long)dts);
+    int previous = d->error.exchange(0);
+    if (previous == kVTVideoDecoderBadDataErr) {
+        std::fprintf(stderr, "[avc] bad data before AU=%llu; recover at next IDR\n", (unsigned long long)d->au_count);
+        close_session(d); d->waiting_idr = true; d->recoveries++;
+    } else if (previous) return previous;
+    if (d->format_dirty || !d->format) {
+        const uint8_t* sets[] = {d->sps.data(), d->pps.data()};
+        const size_t sizes[] = {d->sps.size(), d->pps.size()};
+        CMVideoFormatDescriptionRef format = nullptr;
+        OSStatus status = CMVideoFormatDescriptionCreateFromH264ParameterSets(nullptr, 2, sets, sizes, 4, &format);
+        if (status) return status;
+        bool compatible = !d->session || VTDecompressionSessionCanAcceptFormatDescription(d->session, format);
+        if (d->session && !compatible) {
+            close_session(d); d->waiting_idr = !packet.idr;
+        }
+        if (trace) std::fprintf(trace, "[avc] format change AU=%llu compatible=%u idr=%u\n",
+            (unsigned long long)d->au_count, compatible, packet.idr);
+        if (d->format) CFRelease(d->format);
+        d->format = format; d->format_dirty = false; d->format_changes++;
+        /* PPS changes (QP/weighted prediction) must NOT discard references.
+         * Keep both the updated format and the in-band SPS/PPS in the sample. */
+    }
+    if (d->waiting_idr && !packet.idr) { d->skipped++; return 0; }
+    d->waiting_idr = false;
+    if (!d->session) { int status = make_session(d); if (status) return status; }
+    { std::lock_guard<std::mutex> lock(d->mutex); d->draining = false; }
+    auto& avcc = packet.bytes;
+    CMBlockBufferRef block = nullptr;
+    OSStatus s = CMBlockBufferCreateWithMemoryBlock(nullptr, nullptr, avcc.size(), nullptr, nullptr, 0, avcc.size(), 0, &block);
+    if (s) return s;
+    s = CMBlockBufferReplaceDataBytes(avcc.data(), block, 0, avcc.size());
+    CMSampleBufferRef sample = nullptr;
+    CMSampleTimingInfo timing{CMTimeMake(2 * d->info.units, d->info.scale), CMTimeMake((int64_t)pts, 90000),
+                              CMTimeMake((int64_t)dts, 90000)};
+    size_t bytes = avcc.size();
+    if (!s) s = CMSampleBufferCreateReady(nullptr, block, d->format, 1, 1, &timing, 1, &bytes, &sample);
+    if (!s) {
+        auto* tag = new FrameTag{pts, dts, user, d->info};
+        /* With both VT flags clear the callback completes before return.
+         * TemporalProcessing permits indefinite delay and does not guarantee
+         * display order. Reorder the synchronous output ourselves using VUI. */
+        s = VTDecompressionSessionDecodeFrame(d->session, sample, 0, tag, nullptr);
+        if (s) delete tag;
+    }
+    if (sample) CFRelease(sample); CFRelease(block);
+    int error = s ? (int)s : d->error.exchange(0);
+    if (error == kVTVideoDecoderBadDataErr) {
+        std::fprintf(stderr, "[avc] bad data AU=%llu size=%zu; recover at next IDR\n", (unsigned long long)d->au_count, n);
+        close_session(d); d->waiting_idr = true; d->recoveries++; return 0;
+    }
+    return error;
+}
+extern "C" int avc_decoder_take(AvcDecoder* d, AvcFrame* f)
+{
+    if (!d || !f) return 0;
+    std::lock_guard<std::mutex> lock(d->mutex);
+    if (d->frames.empty() || (!d->draining && d->frames.size() <= d->info.max_reorder)) return 0;
+    *f = d->frames.front(); d->frames.pop_front(); return 1;
+}
+#else
+struct AvcDecoder {};
+extern "C" AvcDecoder* avc_decoder_create(void) { return new AvcDecoder; }
+extern "C" void avc_decoder_destroy(AvcDecoder* d) { delete d; }
+extern "C" int avc_decoder_feed(AvcDecoder*, const uint8_t*, size_t, uint64_t, uint64_t, uint64_t) { return -1; }
+extern "C" int avc_decoder_flush(AvcDecoder*) { return 0; }
+extern "C" int avc_decoder_take(AvcDecoder*, AvcFrame*) { return 0; }
+#endif
+extern "C" void avc_frame_release(AvcFrame* f) { std::free(f->yuv); f->yuv = nullptr; }
