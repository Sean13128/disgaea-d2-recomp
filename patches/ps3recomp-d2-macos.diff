+            const s32 pos = slot_of(H)->pos, frame = slot_of(H)->next_frame;
+            assert(cellAtracDecode(H, OUT, ARGS, ARGS + 4, ARGS + 8) == rc);
+            assert(slot_of(H)->pos == pos && slot_of(H)->next_frame == frame);
+            refill();
+            continue;
+        }
         assert(rc == CELL_OK);
         const u32 got = rd32(ARGS);
         assert(got <= 2048);
@@ -131,7 +156,82 @@ int main(int argc, char** argv)
         }
         fclose(w);
     }
+    assert(cellAtracDeleteDecoder(H) == CELL_OK);
+    u8* source = malloc(bytes);
+    memcpy(source, vm_base + FILE_EA, bytes);
+    stream_source = source;
+    stream_bytes = bytes;
+    const u32 initial = bytes < 102400 ? bytes : 102400;
+    memset(vm_base + FILE_EA, 0xA5, bytes);
+    memcpy(vm_base + FILE_EA, source, initial);
+    assert(cellAtracSetDataAndGetMemSize(H, FILE_EA, initial, 102400, ARGS) == CELL_OK);
+    assert(cellAtracCreateDecoder(H, WORK, 0, 0) == CELL_OK);
+    assert(cellAtracIsSecondBufferNeeded(H) == 0);
+    assert(cellAtracAddStreamData(H, 102401) == (s32)(initial == bytes ?
+           CELL_ATRAC_ERROR_ALLDATA_IS_ONMEMORY : CELL_ATRAC_ERROR_ADD_DATA_IS_TOO_BIG));
+    u32 ns;
+    float* streamed = decode_all(ch, 0, &ns);
+    assert(ns == n1 && memcmp(once, streamed, n1 * ch * sizeof(float)) == 0);
+    assert(cellAtracGetInternalErrorInfo(H, ARGS) == CELL_OK && rd32(ARGS) == 0);
+    printf("stream: %u refills, %u samples, identical to full-memory PCM; underrun retry PASS\n",
+           stream_refills, ns);
+    free(streamed);
+
+    if (t.loop_start >= 0) {
+        assert(cellAtracGetBufferInfoForResetting(H, 0, ARGS + 24) == CELL_OK);
+        assert(rd32(ARGS + 32) == 0); /* cached reset needs no file read */
+        assert(cellAtracResetPlayPosition(H, 0, 0) == CELL_OK);
+        const u32 old_refills = stream_refills;
+        streamed = decode_all(ch, 1, &ns);
+        const u32 lap = (u32)(t.loop_end - t.loop_start), head = (u32)(t.loop_start - t.first);
