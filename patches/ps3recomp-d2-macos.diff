diff --git a/libs/codec/pamf_demux.c b/libs/codec/pamf_demux.c
new file mode 100644
index 0000000..5ecaafa
--- /dev/null
+++ b/libs/codec/pamf_demux.c
@@ -0,0 +1,165 @@
+/* PAMF uses MPEG-PS packs, not transport packets. PES headers, private-stream
+ * routing and elementary AU assembly persist across arbitrary input chunks. */
+#include "pamf_demux.h"
+#include <stdlib.h>
+#include <string.h>
+#define INVALID_TS UINT64_MAX
+#define MAX_PENDING (8u * 1024u * 1024u)
+typedef struct {
+    uint8_t* bytes;
+    size_t size, capacity;
+    uint64_t pts, dts, user, pending_pts, pending_dts;
+    size_t stamp;
+} Buffer;
+struct PamfDemux {
+    Buffer ps, video[16], audio[16];
+    PamfAuCallback callback;
+    void* arg;
+    uint64_t consumed;
+};
+static int append(Buffer* b, const uint8_t* p, size_t n)
+{
+    if (n > MAX_PENDING - b->size) return -1;
+    if (b->size + n > b->capacity) {
+        size_t cap = b->size + n + 4096;
+        void* v = realloc(b->bytes, cap);
+        if (!v) return -1;
+        b->bytes = v; b->capacity = cap;
+    }
+    memcpy(b->bytes + b->size, p, n); b->size += n;
+    return 0;
+}
+static void consume(Buffer* b, size_t n)
+{
+    b->size -= n; memmove(b->bytes, b->bytes + n, b->size);
+}
+static uint64_t timestamp(const uint8_t* p)
+{
+    return ((uint64_t)(p[0] & 14) << 29) | ((uint64_t)p[1] << 22) |
+        ((uint64_t)(p[2] & 254) << 14) | ((uint64_t)p[3] << 7) | (p[4] >> 1);
+}
+PamfDemux* pamf_demux_create(PamfAuCallback cb, void* arg)
+{
+    PamfDemux* d = calloc(1, sizeof(*d));
+    if (d) { d->callback = cb; d->arg = arg; pamf_demux_reset(d); }
+    return d;
+}
+void pamf_demux_reset(PamfDemux* d)
+{
+    d->ps.size = 0; d->consumed = 0;
+    for (int i = 0; i < 16; i++) {
+        d->video[i].size = d->audio[i].size = 0;
+        d->video[i].pts = d->video[i].dts = d->audio[i].pts = INVALID_TS;
+        d->video[i].pending_pts = INVALID_TS; d->video[i].stamp = SIZE_MAX;
+    }
+}
+void pamf_demux_destroy(PamfDemux* d)
+{
+    if (!d) return;
+    free(d->ps.bytes);
+    for (int i = 0; i < 16; i++) { free(d->video[i].bytes); free(d->audio[i].bytes); }
+    free(d);
+}
+int pamf_demux_flush(PamfDemux* d, unsigned major, unsigned minor)
+{
+    if (major < 0xe0 || major > 0xef) return 0;
+    Buffer* b = &d->video[major & 15];
+    if (b->size && d->callback(d->arg, major, minor, b->bytes, b->size,
+                              b->pts, b->dts, b->user)) return -1;
+    b->size = 0; return 0;
+}
+static int pes(PamfDemux* d, const uint8_t* p, size_t n, uint64_t user)
+{
+    unsigned id = p[3];
+    if (!(id == 0xbd || (id >= 0xe0 && id <= 0xef))) return 0;
+    if (n < 9 || (p[6] & 0xc0) != 0x80 || 9u + p[8] > n) return -1;
+    uint64_t pts = INVALID_TS, dts = INVALID_TS;
+    if (p[7] & 0x80) {
+        if (p[8] < 5) return -1;
+        pts = timestamp(p + 9); dts = pts;
+        if (p[7] & 0x40) { if (p[8] < 10) return -1; dts = timestamp(p + 14); }
+    }
+    size_t off = 9u + p[8];
+    if (id >= 0xe0) {
+        Buffer* b = &d->video[id & 15];
+        /* A timestamped PES can contain MANY AVC pictures, and can begin
+         * with the tail of the previous one. AUD NALs delimit actual AUs.
+         * The PES timestamp belongs to the first AU beginning in that PES. */
+        if (pts != INVALID_TS) {
+            b->pending_pts = pts; b->pending_dts = dts; b->stamp = b->size;
+        }
+        if (!b->size) b->user = user;
+        if (append(b, p + off, n - off)) return -1;
+        if (!b->stamp) { b->pts = b->pending_pts; b->dts = b->pending_dts; b->stamp = SIZE_MAX; }
+        for (;;) {
+            size_t next = b->size;
+            for (size_t i = 4; i + 3 < b->size; i++) {
+                if (!b->bytes[i] && !b->bytes[i + 1] && b->bytes[i + 2] == 1 && (b->bytes[i + 3] & 31) == 9) {
+                    next = i && !b->bytes[i - 1] ? i - 1 : i; break;
+                }
+            }
+            if (next == b->size) break;
+            if (d->callback(d->arg, id, 0, b->bytes, next, b->pts, b->dts, b->user)) return -1;
+            consume(b, next); b->pts = b->dts = INVALID_TS; b->user = user;
+            if (b->stamp != SIZE_MAX) {
+                if (b->stamp <= next) { b->pts = b->pending_pts; b->dts = b->pending_dts; b->stamp = SIZE_MAX; }
+                else b->stamp -= next;
+            }
+        }
+        return 0;
+    }
+    if (n - off < 4) return -1;
+    unsigned channel = p[off]; off += 4; /* private-stream id + frame offset */
+    if (channel > 15) return 0; /* AC3/LPCM are separate private substreams */
+    Buffer* b = &d->audio[channel];
+    if (!b->size) { b->user = user; if (pts != INVALID_TS) b->pts = pts; }
+    if (append(b, p + off, n - off)) return -1;
+    while (b->size >= 8) {
+        if (b->bytes[0] != 0x0f || b->bytes[1] != 0xd0) return -1;
+        size_t frame = ((((unsigned)b->bytes[2] & 3) << 8) | b->bytes[3]) + 1;
+        frame *= 8;
+        if (b->size < frame + 8) break;
+        /* Keep the ATS header: cellAdec may request header-inclusive AUs. */
+        if (d->callback(d->arg, 0xbd, channel, b->bytes, frame + 8,
+                        b->pts, INVALID_TS, b->user)) return -1;
+        consume(b, frame + 8); b->user = user;
+        if (b->pts != INVALID_TS) b->pts += 3840; /* 2048 samples @ 48 kHz */
+    }
+    return 0;
+}
+uint64_t pamf_demux_consumed(const PamfDemux* d) { return d->consumed; }
+int pamf_demux_feed(PamfDemux* d, const uint8_t* data, size_t size, uint64_t user)
+{
+    if (!d || (!data && size)) return -1;
+    uint64_t base = d->consumed;
+    size_t previous_size = d->ps.size;
+    uint64_t previous_user = d->ps.user;
+    if (!previous_size) d->ps.user = user;
+    if (append(&d->ps, data, size)) return -1;
+    Buffer* b = &d->ps;
+    size_t off = 0;
+    while (off + 4 <= b->size) {
+        const uint8_t* p = b->bytes + off;
+        if (p[0] || p[1] || p[2] != 1) { off++; d->consumed = base + off; continue; }
+        unsigned id = p[3];
+        size_t n;
+        if (id == 0xba) {
+            if (off + 14 > b->size) break;
+            if ((p[4] & 0xc0) != 0x40) return -1;
+            n = 14 + (p[13] & 7);
+        } else if (id == 0xb9) {
+            for (unsigned i = 0; i < 16; i++) if (pamf_demux_flush(d, 0xe0 + i, 0)) return -1;
+            if (d->callback(d->arg, 0xb9, 0, NULL, 0, INVALID_TS, INVALID_TS, user)) return -1;
+            n = 4;
+        } else {
+            if (off + 6 > b->size) break;
+            n = 6 + ((unsigned)p[4] << 8) + p[5];
+            if (n == 6) return -1; /* unbounded PES is not used by PAMF */
+        }
+        if (off + n > b->size) break;
+        if (id != 0xba && id != 0xb9 && pes(d, p, n, off < previous_size ? previous_user : user)) return -1;
+        off += n; d->consumed = base + off;
+    }
+    if (off) { consume(b, off); if (off >= previous_size) b->user = user; }
+    return 0;
+}
diff --git a/libs/codec/pamf_demux.h b/libs/codec/pamf_demux.h
new file mode 100644
index 0000000..90bb9f4
--- /dev/null
+++ b/libs/codec/pamf_demux.h
@@ -0,0 +1,22 @@
+/* Streaming MPEG-2 program-stream/PAMF parser. No guest or platform state. */
+#ifndef PS3RECOMP_PAMF_DEMUX_H
+#define PS3RECOMP_PAMF_DEMUX_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct PamfDemux PamfDemux;
+typedef int (*PamfAuCallback)(void* arg, unsigned major, unsigned minor,
+    const uint8_t* data, size_t size, uint64_t pts, uint64_t dts, uint64_t user);
+PamfDemux* pamf_demux_create(PamfAuCallback callback, void* arg);
+void pamf_demux_destroy(PamfDemux* demux);
+/* Read only on the parser worker; excludes the unfinished PS packet. */
+uint64_t pamf_demux_consumed(const PamfDemux* demux);
+void pamf_demux_reset(PamfDemux* demux);
+int pamf_demux_feed(PamfDemux* demux, const uint8_t* data, size_t size, uint64_t user);
+int pamf_demux_flush(PamfDemux* demux, unsigned major, unsigned minor);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/codec/tests/test_avc_packets.cpp b/libs/codec/tests/test_avc_packets.cpp
new file mode 100644
index 0000000..626d1eb
--- /dev/null
+++ b/libs/codec/tests/test_avc_packets.cpp
@@ -0,0 +1,119 @@
+/* FFmpeg is a TEST dependency only. Decode the exact AVCC buffers submitted
+ * to VT, with strict error recognition. Exercise the real streaming demux. */
+#include "../avc_packet.h"
+#include "../pamf_demux.h"
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/mem.h>
+}
+struct Check {
+    std::vector<uint8_t> sps, pps;
+    AvcSpsInfo info{};
+    AvcClock clock;
+    int64_t last_pts = AV_NOPTS_VALUE;
+    bool truncate = false;
+    AVCodecContext* decoder = nullptr;
+    AVFrame* frame = av_frame_alloc();
+    FILE *es, *trace, *sizes;
+    std::string directory;
+    unsigned aus = 0, frames = 0, changes = 0, non_idr_changes = 0, errors = 0;
+};
+static int receive(Check* c)
+{
+    int status;
+    while ((status = avcodec_receive_frame(c->decoder, c->frame)) >= 0) {
+        if (c->frame->width != 1280 || c->frame->height != 720 || c->frame->decode_error_flags ||
+            (c->last_pts != AV_NOPTS_VALUE && c->frame->pts <= c->last_pts)) {
+            fprintf(stderr, "[K2-check] invalid/corrupt frame or backwards PTS at AU=%u\n", c->aus);
+            c->errors++; av_frame_unref(c->frame); return -1;
+        }
+        c->last_pts = c->frame->pts;
+        c->frames++; av_frame_unref(c->frame);
+    }
+    if (status != AVERROR(EAGAIN) && status != AVERROR_EOF) { c->errors++; return -1; }
+    return 0;
+}
+static int au(void* arg, unsigned major, unsigned, const uint8_t* p, size_t n, uint64_t pts, uint64_t dts, uint64_t)
+{
+    auto* c = static_cast<Check*>(arg);
+    if (major != 0xe0) return 0;
+    c->aus++;
+    if (c->truncate && c->aus == 33) { assert(n > 4795); n = 4795; }
+    assert(fwrite(p, 1, n, c->es) == n);
+    fprintf(c->sizes, "%zu\n", n);
+    fprintf(c->trace, "[K2-check] AU=%u size=%zu NALs:", c->aus, n);
+    AvcPacket packet;
+    if (avc_packet(p, n, c->sps, c->pps, c->info, packet, c->trace) || !packet.picture) return -1;
+    assert(c->info.frame_only == 1 && c->info.max_reorder == 1 && (c->truncate || packet.slices == 4) && packet.timed);
+    if (packet.changed) {
+        c->changes++; c->non_idr_changes += !packet.idr;
+        fprintf(c->trace, "[K2-check] parameter change AU=%u idr=%u SPS=", c->aus, packet.idr);
+        for (uint8_t b : c->sps) fprintf(c->trace, "%02x", b);
+        fprintf(c->trace, " PPS="); for (uint8_t b : c->pps) fprintf(c->trace, "%02x", b);
+        fprintf(c->trace, "\n");
+    }
+    if (!c->decoder) {
+        c->decoder = avcodec_alloc_context3(avcodec_find_decoder(AV_CODEC_ID_H264)); assert(c->decoder);
+        c->decoder->err_recognition = AV_EF_CRCCHECK | AV_EF_BITSTREAM | AV_EF_BUFFER | AV_EF_EXPLODE | AV_EF_CAREFUL;
+        c->decoder->thread_count = 1;
+        /* avcC: same two sets and 4-byte lengths as the CM format description. */
+        std::vector<uint8_t> extra{1, c->sps[1], c->sps[2], c->sps[3], 255, 225};
+        extra.push_back(c->sps.size() >> 8); extra.push_back(c->sps.size());
+        extra.insert(extra.end(), c->sps.begin(), c->sps.end()); extra.push_back(1);
+        extra.push_back(c->pps.size() >> 8); extra.push_back(c->pps.size()); extra.insert(extra.end(), c->pps.begin(), c->pps.end());
+        c->decoder->extradata = static_cast<uint8_t*>(av_mallocz(extra.size() + AV_INPUT_BUFFER_PADDING_SIZE));
+        memcpy(c->decoder->extradata, extra.data(), extra.size()); c->decoder->extradata_size = (int)extra.size();
+        assert(avcodec_open2(c->decoder, c->decoder->codec, nullptr) == 0);
+    }
+    /* Assert the AVCC lengths and EBSP round trip, without unescaping bytes. */
+    size_t off = 0;
+    while (off < packet.bytes.size()) {
+        assert(off + 4 <= packet.bytes.size());
+        uint32_t len = ((uint32_t)packet.bytes[off] << 24) | (packet.bytes[off+1] << 16) |
+            (packet.bytes[off+2] << 8) | packet.bytes[off+3]; off += 4;
+        assert(len && len <= packet.bytes.size() - off); off += len;
+    }
+    if (c->aus == 21 || c->aus == 32 || c->aus == 33 || c->aus == 34) {
+        std::string name = c->directory + "/AU-" + std::to_string(c->aus) + ".avcc";
+        FILE* f = fopen(name.c_str(), "wb"); assert(f);
+        assert(fwrite(packet.bytes.data(), 1, packet.bytes.size(), f) == packet.bytes.size()); fclose(f);
+    }
+    AVPacket* sample = av_packet_alloc(); assert(sample);
+    assert(av_new_packet(sample, (int)packet.bytes.size()) == 0);
+    memcpy(sample->data, packet.bytes.data(), packet.bytes.size());
+    c->clock.stamp(c->info, packet, pts, dts);
+    sample->pts = (int64_t)pts; sample->dts = (int64_t)dts;
+    int status = avcodec_send_packet(c->decoder, sample); av_packet_free(&sample);
+    if (status < 0 || receive(c)) {
+        fprintf(stderr, "[K2-check] strict decode failure AU=%u status=%d\n", c->aus, status); c->errors++; return -1;
+    }
+    return 0;
+}
+int main(int argc, char** argv)
+{
+    assert(argc == 3 || argc == 4); Check c; c.directory = argv[2];
+    c.truncate = argc == 4 && !strcmp(argv[3], "--truncate");
+    c.es = fopen((c.directory + "/movie.h264").c_str(), "wb"); assert(c.es);
+    c.trace = fopen((c.directory + "/nal.log").c_str(), "w"); assert(c.trace);
+    c.sizes = fopen((c.directory + "/au-sizes.txt").c_str(), "w"); assert(c.sizes);
+    PamfDemux* d = pamf_demux_create(au, &c); assert(d);
+    FILE* f = fopen(argv[1], "rb"); assert(f); assert(fseek(f, 2048, SEEK_SET) == 0);
+    uint8_t input[65521]; size_t n;
+    while ((n = fread(input, 1, sizeof(input), f))) if (pamf_demux_feed(d, input, n, 0)) { c.errors++; break; }
+    if (!c.errors && pamf_demux_flush(d, 0xe0, 0)) c.errors++;
+    if (c.decoder) { assert(avcodec_send_packet(c.decoder, nullptr) == 0); receive(&c); }
+    fclose(f); fclose(c.es); fclose(c.trace); fclose(c.sizes); pamf_demux_destroy(d);
+    av_frame_free(&c.frame); avcodec_free_context(&c.decoder);
+    printf("[K2-check] AUs=%u strict_AVCC_frames=%u changes=%u non_IDR_changes=%u errors=%u\n",
+        c.aus, c.frames, c.changes, c.non_idr_changes, c.errors);
+    if (c.truncate) {
+        bool ok = c.aus == 33 && c.errors;
+        printf("[K2-check] truncated AU 33 (4795 bytes) rejected: %s\n", ok ? "PASS" : "FAIL");
+        return ok ? 0 : 1;
+    }
+    return c.aus == 2793 && c.frames == 2793 && !c.errors ? 0 : 1;
+}
diff --git a/libs/codec/tests/test_avc_session.cpp b/libs/codec/tests/test_avc_session.cpp
new file mode 100644
index 0000000..309cff3
--- /dev/null
+++ b/libs/codec/tests/test_avc_session.cpp
@@ -0,0 +1,81 @@
+/* VT session-control regression: real CoreMedia samples/parameter sets,
+ * mocked VT responses so compatible PPS changes/recovery run in the sandbox.
+ * This does not claim to test Apple's decoder. */
+#include "../avc_decoder.h"
+#include "../pamf_demux.h"
+#include <VideoToolbox/VideoToolbox.h>
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+static VTDecompressionOutputCallbackRecord callback;
+static unsigned created, invalidated, submitted, input, fault, pictures;
+static bool compatible, callback_error;
+static CVPixelBufferRef image;
+static void* delayed_error;
+extern "C" OSStatus VTDecompressionSessionCreate(CFAllocatorRef, CMVideoFormatDescriptionRef,
+    CFDictionaryRef, CFDictionaryRef, const VTDecompressionOutputCallbackRecord* cb, VTDecompressionSessionRef* out)
+{
+    callback = *cb; created++;
+    /* A CF object for the runtime's normal release/invalidation ownership. */
+    *out = reinterpret_cast<VTDecompressionSessionRef>(CFDictionaryCreateMutable(nullptr, 0, nullptr, nullptr));
+    return 0;
+}
+extern "C" Boolean VTDecompressionSessionCanAcceptFormatDescription(VTDecompressionSessionRef, CMFormatDescriptionRef)
+{ return compatible; }
+extern "C" void VTDecompressionSessionInvalidate(VTDecompressionSessionRef) { invalidated++; }
+extern "C" OSStatus VTDecompressionSessionFinishDelayedFrames(VTDecompressionSessionRef) { return 0; }
+extern "C" OSStatus VTDecompressionSessionWaitForAsynchronousFrames(VTDecompressionSessionRef) { return 0; }
+extern "C" OSStatus VTDecompressionSessionDecodeFrame(VTDecompressionSessionRef, CMSampleBufferRef sample,
+    VTDecodeFrameFlags flags, void* ref, VTDecodeInfoFlags*)
+{
+    submitted++;
+    assert(flags == 0);
+    CMSampleTimingInfo timing; assert(CMSampleBufferGetSampleTimingInfo(sample, 0, &timing) == 0);
+    assert(CMTIME_IS_VALID(timing.presentationTimeStamp) && CMTIME_IS_VALID(timing.decodeTimeStamp));
+    if (input == fault) {
+        if (!callback_error) return kVTVideoDecoderBadDataErr;
+        delayed_error = ref; /* deliver the failure between input AUs */
+    } else callback.decompressionOutputCallback(callback.decompressionOutputRefCon, ref, 0, 0, image,
+        timing.presentationTimeStamp, timing.duration);
+    return 0;
+}
+static int au(void* arg, unsigned major, unsigned, const uint8_t* bytes, size_t size, uint64_t pts, uint64_t dts, uint64_t user)
+{
+    if (major != 0xe0) return 0;
+    if (++input > 35) return 1;
+    auto* d = static_cast<AvcDecoder*>(arg);
+    if (delayed_error) {
+        callback.decompressionOutputCallback(callback.decompressionOutputRefCon, delayed_error, kVTVideoDecoderBadDataErr,
+            0, nullptr, kCMTimeInvalid, kCMTimeInvalid);
+        delayed_error = nullptr;
+    }
+    assert(avc_decoder_feed(d, bytes, size, pts, dts, user) == 0);
+    AvcFrame f;
+    while (avc_decoder_take(d, &f)) { pictures++; avc_frame_release(&f); }
+    return 0;
+}
+static void run(const char* movie, unsigned fail, bool async_error, bool accepts, unsigned expected, unsigned sessions)
+{
+    created = invalidated = submitted = input = pictures = 0; delayed_error = nullptr; fault = fail; callback_error = async_error; compatible = accepts;
+    AvcDecoder* decoder = avc_decoder_create(); PamfDemux* dmux = pamf_demux_create(au, decoder);
+    FILE* f = fopen(movie, "rb"); assert(f); assert(fseek(f, 2048, SEEK_SET) == 0);
+    uint8_t bytes[65521]; size_t size;
+    while (input <= 35 && (size = fread(bytes, 1, sizeof(bytes), f))) if (pamf_demux_feed(dmux, bytes, size, 0)) break;
+    fclose(f); pamf_demux_destroy(dmux); assert(avc_decoder_flush(decoder) == 0);
+    AvcFrame frame;
+    while (avc_decoder_take(decoder, &frame)) { pictures++; avc_frame_release(&frame); }
+    avc_decoder_destroy(decoder);
+    assert(pictures == expected && created == sessions && invalidated == sessions);
+    printf("[K2-session] compatible=%u fail_AU=%u callback_error=%u pictures=%u sessions=%u PASS\n",
+        accepts, fail, async_error, pictures, created);
+}
+int main(int argc, char** argv)
+{
+    assert(argc == 2);
+    assert(CVPixelBufferCreate(nullptr, 16, 16, kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange, nullptr, &image) == 0);
+    run(argv[1], 0, false, true, 35, 1);   /* PPS updates retain references */
+    run(argv[1], 32, false, true, 33, 2);  /* immediate bad data -> next IDR */
+    run(argv[1], 32, true, true, 33, 2);   /* callback bad data -> next IDR */
+    run(argv[1], 0, false, false, 22, 2);  /* incompatible update -> next IDR */
+    CFRelease(image); return 0;
+}
