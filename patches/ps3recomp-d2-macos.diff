+    atomic_flag_clear(&s_savedata_busy);
+    return rc;
+}
+
+s32 cellSaveDataDelete2(u32 container)
+{
+    if (atomic_flag_test_and_set(&s_savedata_busy)) return CELL_SAVEDATA_ERROR_BUSY;
+    s32 rc = impl_cellSaveDataDelete2(container);
+    atomic_flag_clear(&s_savedata_busy);
+    return rc;
+}
+
+s32 cellSaveDataDelete(u32 version, const char* dirName, u32 container)
+{
+    if (atomic_flag_test_and_set(&s_savedata_busy)) return CELL_SAVEDATA_ERROR_BUSY;
+    s32 rc = impl_cellSaveDataDelete(version, dirName, container);
+    atomic_flag_clear(&s_savedata_busy);
+    return rc;
+}
