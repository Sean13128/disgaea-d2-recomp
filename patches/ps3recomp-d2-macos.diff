+static void cellFsSdataOpenByFd(ppu_context* ctx)
+{
+    int fd = (int)(uint32_t)ctx->gpr[3];
+    uint32_t flags = (uint32_t)ctx->gpr[4], out = (uint32_t)ctx->gpr[5];
+    uint64_t offset = ctx->gpr[6];
+    int32_t err = (int32_t)0x8001000d; /* EFAULT */
+    if (!fs_guest_range(out, 4)) { ctx->gpr[3] = (uint64_t)(int64_t)err; return; }
+    vm_write32(out, UINT32_MAX);
+    err = (int32_t)0x8001002a; /* EBADF */
+    if (fd >= 3 && fd < FS_MAX && g_files[fd]) {
+        err = flags ? (int32_t)0x80010002 : (int32_t)0x80010038; /* EINVAL / EFSSPECIFIC */
+        if (!flags) {
+            FILE* f = g_files[fd];
+            HOST_FILE_LOCK(f);
+            auto old = HOST_FTELL64(f);
+#ifdef _WIN32
+            _fseeki64(f, 0, SEEK_END);
+#else
+            fseeko(f, 0, SEEK_END);
+#endif
+            auto end = HOST_FTELL64(f);
+            size_t len = end > 0 && offset < (uint64_t)end ? (size_t)((uint64_t)end - offset) : 0;
+            uint8_t* enc = len ? (uint8_t*)malloc(len) : nullptr;
+            size_t got = enc && offset <= INT64_MAX && !HOST_FSEEK64(f, offset)
+                       ? fread(enc, 1, len, f) : 0;
+            if (old >= 0) HOST_FSEEK64(f, old);
+            HOST_FILE_UNLOCK(f);
+            size_t plain_len = 0;
+            uint8_t* plain = enc && got == len ? sdata_decrypt(enc, len, &plain_len) : nullptr;
+            free(enc);
+            if (plain) {
+                FILE* view = tmpfile();
+                err = CELL_FS_EIO;
+                if (view && fwrite(plain, 1, plain_len, view) == plain_len) {
+                    rewind(view);
+                    int result = fd_alloc_file(view);
+                    if (result >= 0) {
+                        vm_write32(out, (uint32_t)result);
+                        snprintf(g_fd_path[result], sizeof g_fd_path[result], "%s", g_fd_path[fd]);
+                        err = CELL_OK; view = nullptr;
+                    } else err = (int32_t)0x8001002c; /* EMFILE */
+                }
+                if (view) fclose(view);
