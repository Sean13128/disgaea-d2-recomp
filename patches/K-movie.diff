diff --git a/libs/codec/pamf_demux.c b/libs/codec/pamf_demux.c
new file mode 100644
--- /dev/null
+++ b/libs/codec/pamf_demux.c
@@ -0,0 +1,162 @@
+/* PAMF uses MPEG-PS packs, not transport packets. PES headers, private-stream
+ * routing and elementary AU assembly persist across arbitrary input chunks. */
+#include "pamf_demux.h"
+#include <stdlib.h>
+#include <string.h>
+#define INVALID_TS UINT64_MAX
+#define MAX_PENDING (8u * 1024u * 1024u)
+typedef struct {
+    uint8_t* bytes;
+    size_t size, capacity;
+    uint64_t pts, dts, user, pending_pts, pending_dts;
+    size_t stamp;
+} Buffer;
+struct PamfDemux {
+    Buffer ps, video[16], audio[16];
+    PamfAuCallback callback;
+    void* arg;
+};
+static int append(Buffer* b, const uint8_t* p, size_t n)
+{
+    if (n > MAX_PENDING - b->size) return -1;
+    if (b->size + n > b->capacity) {
+        size_t cap = b->size + n + 4096;
+        void* v = realloc(b->bytes, cap);
+        if (!v) return -1;
+        b->bytes = v; b->capacity = cap;
+    }
+    memcpy(b->bytes + b->size, p, n); b->size += n;
+    return 0;
+}
+static void consume(Buffer* b, size_t n)
+{
+    b->size -= n; memmove(b->bytes, b->bytes + n, b->size);
+}
+static uint64_t timestamp(const uint8_t* p)
+{
+    return ((uint64_t)(p[0] & 14) << 29) | ((uint64_t)p[1] << 22) |
+        ((uint64_t)(p[2] & 254) << 14) | ((uint64_t)p[3] << 7) | (p[4] >> 1);
+}
+PamfDemux* pamf_demux_create(PamfAuCallback cb, void* arg)
+{
+    PamfDemux* d = calloc(1, sizeof(*d));
+    if (d) { d->callback = cb; d->arg = arg; pamf_demux_reset(d); }
+    return d;
+}
+void pamf_demux_reset(PamfDemux* d)
+{
+    d->ps.size = 0;
+    for (int i = 0; i < 16; i++) {
+        d->video[i].size = d->audio[i].size = 0;
+        d->video[i].pts = d->video[i].dts = d->audio[i].pts = INVALID_TS;
+        d->video[i].pending_pts = INVALID_TS; d->video[i].stamp = SIZE_MAX;
+    }
+}
+void pamf_demux_destroy(PamfDemux* d)
+{
+    if (!d) return;
+    free(d->ps.bytes);
+    for (int i = 0; i < 16; i++) { free(d->video[i].bytes); free(d->audio[i].bytes); }
+    free(d);
+}
+int pamf_demux_flush(PamfDemux* d, unsigned major, unsigned minor)
+{
+    if (major < 0xe0 || major > 0xef) return 0;
+    Buffer* b = &d->video[major & 15];
+    if (b->size && d->callback(d->arg, major, minor, b->bytes, b->size,
+                              b->pts, b->dts, b->user)) return -1;
+    b->size = 0; return 0;
+}
+static int pes(PamfDemux* d, const uint8_t* p, size_t n, uint64_t user)
+{
+    unsigned id = p[3];
+    if (!(id == 0xbd || (id >= 0xe0 && id <= 0xef))) return 0;
+    if (n < 9 || (p[6] & 0xc0) != 0x80 || 9u + p[8] > n) return -1;
+    uint64_t pts = INVALID_TS, dts = INVALID_TS;
+    if (p[7] & 0x80) {
+        if (p[8] < 5) return -1;
+        pts = timestamp(p + 9); dts = pts;
+        if (p[7] & 0x40) { if (p[8] < 10) return -1; dts = timestamp(p + 14); }
+    }
+    size_t off = 9u + p[8];
+    if (id >= 0xe0) {
+        Buffer* b = &d->video[id & 15];
+        /* A timestamped PES can contain MANY AVC pictures, and can begin
+         * with the tail of the previous one. AUD NALs delimit actual AUs.
+         * The PES timestamp belongs to the first AU beginning in that PES. */
+        if (pts != INVALID_TS) {
+            b->pending_pts = pts; b->pending_dts = dts; b->stamp = b->size;
+        }
+        if (!b->size) b->user = user;
+        if (append(b, p + off, n - off)) return -1;
+        if (!b->stamp) { b->pts = b->pending_pts; b->dts = b->pending_dts; b->stamp = SIZE_MAX; }
+        for (;;) {
+            size_t next = b->size;
+            for (size_t i = 4; i + 3 < b->size; i++) {
+                if (!b->bytes[i] && !b->bytes[i + 1] && b->bytes[i + 2] == 1 && (b->bytes[i + 3] & 31) == 9) {
+                    next = i && !b->bytes[i - 1] ? i - 1 : i; break;
+                }
+            }
+            if (next == b->size) break;
+            if (d->callback(d->arg, id, 0, b->bytes, next, b->pts, b->dts, b->user)) return -1;
+            consume(b, next); b->pts = b->dts = INVALID_TS; b->user = user;
+            if (b->stamp != SIZE_MAX) {
+                if (b->stamp <= next) { b->pts = b->pending_pts; b->dts = b->pending_dts; b->stamp = SIZE_MAX; }
+                else b->stamp -= next;
+            }
+        }
+        return 0;
+    }
+    if (n - off < 4) return -1;
+    unsigned channel = p[off]; off += 4; /* private-stream id + frame offset */
+    if (channel > 15) return 0; /* AC3/LPCM are separate private substreams */
+    Buffer* b = &d->audio[channel];
+    if (!b->size) { b->user = user; if (pts != INVALID_TS) b->pts = pts; }
+    if (append(b, p + off, n - off)) return -1;
+    while (b->size >= 8) {
+        if (b->bytes[0] != 0x0f || b->bytes[1] != 0xd0) return -1;
+        size_t frame = ((((unsigned)b->bytes[2] & 3) << 8) | b->bytes[3]) + 1;
+        frame *= 8;
+        if (b->size < frame + 8) break;
+        /* Keep the ATS header: cellAdec may request header-inclusive AUs. */
+        if (d->callback(d->arg, 0xbd, channel, b->bytes, frame + 8,
+                        b->pts, INVALID_TS, b->user)) return -1;
+        consume(b, frame + 8); b->user = user;
+        if (b->pts != INVALID_TS) b->pts += 3840; /* 2048 samples @ 48 kHz */
+    }
+    return 0;
+}
+int pamf_demux_feed(PamfDemux* d, const uint8_t* data, size_t size, uint64_t user)
+{
+    if (!d || (!data && size)) return -1;
+    size_t previous_size = d->ps.size;
+    uint64_t previous_user = d->ps.user;
+    if (!previous_size) d->ps.user = user;
+    if (append(&d->ps, data, size)) return -1;
+    Buffer* b = &d->ps;
+    size_t off = 0;
+    while (off + 4 <= b->size) {
+        const uint8_t* p = b->bytes + off;
+        if (p[0] || p[1] || p[2] != 1) { off++; continue; }
+        unsigned id = p[3];
+        size_t n;
+        if (id == 0xba) {
+            if (off + 14 > b->size) break;
+            if ((p[4] & 0xc0) != 0x40) return -1;
+            n = 14 + (p[13] & 7);
+        } else if (id == 0xb9) {
+            for (unsigned i = 0; i < 16; i++) if (pamf_demux_flush(d, 0xe0 + i, 0)) return -1;
+            if (d->callback(d->arg, 0xb9, 0, NULL, 0, INVALID_TS, INVALID_TS, user)) return -1;
+            n = 4;
+        } else {
+            if (off + 6 > b->size) break;
+            n = 6 + ((unsigned)p[4] << 8) + p[5];
+            if (n == 6) return -1; /* unbounded PES is not used by PAMF */
+        }
+        if (off + n > b->size) break;
+        if (id != 0xba && id != 0xb9 && pes(d, p, n, off < previous_size ? previous_user : user)) return -1;
+        off += n;
+    }
+    if (off) { consume(b, off); if (off >= previous_size) b->user = user; }
+    return 0;
+}
