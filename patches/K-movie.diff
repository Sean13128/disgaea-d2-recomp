+++ b/libs/codec/avc_sps.c
@@ -0,0 +1,84 @@
+/* Bounded SPS/VUI reader for frame dimensions, color and clock metadata. */
+#include "avc_sps.h"
+#include <stdlib.h>
+#include <string.h>
+typedef struct { uint8_t* p; size_t bytes, bit; int error; } Bits;
+static unsigned read_bits(Bits* b, unsigned n)
+{
+    if (n > 32 || b->bit + n > b->bytes * 8) { b->error = 1; return 0; }
+    unsigned v = 0;
+    while (n--) { v = (v << 1) | ((b->p[b->bit / 8] >> (7 - b->bit % 8)) & 1); b->bit++; }
+    return v;
+}
+static unsigned ue(Bits* b)
+{
+    unsigned n = 0;
+    while (!b->error && !read_bits(b, 1)) { if (++n > 30) { b->error = 1; return 0; } }
+    return ((1u << n) - 1) + read_bits(b, n);
+}
+static int se(Bits* b) { unsigned v = ue(b); return v & 1 ? (int)((v + 1) / 2) : -(int)(v / 2); }
+int avc_parse_sps(const uint8_t* p, size_t n, AvcSpsInfo* out)
+{
+    if (!p || !out || n < 4 || n > 65536 || (p[0] & 31) != 7) return -1;
+    Bits b = {0}; b.p = malloc(n); if (!b.p) return -1;
+    for (size_t i = 1; i < n; i++) {
+        if (i >= 3 && p[i] == 3 && !p[i - 1] && !p[i - 2]) continue;
+        b.p[b.bytes++] = p[i];
+    }
+    AvcSpsInfo info = {0}; info.matrix = 1; info.units = 1001; info.scale = 60000;
+    unsigned profile = read_bits(&b, 8); read_bits(&b, 16); ue(&b);
+    unsigned chroma = 1, separate = 0;
+    if (profile == 100 || profile == 110 || profile == 122 || profile == 244 || profile == 44 ||
+        profile == 83 || profile == 86 || profile == 118 || profile == 128 || profile == 138 || profile == 139 || profile == 134 || profile == 135) {
+        chroma = ue(&b); if (chroma > 3) b.error = 1;
+        if (chroma == 3) separate = read_bits(&b, 1);
+        ue(&b); ue(&b); read_bits(&b, 1);
+        if (read_bits(&b, 1)) for (unsigned i = 0; i < (chroma == 3 ? 12u : 8u); i++) if (read_bits(&b, 1)) {
+            int last = 8, next = 8;
+            for (unsigned j = 0; j < (i < 6 ? 16u : 64u); j++) {
+                if (next) next = (last + se(&b) + 256) & 255;
+                last = next ? next : last;
+            }
+        }
+    }
+    ue(&b); unsigned poc = ue(&b);
+    if (!poc) ue(&b);
+    else if (poc == 1) {
+        read_bits(&b, 1); se(&b); se(&b); unsigned count = ue(&b);
+        if (count > 256) b.error = 1; else while (count--) se(&b);
+    } else if (poc > 2) b.error = 1;
+    ue(&b); read_bits(&b, 1);
+    unsigned mw = ue(&b) + 1, mh = ue(&b) + 1;
+    info.frame_only = read_bits(&b, 1);
+    if (!info.frame_only) read_bits(&b, 1);
+    read_bits(&b, 1);
+    unsigned left = 0, right = 0, top = 0, bottom = 0;
+    if (read_bits(&b, 1)) { left = ue(&b); right = ue(&b); top = ue(&b); bottom = ue(&b); }
+    unsigned cx = chroma == 1 || chroma == 2 ? 2 : 1;
+    unsigned cy = (chroma == 1 ? 2 : 1) * (2 - info.frame_only);
+    if (separate || chroma == 0) { cx = 1; cy = 2 - info.frame_only; }
+    if (mw > 512 || mh > 512 || (left + right) * cx >= mw * 16 || (top + bottom) * cy >= mh * 16 * (2 - info.frame_only)) b.error = 1;
+    info.width = mw * 16 - (left + right) * cx;
+    info.height = mh * 16 * (2 - info.frame_only) - (top + bottom) * cy;
+    if (read_bits(&b, 1)) {
+        if (read_bits(&b, 1)) { unsigned aspect = read_bits(&b, 8); if (aspect == 255) read_bits(&b, 32); }
+        if (read_bits(&b, 1)) read_bits(&b, 1);
+        if (read_bits(&b, 1)) {
+            read_bits(&b, 3); info.full_range = read_bits(&b, 1);
+            if (read_bits(&b, 1)) { read_bits(&b, 16); info.matrix = read_bits(&b, 8); }
+        }
+        if (read_bits(&b, 1)) { ue(&b); ue(&b); }
+        if (read_bits(&b, 1)) { info.units = read_bits(&b, 32); info.scale = read_bits(&b, 32); read_bits(&b, 1); }
+    }
+    if (!info.units || !info.scale) b.error = 1;
+    /* Firmware frame-rate codes, as distinct from the universal 0x80 codes. */
+    static const unsigned num[] = {24000,24,25,30000,30,50,60000,60};
+    static const unsigned den[] = {1001,1,1,1001,1,1,1001,1};
+    uint64_t best = UINT64_MAX;
+    for (unsigned i = 0; i < 8; i++) {
+        int64_t delta = (int64_t)info.scale * den[i] - (int64_t)num[i] * 2 * info.units;
+        uint64_t dist = (uint64_t)(delta < 0 ? -delta : delta) / den[i];
+        if (dist < best) { best = dist; info.frame_rate_code = i; }
+    }
+    free(b.p); if (b.error) return -1; *out = info; return 0;
+}
