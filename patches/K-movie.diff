diff --git a/runtime/ppu/tests/test_codec_callbacks.cpp b/runtime/ppu/tests/test_codec_callbacks.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/ppu/tests/test_codec_callbacks.cpp
@@ -0,0 +1,67 @@
+/* Real guest dispatcher: concurrent OPD/CT callbacks and nested stack use. */
+#include <atomic>
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+#include <sys/mman.h>
+#include "ppu_recomp.h"
+extern "C" {
+uint8_t* vm_base;
+uint64_t ppu_guest_call(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t);
+uint64_t ppu_guest_call_ct(uint32_t, uint32_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t);
+void ppu_register_function(uint64_t, void (*)(ppu_context*));
+extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+}
+static std::atomic<unsigned> ready{0};
+static uint64_t stacks[8], identities[8];
+static void inner(ppu_context* ctx)
+{
+    assert(ctx->gpr[1] < ctx->gpr[3]);
+    vm_write64(ctx->gpr[1] - 0x80, 0x1020304050607080ull);
+    ctx->gpr[3] = 7;
+}
+static void outer(ppu_context* ctx)
+{
+    unsigned index = (unsigned)ctx->gpr[3]; uint64_t sp = ctx->gpr[1];
+    stacks[index] = sp; identities[index] = ctx->thread_id;
+    vm_write64(sp - 0x80, 0xa0b0c0d000000000ull | index);
+    ready.fetch_add(1);
+    while (ready.load() != 8) std::this_thread::yield();
+    assert(vm_read64(sp - 0x80) == (0xa0b0c0d000000000ull | index));
+    assert(ppu_guest_call(0x11008, sp, 0, 0, 0, 0, 0, 0, 0) == 7);
+    assert(g_active_ctx == ctx);
+    assert(vm_read64(sp - 0x80) == (0xa0b0c0d000000000ull | index));
+    ctx->gpr[3] = 9;
+}
+extern "C" const func_entry function_table[] = {{0x10000, outer}, {0x10008, inner}};
+extern "C" const uint64_t function_table_count = 2;
+int main()
+{
+    vm_base = (uint8_t*)mmap(nullptr, 0x100010000ull, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+    vm_write32(0x11000, 0x10000); vm_write32(0x11004, 0x20000);
+    vm_write32(0x11008, 0x10008); vm_write32(0x1100c, 0x20000);
+    ppu_register_function(0x10000, outer); ppu_register_function(0x10008, inner);
+    std::thread threads[8];
+    for (unsigned i = 0; i < 8; i++) threads[i] = std::thread([i] {
+        assert(!g_active_ctx);
+        uint64_t value = i & 1 ? ppu_guest_call_ct(0x10000, 0x20000, i, 0, 0, 0, 0, 0, 0, 0) :
+                                   ppu_guest_call(0x11000, i, 0, 0, 0, 0, 0, 0, 0);
+        assert(value == 9 && !g_active_ctx);
+    });
+    for (auto& t : threads) t.join();
+    for (unsigned i = 0; i < 8; i++) for (unsigned j = i + 1; j < 8; j++) {
+        assert(stacks[i] != stacks[j]); assert(identities[i] != identities[j]);
+    }
+    /* Movie workers are recreated per clip: stack slots must be reusable. */
+    for (unsigned i = 0; i < 200; i++) {
+        std::thread t([] { assert(ppu_guest_call(0x11008, 0xd0000000, 0, 0, 0, 0, 0, 0, 0) == 7); });
+        t.join();
+    }
+    ppu_context caller{}; caller.gpr[1] = 0x5000000; caller.thread_id = 55; g_active_ctx = &caller;
+    assert(ppu_guest_call(0x11008, caller.gpr[1], 0, 0, 0, 0, 0, 0, 0) == 7);
+    assert(g_active_ctx == &caller); g_active_ctx = nullptr;
+    printf("[K-test] concurrent guest OPD/CT callbacks: separate stacks/identities, nested canaries, 200 worker lifetimes and active context restoration PASS\n");
+    munmap(vm_base, 0x100010000ull); return 0;
+}
