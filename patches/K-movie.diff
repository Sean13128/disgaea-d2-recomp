+    assert(vm_read32(0x30000) == 0x0051ff51 && vm_read32(0x30004) == 0xff510051);
+    vm_write32(0x1128, 5);
+    assert(cellVpostExec(h, EA(void, 0x20000), EA(CellVpostCtrlParam, 0x1100), EA(void, 0x30000), EA(CellVpostPictureInfo, 0x1200)) == (s32)0x806104a5);
+    printf("[K-test] vpost black/white, BT.601/709 red, UYVY pairs, scaling, window canaries, alpha, u64 guest ABI and invalid crop PASS\n");
+    if (argc > 2) {
+        FILE* f = fopen(argv[1], "rb"); assert(f);
