diff --git a/libs/codec/avc_decoder.cpp b/libs/codec/avc_decoder.cpp
new file mode 100644
--- /dev/null
+++ b/libs/codec/avc_decoder.cpp
@@ -0,0 +1,173 @@
+#include "avc_decoder.h"
+#include "avc_sps.h"
+#include <cstdlib>
+#include <cstring>
+#ifdef __APPLE__
+#include <VideoToolbox/VideoToolbox.h>
+#include <deque>
+#include <vector>
+#include <mutex>
+#include <atomic>
+#include <cstdio>
+struct AvcDecoder {
+    VTDecompressionSessionRef session = nullptr;
+    CMVideoFormatDescriptionRef format = nullptr;
+    std::vector<uint8_t> sps, pps;
+    std::mutex mutex;
+    std::deque<AvcFrame> frames;
+    std::atomic<int> error{0};
+    AvcSpsInfo info{0, 0, 1, 0, 1, 1001, 60000, 3};
+    uint64_t origin = UINT64_MAX, output_count = 0;
+};
+struct FrameTag { uint64_t pts, dts, user; };
+static void output(void* arg, void* ref, OSStatus status, VTDecodeInfoFlags,
+                    CVImageBufferRef image, CMTime, CMTime)
+{
+    auto* d = static_cast<AvcDecoder*>(arg);
+    auto* tag = static_cast<FrameTag*>(ref);
+    std::lock_guard<std::mutex> lock(d->mutex);
+    if (status || !image) { d->error = status ? status : -1; delete tag; return; }
+    CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    unsigned w = (unsigned)CVPixelBufferGetWidth(image), h = (unsigned)CVPixelBufferGetHeight(image);
+    uint64_t offset = d->output_count * 180000ull * d->info.units / d->info.scale;
+    uint64_t pts = tag->pts;
+    if (pts != UINT64_MAX) d->origin = pts >= offset ? pts - offset : 0;
+    else pts = d->origin == UINT64_MAX ? offset : d->origin + offset;
+    d->output_count++;
+    AvcFrame f{w, h, d->info.frame_rate_code, d->info.full_range, d->info.matrix,
+               pts, tag->dts, tag->user, nullptr};
+    f.yuv = static_cast<uint8_t*>(std::malloc((size_t)w * h * 3 / 2));
+    if (f.yuv && !(w & 1) && !(h & 1) && CVPixelBufferGetPlaneCount(image) == 2) {
+        const auto* y = static_cast<const uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(image, 0));
+        const auto* uv = static_cast<const uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(image, 1));
+        size_t ys = CVPixelBufferGetBytesPerRowOfPlane(image, 0), cs = CVPixelBufferGetBytesPerRowOfPlane(image, 1);
+        for (unsigned row = 0; row < h; row++) std::memcpy(f.yuv + row * w, y + row * ys, w);
+        uint8_t* u = f.yuv + w * h; uint8_t* v = u + w * h / 4;
+        for (unsigned row = 0; row < h / 2; row++) for (unsigned x = 0; x < w / 2; x++) {
+            u[row * (w / 2) + x] = uv[row * cs + x * 2];
+            v[row * (w / 2) + x] = uv[row * cs + x * 2 + 1];
+        }
+        d->frames.push_back(f);
+    } else { std::free(f.yuv); d->error = -1; }
+    CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+    delete tag;
+}
+static int make_session(AvcDecoder* d)
+{
+    const uint8_t* sets[] = {d->sps.data(), d->pps.data()};
+    const size_t sizes[] = {d->sps.size(), d->pps.size()};
+    OSStatus status = CMVideoFormatDescriptionCreateFromH264ParameterSets(kCFAllocatorDefault, 2, sets, sizes, 4, &d->format);
+    if (status) return status;
+    int pixel = d->info.full_range ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    CFNumberRef number = CFNumberCreate(nullptr, kCFNumberIntType, &pixel);
+    const void* keys[] = {kCVPixelBufferPixelFormatTypeKey}; const void* values[] = {number};
+    CFDictionaryRef attrs = CFDictionaryCreate(nullptr, keys, values, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    VTDecompressionOutputCallbackRecord cb{output, d};
+    /* Allow Apple's software decoder too; no Metal device/window is needed. */
+    status = VTDecompressionSessionCreate(nullptr, d->format, nullptr, attrs, &cb, &d->session);
+    CFRelease(attrs); CFRelease(number);
+    if (status) {
+        std::fprintf(stderr, "[avc] VideoToolbox session error=%d\n", (int)status);
+        CFRelease(d->format); d->format = nullptr;
+    }
+    return status;
+}
+extern "C" AvcDecoder* avc_decoder_create(void) { return new AvcDecoder; }
+extern "C" int avc_decoder_flush(AvcDecoder* d)
+{
+    if (!d || !d->session) return 0;
+    OSStatus s = VTDecompressionSessionFinishDelayedFrames(d->session);
+    if (!s) s = VTDecompressionSessionWaitForAsynchronousFrames(d->session);
+    return s ? (int)s : d->error.load();
+}
+extern "C" void avc_decoder_destroy(AvcDecoder* d)
+{
+    if (!d) return;
+    avc_decoder_flush(d);
+    if (d->session) { VTDecompressionSessionInvalidate(d->session); CFRelease(d->session); }
+    if (d->format) CFRelease(d->format);
+    for (auto& f : d->frames) std::free(f.yuv);
+    delete d;
+}
+static size_t startcode(const uint8_t* p, size_t n, size_t at, size_t* prefix)
+{
+    for (; at + 3 <= n; at++) if (!p[at] && !p[at + 1]) {
+        if (p[at + 2] == 1) { *prefix = 3; return at; }
+        if (at + 4 <= n && !p[at + 2] && p[at + 3] == 1) { *prefix = 4; return at; }
+    }
+    *prefix = 0; return n;
+}
+extern "C" int avc_decoder_feed(AvcDecoder* d, const uint8_t* p, size_t n,
+                                 uint64_t pts, uint64_t dts, uint64_t user)
+{
+    if (!d || !p || !n) return -1;
+    std::vector<uint8_t> avcc;
+    size_t prefix, pos = startcode(p, n, 0, &prefix);
+    bool picture = false, changed = false;
+    while (pos < n) {
+        size_t begin = pos + prefix, nextPrefix, end = startcode(p, n, begin, &nextPrefix);
+        if (end > begin) {
+            unsigned type = p[begin] & 31;
+            if (type == 7 || type == 8) {
+                auto& set = type == 7 ? d->sps : d->pps;
+                std::vector<uint8_t> value(p + begin, p + end);
+                if (value != set) { changed = true; set = std::move(value); }
+            } else if (type != 9 && type != 12) {
+                uint32_t len = (uint32_t)(end - begin);
+                avcc.push_back(len >> 24); avcc.push_back(len >> 16);
+                avcc.push_back(len >> 8); avcc.push_back(len);
+                avcc.insert(avcc.end(), p + begin, p + end);
+                if (type == 1 || type == 5) picture = true;
+            }
+        }
+        pos = end; prefix = nextPrefix;
+    }
+    if (!picture) return 0;
+    { std::lock_guard<std::mutex> lock(d->mutex);
+      if (d->origin == UINT64_MAX && pts != UINT64_MAX) d->origin = pts; }
+    if (d->sps.empty() || d->pps.empty()) return -1;
+    if (changed && d->session) {
+        avc_decoder_flush(d); VTDecompressionSessionInvalidate(d->session);
+        CFRelease(d->session); d->session = nullptr;
+        CFRelease(d->format); d->format = nullptr;
+    }
+    if (!d->session) {
+        if (avc_parse_sps(d->sps.data(), d->sps.size(), &d->info)) return -1;
+        int s = make_session(d); if (s) return s;
+    }
+    CMBlockBufferRef block = nullptr;
+    OSStatus s = CMBlockBufferCreateWithMemoryBlock(nullptr, nullptr, avcc.size(), nullptr, nullptr, 0, avcc.size(), 0, &block);
+    if (s) return s;
+    s = CMBlockBufferReplaceDataBytes(avcc.data(), block, 0, avcc.size());
+    CMSampleBufferRef sample = nullptr;
+    CMSampleTimingInfo timing{kCMTimeInvalid, pts == UINT64_MAX ? kCMTimeInvalid : CMTimeMake((int64_t)pts, 90000),
+                              dts == UINT64_MAX ? kCMTimeInvalid : CMTimeMake((int64_t)dts, 90000)};
+    size_t bytes = avcc.size();
+    if (!s) s = CMSampleBufferCreateReady(nullptr, block, d->format, 1, 1, &timing, 1, &bytes, &sample);
+    if (!s) {
+        auto* tag = new FrameTag{pts, dts, user};
+        s = VTDecompressionSessionDecodeFrame(d->session, sample, kVTDecodeFrame_EnableTemporalProcessing, tag, nullptr);
+        if (s) delete tag;
+        /* WaitForAsynchronousFrames ALSO flushes delayed pictures. Doing it
+         * after every AU forces reference P pictures out before future B AUs.
+         * Preserve VideoToolbox's temporal queue until EndSeq instead. */
+    }
+    if (sample) CFRelease(sample); CFRelease(block);
+    return s ? (int)s : d->error.load();
+}
+extern "C" int avc_decoder_take(AvcDecoder* d, AvcFrame* f)
+{
+    if (!d || !f) return 0;
+    std::lock_guard<std::mutex> lock(d->mutex);
+    if (d->frames.empty()) return 0;
+    *f = d->frames.front(); d->frames.pop_front(); return 1;
+}
+#else
+struct AvcDecoder {};
+extern "C" AvcDecoder* avc_decoder_create(void) { return new AvcDecoder; }
+extern "C" void avc_decoder_destroy(AvcDecoder* d) { delete d; }
+extern "C" int avc_decoder_feed(AvcDecoder*, const uint8_t*, size_t, uint64_t, uint64_t, uint64_t) { return -1; }
+extern "C" int avc_decoder_flush(AvcDecoder*) { return 0; }
+extern "C" int avc_decoder_take(AvcDecoder*, AvcFrame*) { return 0; }
+#endif
+extern "C" void avc_frame_release(AvcFrame* f) { std::free(f->yuv); f->yuv = nullptr; }
