+#endif
+typedef struct AvcDecoder AvcDecoder;
+typedef struct AvcFrame {
+    unsigned width, height, frame_rate_code, full_range, matrix;
+    uint64_t pts, dts, user;
+    uint8_t* yuv; /* tightly packed Y, U, V (4:2:0) */
+} AvcFrame;
+AvcDecoder* avc_decoder_create(void);
+void avc_decoder_destroy(AvcDecoder* decoder);
+int avc_decoder_feed(AvcDecoder* decoder, const uint8_t* annexb, size_t size,
+                     uint64_t pts, uint64_t dts, uint64_t user);
+int avc_decoder_flush(AvcDecoder* decoder);
+int avc_decoder_take(AvcDecoder* decoder, AvcFrame* frame);
+void avc_frame_release(AvcFrame* frame);
+#ifdef __cplusplus
+}
+#endif
+#endif
