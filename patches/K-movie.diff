diff --git a/libs/codec/video_convert.c b/libs/codec/video_convert.c
new file mode 100644
--- /dev/null
+++ b/libs/codec/video_convert.c
@@ -0,0 +1,59 @@
+#include "video_convert.h"
+#include <stddef.h>
+static uint8_t clamp(int v) { return v < 0 ? 0 : v > 255 ? 255 : (uint8_t)v; }
+static int sample(const uint8_t* p, unsigned w, unsigned h, unsigned x, unsigned y)
+{
+    unsigned ax = x >> 16, ay = y >> 16, bx = ax + 1 < w ? ax + 1 : ax, by = ay + 1 < h ? ay + 1 : ay;
+    unsigned fx = (x >> 8) & 255, fy = (y >> 8) & 255;
+    unsigned a = p[(size_t)ay * w + ax] * (256 - fx) + p[(size_t)ay * w + bx] * fx;
+    unsigned b = p[(size_t)by * w + ax] * (256 - fx) + p[(size_t)by * w + bx] * fx;
+    return (int)((a * (256 - fy) + b * fy + 32768) >> 16);
+}
+static unsigned coordinate(unsigned at, unsigned count, unsigned begin, unsigned length)
+{
+    /* Pixel centers, clamped at the crop edges. */
+    int64_t v = ((int64_t)(2 * at + 1) * length * 32768 / count) - 32768;
+    if (v < 0) v = 0;
+    if (v > (int64_t)(length - 1) * 65536) v = (int64_t)(length - 1) * 65536;
+    return begin * 65536 + (unsigned)v;
+}
+int video_convert(const uint8_t* src, unsigned iw, unsigned ih,
+    unsigned ix, unsigned iy, unsigned cw, unsigned ch, uint8_t* dst,
+    unsigned ow, unsigned oh, unsigned ox, unsigned oy, unsigned dw, unsigned dh,
+    unsigned format, unsigned matrix, unsigned range, uint8_t alpha)
+{
+    if (!src || !dst || !iw || !ih || !cw || !ch || !dw || !dh ||
+        (iw & 1) || (ih & 1) || iw > 8192 || ih > 8192 || ow > 8192 || oh > 8192 ||
+        ix > iw || cw > iw - ix || iy > ih || ch > ih - iy ||
+        ox > ow || dw > ow - ox || oy > oh || dh > oh - oy || format > 3 || matrix > 1 || range > 1)
+        return -1;
+    if ((format == 2 && ((ox | dw) & 1)) || (format == 3 && ((ow | oh | ox | oy | dw | dh) & 1))) return -1;
+    const uint8_t* up = src + (size_t)iw * ih; const uint8_t* vp = up + (size_t)iw * ih / 4;
+    for (unsigned y = 0; y < dh; y++) for (unsigned x = 0; x < dw; x++) {
+        unsigned sx = coordinate(x, dw, ix, cw), sy = coordinate(y, dh, iy, ch);
+        int yy = sample(src, iw, ih, sx, sy);
+        unsigned csx = format == 2 ? coordinate(x & ~1u, dw, ix, cw) / 2 : sx / 2;
+        int u = sample(up, iw / 2, ih / 2, csx, sy / 2), v = sample(vp, iw / 2, ih / 2, csx, sy / 2);
+        size_t at = (size_t)(oy + y) * ow + ox + x;
+        if (format == 3) {
+            dst[at] = yy;
+            if (!((x | y) & 1)) {
+                size_t c = (size_t)((oy + y) / 2) * (ow / 2) + (ox + x) / 2;
+                dst[(size_t)ow * oh + c] = u; dst[(size_t)ow * oh * 5 / 4 + c] = v;
+            }
+        } else if (format == 2) {
+            dst[at * 2] = (x & 1) ? v : u; dst[at * 2 + 1] = yy;
+        } else {
+            int lum = range ? (yy - 16) * 298 : yy * 256;
+            u -= 128; v -= 128;
+            int r = (lum + v * (matrix ? (range ? 459 : 403) : (range ? 409 : 359)) + 128) >> 8;
+            int g = (lum - u * (matrix ? (range ? 55 : 48) : (range ? 100 : 88)) -
+                     v * (matrix ? (range ? 136 : 120) : (range ? 208 : 183)) + 128) >> 8;
+            int b = (lum + u * (matrix ? (range ? 541 : 475) : (range ? 516 : 454)) + 128) >> 8;
+            uint8_t* p = dst + at * 4;
+            if (format == 0) { p[0] = alpha; p[1] = clamp(r); p[2] = clamp(g); p[3] = clamp(b); }
+            else { p[0] = clamp(r); p[1] = clamp(g); p[2] = clamp(b); p[3] = alpha; }
+        }
+    }
+    return 0;
+}
