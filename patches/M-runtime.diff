+/* AIO writes complete on a host worker, not inside the submitting guest
+ * call. The OPD bridge gives host callback threads their own guest stack. */
+class FsAioWriteCompletions {
+    struct Completion { uint32_t opd, aio; int32_t error, id; uint64_t size; };
+    std::mutex lock;
+    std::condition_variable ready;
+    std::deque<Completion> pending;
+    bool stop = false;
+    std::thread worker;
+public:
+    FsAioWriteCompletions() : worker([this] {
+        std::unique_lock<std::mutex> guard(lock);
+        for (;;) {
+            ready.wait(guard, [this] { return stop || !pending.empty(); });
+            if (pending.empty() && stop) return;
+            Completion c = pending.front(); pending.pop_front();
+            guard.unlock();
+            ps3_invoke_guest(c.opd, c.aio, (uint64_t)(int64_t)c.error,
+                             (uint64_t)(int64_t)c.id, c.size, 0, 0, 0, 0);
+            guard.lock();
+        }
+    }) {}
+    ~FsAioWriteCompletions()
+    {
+        { std::lock_guard<std::mutex> guard(lock); stop = true; }
+        ready.notify_one(); worker.join();
+    }
+    void submit(uint32_t opd, uint32_t aio, int32_t error, int32_t id, uint64_t size)
+    {
+        { std::lock_guard<std::mutex> guard(lock); pending.push_back({opd, aio, error, id, size}); }
+        ready.notify_one();
+    }
+};
