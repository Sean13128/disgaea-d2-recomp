+/* jstrchk returns a mask: ambiguous byte strings can fit several encodings.
+ * RPCS3 still returns UTF8 unconditionally; validate each candidate here. */
+s32 jstrchk(const u8* jstr)
+{
+    if (!jstr) return (1 << 17); /* ERROR */
+    const u8* str = (const u8*)l10n_ptr(jstr);
+    size_t len = strlen((const char*)str);
+    int ascii = 1, utf8 = 1, sjis = 1, euc = 1;
+    for (size_t i = 0; i < len; i++) if (str[i] >= 0x80) { ascii = 0; break; }
+    /* ISO-2022-JP carries its encoding in escape sequences; those bytes are
+     * all ASCII, so check them before declaring a plain ASCII string. */
+    int jis = 1, escaped = 0, mode = 0;
+    for (size_t i = 0; i < len;) {
+        u8 c = str[i++];
+        if (c == 0x1b) {
+            if (i + 1 >= len) { jis = 0; break; }
+            u8 a = str[i++], b = str[i++];
+            if (a == '$' && (b == '@' || b == 'B')) mode = 1;
+            else if (a == '(' && (b == 'B' || b == 'J')) mode = 0;
+            else if (a == '(' && b == 'I') mode = 2;
+            else { jis = 0; break; }
+            escaped = 1;
+        } else if (mode == 1) {
+            if (c < 0x21 || c > 0x7e || i >= len || str[i] < 0x21 || str[i] > 0x7e) {
+                jis = 0; break;
+            }
+            i++;
+        } else if (mode == 2) {
+            if (c < 0x21 || c > 0x5f) { jis = 0; break; }
+        } else if (c >= 0x80) { jis = 0; break; }
+    }
+    if (escaped && jis) return (1 << 2); /* JIS */
+    if (ascii) return (1 << 1); /* ASCII */
+    for (size_t i = 0; i < len;) {
+        u32 cp; int n = decode_utf8(str + i, (u32)(len - i), &cp);
+        if (!n) { utf8 = 0; break; } i += n;
+    }
+    for (size_t i = 0; i < len; i++) {
+        u8 c = str[i];
+        if (c < 0x80 || (c >= 0xa1 && c <= 0xdf)) continue;
+        if (!((c >= 0x81 && c <= 0x9f) || (c >= 0xe0 && c <= 0xfc)) || ++i >= len ||
+            !((str[i] >= 0x40 && str[i] <= 0x7e) || (str[i] >= 0x80 && str[i] <= 0xfc))) {
+            sjis = 0; break;
+        }
+    }
+    for (size_t i = 0; i < len; i++) {
+        u8 c = str[i];
+        if (c < 0x80) continue;
+        int n = c == 0x8f ? 2 : 1;
+        u8 hi = c == 0x8e ? 0xdf : 0xfe;
+        if (!(c == 0x8e || c == 0x8f || (c >= 0xa1 && c <= 0xfe))) { euc = 0; break; }
+        while (n--) if (++i >= len || str[i] < 0xa1 || str[i] > hi) { euc = 0; break; }
+        if (!euc) break;
+    }
+    s32 mask = (utf8 ? 1 << 5 : 0) | (sjis ? 1 << 4 : 0) | (euc ? 1 << 3 : 0);
+    return mask ? mask : (1 << 16); /* ILLEGAL */
+}
