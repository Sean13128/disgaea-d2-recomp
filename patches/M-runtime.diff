+/* Firmware string converters take byte counts by reference (BE in guest
+ * memory), do not add a terminator, and allow dst=NULL to query the size.
+ * RPCS3 _L10nConvertStr leaves src_len unchanged, including on failure. */
+static const void* l10n_ptr(const void* p)
+{
+    uintptr_t ea = (uintptr_t)p;
+    return ea && ea < 0x100000000ull ? vm_base + (u32)ea : p;
+}
+static u32 l10n_length(const u32* p)
+{
+    return (uintptr_t)p < 0x100000000ull ? vm_read32((uintptr_t)p) : *p;
+}
+static void l10n_set_length(u32* p, u32 n)
+{
+    if ((uintptr_t)p < 0x100000000ull) vm_write32((uintptr_t)p, n);
+    else *p = n;
+}
+
+static s32 l10n_sjis_string(const u8* src, const u32* src_len,
+                            u8* dst, u32* dst_len, int to_utf8)
+{
+    if (!src || !src_len || !dst_len) return 1; /* SRCIllegal */
+    size_t remaining = l10n_length(src_len);
+    size_t capacity = dst ? l10n_length(dst_len) : 0;
+    char* input = (char*)l10n_ptr(src);
+    char* output = (char*)l10n_ptr(dst);
+    u32 written = 0;
+    s32 result = 0;
+#ifndef _WIN32
+    /* CP932, rather than strict JIS X 0208, includes the firmware's vendor
+     * extensions (and maps 0x5c to a backslash, as RPCS3 does). */
+    iconv_t converter = iconv_open(to_utf8 ? "UTF-8" : "CP932",
+                                   to_utf8 ? "CP932" : "UTF-8");
+    if (converter == (iconv_t)-1) return 3; /* ConverterUnknown */
+    do {
+        char scratch[256];
+        char* out = dst ? output : scratch;
+        size_t left = dst ? capacity : sizeof(scratch);
+        size_t before = left;
+        size_t rc = iconv(converter, &input, &remaining, &out, &left);
+        written += (u32)(before - left);
+        if (dst) { output = out; capacity = left; }
+        if (rc != (size_t)-1) break;
+        if (errno == E2BIG && !dst) continue;
+        result = errno == E2BIG ? 2 : 1; /* DSTExhausted / SRCIllegal */
+        break;
+    } while (remaining);
+    iconv_close(converter);
+#else
+    /* Convert one scalar at a time so partial results and short-buffer errors
+     * have the same semantics as iconv on POSIX. */
+    while (remaining) {
+        u32 cp;
+        int count = to_utf8 ? (IsDBCSLeadByteEx(932, (BYTE)*input) ? 2 : 1)
+                            : decode_utf8((u8*)input, (u32)remaining, &cp);
+        WCHAR wide[2];
+        if (!count || (size_t)count > remaining) { result = 1; break; }
+        int wn = MultiByteToWideChar(to_utf8 ? 932 : CP_UTF8,
+                                     MB_ERR_INVALID_CHARS, input, count, wide, 2);
+        char bytes[8]; BOOL substituted = FALSE;
+        int bn = wn ? WideCharToMultiByte(to_utf8 ? CP_UTF8 : 932,
+                       to_utf8 ? 0 : WC_NO_BEST_FIT_CHARS, wide, wn, bytes, 8,
+                       NULL, to_utf8 ? NULL : &substituted) : 0;
+        if (!bn || substituted) { result = 1; break; }
+        if (dst && capacity < (size_t)bn) { result = 2; break; }
+        if (dst) { memcpy(output, bytes, bn); output += bn; capacity -= bn; }
+        written += bn; input += count; remaining -= count;
+    }
+#endif
+    l10n_set_length(dst_len, written);
+    return result;
+}
+
+s32 SJISstoUTF8s(const u8* src, const u32* src_len, u8* dst, u32* dst_len)
+{
+    return l10n_sjis_string(src, src_len, dst, dst_len, 1);
+}
+
+s32 UTF8stoSJISs(const u8* src, const u32* src_len, u8* dst, u32* dst_len)
+{
+    return l10n_sjis_string(src, src_len, dst, dst_len, 0);
+}
