+static void eng_apply_host_settings(void)
+{
+    @autoreleasepool {
+        unsigned scale = host_config() & 15;
+        if (scale == s_eng_scale) return;
+        id<MTLTexture> replacement[ENG_MAX_OBJECTS] = {nil};
+        for (u32 i = 0; i < s_eng_obj_count; i++) {
+            if (!s_eng_native[i].w || !s_eng_obj[i]) continue;
+            unsigned w = rsx_host_scale_edge(s_eng_native[i].w, scale);
+            unsigned h = rsx_host_scale_edge(s_eng_native[i].h, scale);
+            if (w > 16384 || h > 16384) return;
+            MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:
+                s_eng_obj[i].pixelFormat width:w height:h mipmapped:NO];
+            td.usage = s_eng_obj[i].usage;
+            td.storageMode = s_eng_obj[i].storageMode;
+            replacement[i] = [s_dev newTextureWithDescriptor:td];
+            if (!replacement[i]) {
+                fprintf(stderr, "[rsx engine/metal] resolution allocation failed; retaining %.1fx\n", s_eng_scale / 2.0);
+                return;
+            }
+        }
+        /* Rebuild swizzled views against replacements without changing the handles
+         * held in the engine's caches. Normalized/UNNORM math uses guest dimensions. */
+        for (u32 i = 0; i < s_eng_view_count; i++) {
+            EngView* v = &s_eng_view[i];
+            id<MTLTexture> source = replacement[v->surface-1];
+            if (!source) continue;
+            id<MTLTexture> old = eng_obj(v->view);
+            replacement[v->view-1] = [source newTextureViewWithPixelFormat:old.pixelFormat
+                textureType:MTLTextureType2D levels:NSMakeRange(0, 1) slices:NSMakeRange(0, 1)
+                swizzle:old.swizzle];
+            if (!replacement[v->view-1]) return;
+        }
+        id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+        for (u32 i = 0; i < s_eng_obj_count; i++) {
+            if (replacement[i] && s_eng_native[i].w &&
+                !eng_copy_surface(cb, s_eng_obj[i], replacement[i], s_eng_native[i].depth)) return;
+        }
+        [cb commit]; /* subsequent draws execute after all retained surfaces migrate */
+        for (u32 i = 0; i < s_eng_obj_count; i++)
+            if (replacement[i]) s_eng_obj[i] = replacement[i];
+        s_eng_scale = scale;
+        fprintf(stderr, "[rsx engine/metal] internal resolution %.1fx (%ux%u), native guest metadata retained\n",
+                scale / 2.0, rsx_host_scale_edge(1280, scale), rsx_host_scale_edge(720, scale));
+    }
+}
