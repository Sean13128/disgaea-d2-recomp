+    if (cap != 30 && cap != 60 && cap != 120) cap = 0;
+    unsigned sync = vsync < 0 ? 2 : (vsync != 0);
+    atomic_store_explicit(&s_host_config, scale | (filter << 4) | (!!stretch << 6) |
+                          (sync << 8) | (cap << 16), memory_order_relaxed);
