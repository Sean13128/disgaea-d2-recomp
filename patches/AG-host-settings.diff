+/* Host output gain, independent of the guest's port levels and ring clock. */
+#ifndef PS3RECOMP_CELL_AUDIO_HOST_H
+#define PS3RECOMP_CELL_AUDIO_HOST_H
+#include <math.h>
+static inline float cellAudioHostSample(float sample, float gain)
+{
+    if (!isfinite(sample)) return 0.0f;
+    if (sample > 1.0f) sample = 1.0f;
+    if (sample < -1.0f) sample = -1.0f;
+    return sample * gain;
+}
