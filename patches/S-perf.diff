+{
+    if (memcmp(&actual, &expected, sizeof actual)) {
+        fprintf(stderr, "%s MISMATCH: %08x/%08x %08x/%08x %08x/%08x %08x/%08x\n",
+                name, actual._u32[0], expected._u32[0], actual._u32[1], expected._u32[1],
+                actual._u32[2], expected._u32[2], actual._u32[3], expected._u32[3]);
+        exit(1);
+    }
+}
+int main(void)
+{
+    const uint32_t edge[] = {0, 0x80000000, 1, 0x80000001, 0x007fffff, 0x00800000,
+        0x3f800000, 0xbf800000, 0x7f7fffff, 0xff7fffff, 0x7f800000, 0xff800000,
+        0x7fc12345, 0xffc23456, 0x7f823456};
+    for (unsigned i = 0; i < 200000; i++) {
+        u128 a, b, c;
