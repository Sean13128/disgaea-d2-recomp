diff --git a/runtime/platform/tests/test_guest_poll_filter.c b/runtime/platform/tests/test_guest_poll_filter.c
new file mode 100644
index 0000000..0352cf2
--- /dev/null
+++ b/runtime/platform/tests/test_guest_poll_filter.c
@@ -0,0 +1,90 @@
+/* Standalone: clang -O2 -std=gnu17 -pthread test_guest_poll_filter.c -o test_guest_poll_filter
+ * Include the implementation to observe registration without production hooks.
+ * Extend only this test's wait to 200ms, so a missed notification cannot hide
+ * behind the runtime's normal 100us timeout. */
+#include <pthread.h>
+#include <stdatomic.h>
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include <sched.h>
+static atomic_uint broadcasts;
+static int test_broadcast(pthread_cond_t* cond)
+{
+    atomic_fetch_add(&broadcasts, 1);
+    return pthread_cond_broadcast(cond);
+}
+#ifdef __APPLE__
+static int test_wait(pthread_cond_t* cond, pthread_mutex_t* lock, const struct timespec* unused)
+{
+    (void)unused;
+    const struct timespec delay = {0, 200000000};
+    return pthread_cond_timedwait_relative_np(cond, lock, &delay);
+}
+#define pthread_cond_timedwait_relative_np test_wait
+#else
+static int test_wait(pthread_cond_t* cond, pthread_mutex_t* lock, const struct timespec* unused)
+{
+    (void)unused;
+    struct timespec deadline;
+    clock_gettime(CLOCK_MONOTONIC, &deadline);
+    deadline.tv_nsec += 200000000;
+    if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+    return pthread_cond_timedwait(cond, lock, &deadline);
+}
+#define pthread_cond_timedwait test_wait
+#endif
+#define pthread_cond_broadcast test_broadcast
+#include "../guest_poll.c"
+#undef pthread_cond_broadcast
+static uint8_t memory[1024];
+uint8_t* vm_base = memory;
+static double now(void)
+{
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec + t.tv_nsec / 1e9;
+}
+static void* wait_once(void* unused)
+{
+    (void)unused;
+    uint32_t zero = 0;
+    ps3_poll_backoff(40, 128, &zero, 4);
+    return NULL;
+}
+int main(void)
+{
+    ps3_poll_thread_start("poll filter test", 0);
+    uint32_t zero = 0;
+    uint32_t collision = 256;
+    while (poll_slot(collision) != poll_slot(128) ||
+           ((collision >> 7) & (POLL_LINES - 1)) == 1) collision += 128;
+    for (unsigned i = 0; i < 1000; i++) {
+        __atomic_store_n((uint32_t*)(memory + 128), 0, __ATOMIC_RELEASE);
+        pthread_t waiter;
+        assert(!pthread_create(&waiter, NULL, wait_once, NULL));
+        double start = now();
+        while (!atomic_load(&s_lines[1])) { sched_yield(); assert(now() - start < 1); }
+        /* Hash collision has no waiter on this line: no broadcast/lock. */
+        unsigned old = atomic_load(&broadcasts);
+        ps3_poll_notify(collision, 4);
+        assert(atomic_load(&broadcasts) == old);
+        __atomic_store_n((uint32_t*)(memory + 128), 1, __ATOMIC_RELEASE);
+        start = now();
+        ps3_poll_notify(127, 5); /* crosses into the watched line */
+        pthread_join(waiter, NULL);
+        assert(now() - start < 0.1); /* shorter than test timeout */
+        assert(!atomic_load(&s_lines[1]));
+        assert(!atomic_load(&poll_slot(128)->waiters));
+    }
+    /* Publication before registration must skip the condition wait. */
+    double start = now();
+    for (unsigned i = 0; i < 1000; i++) ps3_poll_backoff(40, 128, &zero, 4);
+    assert(now() - start < 0.1);
+    /* Unaligned cross-line reads safely yield instead of waiting on one bucket. */
+    start = now();
+    ps3_poll_backoff(40, 127, &zero, 4);
+    assert(now() - start < 0.1);
+    puts("guest poll filter: 1000 registration races, hash collision, crossing store, prior publication PASS");
+    return 0;
+}
