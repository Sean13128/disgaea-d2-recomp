+static s32 commit_save(const char* target, const char* staged, const char* parent)
+{
+    char backup[1100]; snprintf(backup, sizeof(backup), "%s/previous", parent);
+    int existed = dir_exists(target);
+    if (existed && rename(target, backup) != 0) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    if (rename(staged, target) != 0) {
+        if (existed && rename(backup, target) != 0)
+            printf("[cellSaveData] restore failed; previous save retained in '%s'\n", backup);
+        return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    }
+    if (existed) delete_save_path(backup);
+    return CELL_OK;
 }
 
