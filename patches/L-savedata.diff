+static s32 savedata_free_kb(void)
+{
+    resolve_save_root(); ensure_dirs(s_save_root);
+#ifdef _WIN32
+    ULARGE_INTEGER free_bytes;
+    if (!GetDiskFreeSpaceExA(s_save_root, &free_bytes, NULL, NULL)) return 0;
+    u64 kb = free_bytes.QuadPart / 1024;
+#else
+    struct statvfs st;
+    if (statvfs(s_save_root, &st) != 0) return 0;
+    u64 kb = ((u64)st.f_bavail * (st.f_frsize ? st.f_frsize : st.f_bsize)) / 1024;
+#endif
+    return kb > INT32_MAX ? INT32_MAX : (s32)kb;
+}
