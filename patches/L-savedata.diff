+static int s_sort_type, s_sort_order;
+static int save_dir_compare(const void* a, const void* b)
+{
+    const CellSaveDataDirList* x = a;
+    const CellSaveDataDirList* y = b;
+    char px[1024], py[1024];
+    build_save_path(px, sizeof(px), x->dirName); build_save_path(py, sizeof(py), y->dirName);
+    int result = 0;
+    if (s_sort_type == CELL_SAVEDATA_SORTTYPE_SUBTITLE) {
+        CellSaveDataSystemFileParam sx, sy;
+        read_param_sfo(px, &sx); read_param_sfo(py, &sy);
+        result = strcmp(sx.subTitle, sy.subTitle);
+    } else {
+        HOST_STAT_T sx, sy;
+        if (HOST_STAT(px, &sx) == 0 && HOST_STAT(py, &sy) == 0) {
+#ifdef _WIN32
+            s64 tx = sx.st_mtime, ty = sy.st_mtime;
+#elif defined(__APPLE__)
+            s64 tx = sx.st_mtimespec.tv_sec, ty = sy.st_mtimespec.tv_sec;
+#else
+            s64 tx = sx.st_mtim.tv_sec, ty = sy.st_mtim.tv_sec;
+#endif
+            result = tx < ty ? -1 : tx > ty ? 1 : 0;
+        }
+    }
+    if (!result) result = strcmp(x->dirName, y->dirName);
+    return s_sort_order == CELL_SAVEDATA_SORTORDER_ASCENT ? result : -result;
+}
