+/* Delete only the flat files in a selected save, never arbitrary subtrees. */
+static s32 delete_save_path(const char* path)
+{
+#ifdef _WIN32
+    char search[1100]; snprintf(search, sizeof(search), "%s/*", path);
+    WIN32_FIND_DATAA data;
+    HANDLE h = FindFirstFileA(search, &data);
+    if (h == INVALID_HANDLE_VALUE) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    int failed = 0;
+    do {
+        if (!strcmp(data.cFileName, ".") || !strcmp(data.cFileName, "..")) continue;
+        char file[1100]; snprintf(file, sizeof(file), "%s/%s", path, data.cFileName);
+        if ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || remove(file) != 0) failed = 1;
+    } while (FindNextFileA(h, &data));
+    FindClose(h);
+    return !failed && _rmdir(path) == 0 ? CELL_OK : CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+#else
+    DIR* dp = opendir(path);
+    if (!dp) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    struct dirent* de;
+    int failed = 0;
+    while ((de = readdir(dp))) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+        char file[1100]; snprintf(file, sizeof(file), "%s/%s", path, de->d_name);
+        if (remove(file) != 0) failed = 1;
+    }
+    closedir(dp);
+    return !failed && rmdir(path) == 0 ? CELL_OK : CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+#endif
+}
