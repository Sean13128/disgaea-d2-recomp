+++ b/libs/system/savedata_sfo.h
@@ -0,0 +1,196 @@
+/* Binary PSF metadata used by cellSaveData and RPCS3 (little endian on disk).
+ * Keep unknown entries when updating imported saves. Secure-file flags are
+ * integer entries named *<filename>; PARAM.PFD is not a plaintext manifest. */
+#ifndef PS3RECOMP_SAVEDATA_SFO_H
+#define PS3RECOMP_SAVEDATA_SFO_H
+
+#define SAVE_SFO_MAX 256
+typedef struct SaveSfoEntry {
+    char key[64];
+    u16 format;
+    u32 size, capacity;
+    u8* data;
+} SaveSfoEntry;
+typedef struct SaveSfo { u32 count; SaveSfoEntry entries[SAVE_SFO_MAX]; } SaveSfo;
+
+static u32 sfo_le32(const u8* p)
+{
+    return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+static void sfo_put32(u8* p, u32 n)
+{
+    p[0] = (u8)n; p[1] = (u8)(n >> 8); p[2] = (u8)(n >> 16); p[3] = (u8)(n >> 24);
+}
+static void sfo_free(SaveSfo* s)
+{
+    for (u32 i = 0; i < s->count; i++) free(s->entries[i].data);
+    memset(s, 0, sizeof(*s));
+}
+static SaveSfoEntry* sfo_find(SaveSfo* s, const char* key)
+{
+    for (u32 i = 0; i < s->count; i++)
+        if (!strcmp(s->entries[i].key, key)) return &s->entries[i];
+    return NULL;
+}
+static int sfo_set(SaveSfo* s, const char* key, u16 format,
+                   const void* data, u32 size, u32 capacity)
+{
+    if (strlen(key) >= 64 || size > capacity || capacity > 65536) return 0;
+    SaveSfoEntry* e = sfo_find(s, key);
+    if (!e) {
+        if (s->count == SAVE_SFO_MAX) return 0;
+        e = &s->entries[s->count++];
+        strcpy(e->key, key);
+    }
+    u8* copy = calloc(1, capacity ? capacity : 1);
+    if (!copy) return 0;
+    if (size) memcpy(copy, data, size);
+    free(e->data); e->data = copy;
+    e->format = format; e->size = size; e->capacity = capacity;
+    return 1;
+}
+static int sfo_set_int(SaveSfo* s, const char* key, u32 n)
+{
+    u8 data[4]; sfo_put32(data, n);
+    return sfo_set(s, key, 0x0404, data, 4, 4);
+}
+static int sfo_set_str(SaveSfo* s, const char* key, const char* text, u32 capacity)
+{
+    u32 len = (u32)strnlen(text, capacity);
+    if (len == capacity) return 0;
+    return sfo_set(s, key, 0x0204, text, len + 1, capacity);
+}
+static void sfo_remove(SaveSfo* s, const char* key)
+{
+    SaveSfoEntry* e = sfo_find(s, key);
+    if (!e) return;
+    u32 i = (u32)(e - s->entries);
+    free(e->data);
+    memmove(e, e + 1, (s->count - i - 1) * sizeof(*e));
+    memset(&s->entries[--s->count], 0, sizeof(*e));
+}
+static int sfo_load(const char* path, SaveSfo* s)
+{
+    memset(s, 0, sizeof(*s));
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END); long length = ftell(f); rewind(f);
+    if (length < 20 || length > 1024 * 1024) { fclose(f); return 0; }
+    u8* bytes = malloc((size_t)length);
+    if (!bytes) { fclose(f); return 0; }
+    int ok = fread(bytes, 1, (size_t)length, f) == (size_t)length;
+    fclose(f);
+    u32 keys = sfo_le32(bytes + 8), data = sfo_le32(bytes + 12);
+    u32 count = sfo_le32(bytes + 16);
+    ok = ok && !memcmp(bytes, "\0PSF", 4) && count <= SAVE_SFO_MAX &&
+         20 + count * 16 <= keys && keys <= data && data <= (u32)length;
+    for (u32 i = 0; ok && i < count; i++) {
+        const u8* e = bytes + 20 + i * 16;
+        u32 key = keys + ((u32)e[0] | (u32)e[1] << 8);
+        u32 size = sfo_le32(e + 4), cap = sfo_le32(e + 8), off = sfo_le32(e + 12);
+        ok = key < data && memchr(bytes + key, 0, data - key) &&
+             size <= cap && cap <= 65536 && (u64)data + off + cap <= (u32)length;
+        if (ok) ok = sfo_set(s, (char*)bytes + key, (u16)(e[2] | e[3] << 8),
+                             bytes + data + off, size, cap);
+    }
+    free(bytes);
+    if (!ok) sfo_free(s);
+    return ok;
+}
+static int sfo_entry_compare(const void* a, const void* b)
+{
+    return strcmp(((const SaveSfoEntry*)a)->key, ((const SaveSfoEntry*)b)->key);
+}
+static int sfo_store(const char* path, SaveSfo* s)
+{
+    qsort(s->entries, s->count, sizeof(s->entries[0]), sfo_entry_compare);
+    u32 key_size = 0, data_size = 0;
+    for (u32 i = 0; i < s->count; i++) {
+        key_size += (u32)strlen(s->entries[i].key) + 1;
+        data_size += (s->entries[i].capacity + 3) & ~3u;
+    }
+    u32 keys = 20 + s->count * 16, data = (keys + key_size + 3) & ~3u;
+    u32 size = data + data_size;
+    u8* bytes = calloc(1, size);
+    if (!bytes) return 0;
+    memcpy(bytes, "\0PSF", 4); sfo_put32(bytes + 4, 0x101);
+    sfo_put32(bytes + 8, keys); sfo_put32(bytes + 12, data); sfo_put32(bytes + 16, s->count);
+    u32 k = 0, d = 0;
+    for (u32 i = 0; i < s->count; i++) {
+        SaveSfoEntry* entry = &s->entries[i];
+        u8* e = bytes + 20 + i * 16;
+        e[0] = (u8)k; e[1] = (u8)(k >> 8);
+        e[2] = (u8)entry->format; e[3] = (u8)(entry->format >> 8);
+        sfo_put32(e + 4, entry->size); sfo_put32(e + 8, entry->capacity); sfo_put32(e + 12, d);
+        strcpy((char*)bytes + keys + k, entry->key);
+        memcpy(bytes + data + d, entry->data, entry->size);
+        k += (u32)strlen(entry->key) + 1; d += (entry->capacity + 3) & ~3u;
+    }
+    char temp[1100]; snprintf(temp, sizeof(temp), "%s.tmp", path);
+    FILE* f = fopen(temp, "wb");
+    int ok = f && fwrite(bytes, 1, size, f) == size;
+    if (f && fclose(f) != 0) ok = 0;
+    free(bytes);
+    if (ok) ok = rename(temp, path) == 0;
+    if (!ok) remove(temp);
+    return ok;
+}
+static int read_param_sfo(const char* save_path, CellSaveDataSystemFileParam* param)
+{
+    memset(param, 0, sizeof(*param));
+    char path[1024]; snprintf(path, sizeof(path), "%s/PARAM.SFO", save_path);
+    SaveSfo s;
+    if (!sfo_load(path, &s)) return 0;
+    const char* keys[] = { "TITLE", "SUB_TITLE", "DETAIL", "SAVEDATA_LIST_PARAM" };
+    char* dest[] = { param->title, param->subTitle, param->detail, param->listParam };
+    u32 sizes[] = { 128, 128, 1024, 8 };
+    for (u32 i = 0; i < 4; i++) {
+        SaveSfoEntry* e = sfo_find(&s, keys[i]);
+        if (e) memcpy(dest[i], e->data, e->size < sizes[i] ? e->size : sizes[i] - 1);
+    }
+    SaveSfoEntry* e = sfo_find(&s, "ATTRIBUTE");
+    if (e && e->size == 4) param->attribute = sfo_le32(e->data);
+    sfo_free(&s);
+    return 1;
+}
+static int write_param_sfo(const char* save_path, const CellSaveDataSystemFileParam* param)
+{
+    char path[1024]; snprintf(path, sizeof(path), "%s/PARAM.SFO", save_path);
+    SaveSfo s; sfo_load(path, &s);
+    const char* name = strrchr(save_path, '/'); name = name ? name + 1 : save_path;
+    int ok = (sfo_find(&s, "ACCOUNT_ID") ||
+              sfo_set(&s, "ACCOUNT_ID", 0x0004, "0000000000000000", 16, 16)) &&
+             sfo_set_int(&s, "ATTRIBUTE", param->attribute) &&
+             sfo_set_str(&s, "CATEGORY", "SD", 4) &&
+             (sfo_find(&s, "PARAMS") || sfo_set_str(&s, "PARAMS", "", 1024)) &&
+             (sfo_find(&s, "PARAMS2") || sfo_set_str(&s, "PARAMS2", "", 12)) &&
+             (sfo_find(&s, "PARENTAL_LEVEL") || sfo_set_int(&s, "PARENTAL_LEVEL", 0)) &&
+             sfo_set_str(&s, "SAVEDATA_DIRECTORY", name, 32) &&
+             sfo_set_str(&s, "TITLE", param->title, 128) &&
+             sfo_set_str(&s, "SUB_TITLE", param->subTitle, 128) &&
+             sfo_set_str(&s, "DETAIL", param->detail, 1024) &&
+             sfo_set_str(&s, "SAVEDATA_LIST_PARAM", param->listParam, 8);
+    if (ok) ok = sfo_store(path, &s);
+    sfo_free(&s);
+    return ok;
+}
+static int sfo_file_flag(const char* save_path, const char* name, int value)
+{
+    char path[1024], key[64];
+    snprintf(path, sizeof(path), "%s/PARAM.SFO", save_path);
+    snprintf(key, sizeof(key), "*%s", name);
+    SaveSfo s;
+    if (!sfo_load(path, &s)) return 0;
+    int ok;
+    if (value == -2) {
+        SaveSfoEntry* e = sfo_find(&s, key);
+        ok = e && e->size == 4 && sfo_le32(e->data) != 0;
+    } else {
+        if (value < 0) { sfo_remove(&s, key); ok = 1; }
+        else ok = sfo_set_int(&s, key, (u32)value);
+        if (ok) ok = sfo_store(path, &s);
+    }
+    sfo_free(&s);
+    return ok;
+}
