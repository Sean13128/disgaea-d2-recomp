+/* Native save dialogs run on the application's main thread. The guest save
+ * thread blocks while the macOS runner continues servicing its run loop. */
+#import <AppKit/AppKit.h>
+#include "savedata_macos.h"
+#include <stdlib.h>
+#include <string.h>
+
+static int headless(void)
+{
+    const char* mode = getenv("PS3_SAVEDATA_UI");
+    const char* metal = getenv("PS3RECOMP_METAL_HEADLESS");
+    return (mode && !strcmp(mode, "headless")) || (metal && !strcmp(metal, "1"));
+}
+
+int savedata_macos_select(const CellSaveDataDirList* dirs, u32 count,
+                         const char* new_name, const char* focused,
+                         const char* action, char selected[32])
+{
+    if (headless()) return -2;
+    __block int result = -2;
+    void (^show)(void) = ^{
+        if (!NSApp) return;
+        @autoreleasepool {
+            NSAlert* alert = [[NSAlert alloc] init];
+            alert.messageText = [NSString stringWithFormat:@"%s game data", action];
+            if (!count && (!new_name || !*new_name)) {
+                alert.informativeText = @"No save data is available.";
+                [alert addButtonWithTitle:@"OK"];
+                [alert runModal]; result = -1;
+            } else {
+                alert.informativeText = @"Choose a save slot.";
+                [alert addButtonWithTitle:[NSString stringWithUTF8String:action]];
+                [alert addButtonWithTitle:@"Cancel"];
+                NSPopUpButton* menu = [[NSPopUpButton alloc] initWithFrame:NSMakeRect(0, 0, 360, 28) pullsDown:NO];
+                NSInteger focus = 0;
+                for (u32 i = 0; i < count; i++) {
+                    NSString* label = [NSString stringWithUTF8String:dirs[i].dirName];
+                    [menu addItemWithTitle:label ?: @"Save"];
+                    if (focused && !strcmp(focused, dirs[i].dirName)) focus = i;
+                }
+                if (new_name && *new_name) {
+                    [menu addItemWithTitle:[NSString stringWithFormat:@"New save (%s)", new_name]];
+                    if (focused && !strcmp(focused, new_name)) focus = count;
+                }
+                [menu selectItemAtIndex:focus]; alert.accessoryView = menu;
+                if ([alert runModal] == NSAlertFirstButtonReturn) {
+                    NSInteger i = menu.indexOfSelectedItem;
+                    const char* name = i < count ? dirs[i].dirName : new_name;
+                    snprintf(selected, 32, "%s", name); result = 0;
+                } else result = -1;
+                [menu release];
+            }
+            [alert release];
+        }
+    };
+    if ([NSThread isMainThread]) show();
+    else dispatch_sync(dispatch_get_main_queue(), show);
+    return result;
+}
+
+int savedata_macos_confirm(const char* action, const char* directory)
+{
+    if (headless()) return -2;
+    __block int result = -2;
+    void (^show)(void) = ^{
+        if (!NSApp) return;
+        @autoreleasepool {
+            NSAlert* alert = [[NSAlert alloc] init];
+            alert.messageText = [NSString stringWithFormat:@"%s %@?", action,
+                [NSString stringWithUTF8String:directory] ?: @"save data"];
+            alert.informativeText = !strcmp(action, "Delete")
+                ? @"This save will be deleted." : @"Your current progress will be written to this slot.";
+            [alert addButtonWithTitle:[NSString stringWithUTF8String:action]];
+            [alert addButtonWithTitle:@"Cancel"];
+            result = [alert runModal] == NSAlertFirstButtonReturn;
+            [alert release];
+        }
+    };
+    if ([NSThread isMainThread]) show();
+    else dispatch_sync(dispatch_get_main_queue(), show);
+    return result;
+}
