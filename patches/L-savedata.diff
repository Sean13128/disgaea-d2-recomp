+/* Work in a sibling directory so callback or I/O errors preserve the old save.
+ * The final directory rename commits all files and metadata together. */
+static s32 stage_save(const char* source, const char* directory, int recreate,
+                      char parent[1024], char staged[1024])
+{
+    snprintf(parent, 1024, "%s/.savedata-XXXXXX", s_save_root);
+#ifdef _WIN32
+    if (_mktemp_s(parent, 1024) || HOST_MKDIR(parent)) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+#else
+    if (!mkdtemp(parent)) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+#endif
+    snprintf(staged, 1024, "%s/%s", parent, directory);
+    if (HOST_MKDIR(staged) != 0) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    if (recreate || !dir_exists(source)) return CELL_OK;
+#ifdef _WIN32
+    char search[1100]; snprintf(search, sizeof(search), "%s/*", source);
+    WIN32_FIND_DATAA data;
+    HANDLE h = FindFirstFileA(search, &data);
+    if (h == INVALID_HANDLE_VALUE) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    int more = 1;
+    while (more) {
+        const char* name = data.cFileName;
+#else
+    DIR* dp = opendir(source);
+    if (!dp) return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+    struct dirent* de;
+    while ((de = readdir(dp))) {
+        const char* name = de->d_name;
+#endif
+        if (strcmp(name, ".") && strcmp(name, "..")) {
+            char from[1100], to[1100];
+            snprintf(from, sizeof(from), "%s/%s", source, name);
+            snprintf(to, sizeof(to), "%s/%s", staged, name);
+            FILE* input = fopen(from, "rb"); FILE* output = fopen(to, "wb");
+            int ok = input && output;
+            u8 bytes[16384]; size_t n;
+            while (ok && (n = fread(bytes, 1, sizeof(bytes), input)))
+                ok = fwrite(bytes, 1, n, output) == n;
+            if (input) { if (ferror(input)) ok = 0; fclose(input); }
+            if (output && fclose(output) != 0) ok = 0;
+            if (!ok) {
+#ifdef _WIN32
+                FindClose(h);
+#else
+                closedir(dp);
+#endif
+                return CELL_SAVEDATA_ERROR_ACCESS_ERROR;
+            }
+        }
+#ifdef _WIN32
+        more = FindNextFileA(h, &data);
+#endif
+    }
+#ifdef _WIN32
+    FindClose(h);
+#else
+    closedir(dp);
+#endif
+    return CELL_OK;
+}
