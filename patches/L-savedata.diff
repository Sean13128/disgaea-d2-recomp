+static s32 sort_save_dirs(CellSaveDataSetList* setList, CellSaveDataDirList* dirs, u32 count)
+{
+    u32 ea = (u32)(uintptr_t)setList;
+    s_sort_type = (int)vm_read32(ea); s_sort_order = (int)vm_read32(ea + 4);
+    if (s_sort_type > 1 || s_sort_type < 0 || s_sort_order > 1 || s_sort_order < 0)
+        return CELL_SAVEDATA_ERROR_PARAM;
+    qsort(dirs, count, sizeof(*dirs), save_dir_compare);
+    return CELL_OK;
+}
