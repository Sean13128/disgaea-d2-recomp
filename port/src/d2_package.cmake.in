# Stage and sign a complete copy. A failure leaves the published app untouched.
file(LOCK "@CMAKE_CURRENT_BINARY_DIR@/package.lock" GUARD PROCESS TIMEOUT 60)
set(stage "@CMAKE_CURRENT_BINARY_DIR@/package/Disgaea D2.app")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "@CMAKE_CURRENT_BINARY_DIR@/package")
file(COPY "${APP}" DESTINATION "@CMAKE_CURRENT_BINARY_DIR@/package")
set(contents "${stage}/Contents")
file(COPY "${RUNNER}" DESTINATION "${contents}/MacOS")
include(BundleUtilities)
fixup_bundle("${stage}" "${contents}/MacOS/DisgaeaD2Recomp" "/opt/homebrew/lib")
# A stable local identity (tools/make_signing_identity.sh) keeps macOS privacy
# grants across rebuilds; ad-hoc signatures change every build and re-prompt.
execute_process(COMMAND /usr/bin/security find-identity -p codesigning
    OUTPUT_VARIABLE identities ERROR_QUIET)
string(REGEX MATCH "([0-9A-F]+) \"Disgaea D2 Local Signing\"" found "${identities}")
set(identity "-")
if(found)
    set(identity "${CMAKE_MATCH_1}")
endif()
execute_process(COMMAND /usr/bin/codesign --force --deep --sign "${identity}" "${stage}" RESULT_VARIABLE signed)
if(NOT signed EQUAL 0 AND NOT identity STREQUAL "-")
    message(WARNING "Local identity signing failed (${signed}); falling back to ad-hoc")
    set(identity "-")
    execute_process(COMMAND /usr/bin/codesign --force --deep --sign - "${stage}" RESULT_VARIABLE signed)
endif()
if(NOT signed EQUAL 0)
    message(FATAL_ERROR "Signing failed: ${signed}")
endif()
message(STATUS "Signed with identity: ${identity}")
execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${stage}" RESULT_VARIABLE verified)
if(NOT verified EQUAL 0)
    message(FATAL_ERROR "Bundle signature validation failed: ${verified}")
endif()
file(MAKE_DIRECTORY "@D2_DIST_DIR@")
execute_process(COMMAND "${PUBLISH}" "${stage}" "@D2_DIST_DIR@/Disgaea D2.app" RESULT_VARIABLE published)
if(NOT published EQUAL 0)
    message(FATAL_ERROR "Atomic bundle publication failed: ${published}")
endif()
# After exchange the stage holds the previous distribution.
file(REMOVE_RECURSE "${stage}")
