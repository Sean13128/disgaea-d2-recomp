# Trace wrappers are compiled only into explicitly requested research builds.
option(D2_APPEARANCE_DIAGNOSTICS "Compile read-only appearance boundary tracing (1.40)" OFF)
option(D2_APPEARANCE_IMPORTER "Compile experimental staged alternate-body binding (1.40)" OFF)
if(D2_APPEARANCE_DIAGNOSTICS OR D2_APPEARANCE_IMPORTER)
    set(D2_APPEARANCE_WRAPPERS ON)
else()
    set(D2_APPEARANCE_WRAPPERS OFF)
endif()
if(D2_APPEARANCE_WRAPPERS AND NOT D2_GAME_VERSION STREQUAL "140")
    message(FATAL_ERROR "Appearance wrappers have only been resolved for 1.40")
endif()
set_property(GLOBAL PROPERTY D2_APPEARANCE_FOUND "")
function(d2_appearance_patch text_in text_out changed_out)
    set(text "${text_in}")
    set(changed FALSE)
    if(D2_APPEARANCE_WRAPPERS)
        foreach(pair IN ITEMS "0015ACDC:unit_face" "0015BBEC:unit_face_large" "0015CCAC:unit_panel_face" "0019E544:class_queued_face" "0019E6A8:class_queued_face_alt" "00193AC0:ui_face_record" "001964C0:ui_face_draw" "0007C11C:unit_list_face" "0007C2E8:unit_list_face_alt" "0007C550:unit_small_face" "0007C680:unit_small_face_alt" "00149E80:face_coordinates" "00109350:illustration" "00109E44:select" "00181728:update" "00015A98:write_body" "00015AB0:read_body" "00015E18:record" "00029804:visual" "00181438:request" "00106E34:category" "00106E84:body_kind" "00016548:motion" "00182F1C:file_size" "00166CB4:allocate" "00183084:file_read" "00181B78:load_update" "002E89D8:model_select" "002E8D78:texture_bind")
            string(REPLACE ":" ";" parts "${pair}")
            list(GET parts 0 address)
            list(GET parts 1 kind)
            set(signature "void func_${address}(ppu_context* ctx) {")
            string(FIND "${text}" "${signature}" found)
            if(NOT found EQUAL -1)
                string(REPLACE "${signature}" "void d2_appearance_original_${kind}(ppu_context* ctx) {" text "${text}")
                set(changed TRUE)
                set_property(GLOBAL APPEND PROPERTY D2_APPEARANCE_FOUND ${kind})
            endif()
        endforeach()
    endif()
    set(${text_out} "${text}" PARENT_SCOPE)
    set(${changed_out} ${changed} PARENT_SCOPE)
endfunction()
