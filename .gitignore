# Whitelist: ignore everything, then allow only our own sources/docs.
# Never commit game files, decrypted binaries, lifted code, logs, saves.
/*
!/.gitignore
!/OPERATIONS.md
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/patches/
# Individual worker SDK exports; the combined patch and SDK.lock stay tracked.
/patches/*-runtime.diff
!/codex/
/codex/*
!/codex/*.md
!/codex/N.host-check.sh
!/codex/P.host-check.sh
!/codex/P.check.sh
!/codex/P.savedata-regression.sh
!/codex/S.host-check.sh
!/codex/X.host-check.sh
!/codex/X.hash-test.c
!/codex/U.host-check.sh
!/codex/V.host-check.sh
!/codex/W.host-check.sh
!/codex/W.analyze.py
!/codex/W.audio-clock.c
/codex/*.last.md
!/work/
/work/*
!/work/RECON.md
!/port/
/port/*
!/port/CMakeLists.txt
!/port/main.cpp
!/port/stubs.cpp
!/port/config.toml
!/port/run.sh
!/port/play.sh
!/port/capture.sh
!/port/script-common.sh
!/port/src/
/port/src/*
!/port/src/d2_*
!/port/spu/
/port/spu/*
!/port/spu/README.md
*.elf
*.BIN
*.bin
*.log
.DS_Store

!/codex/Y.host-check.sh
!/codex/Y.analyze.py
!/codex/Y.sync-test.c
!/codex/Q.sync-test.c

!/codex/AA.host-check.sh
!/codex/AA.replay-check.sh
!/codex/AA.replay.c
!/codex/AA.replay-drain.c
!/codex/AA.vertex-test.c
!/codex/AA.cache-test.c
!/codex/AA.sync-test.c
!/codex/AA.sync-stubs.c

!/codex/AB.host-check.sh
!/codex/AB.sync-test.c
!/codex/AB.profile.py
!/codex/AB.check.sh

!/tools/
/tools/*
!/tools/d2_save_import.py
!/codex/AC.host-check.sh
!/codex/AC.save-import-test.py
!/port/install-content.sh
!/codex/AD.host-check.sh
!/codex/AD.edat-test.py
!/codex/AD.fs-test.c

!/codex/AG.host-check.sh
!/codex/AG.metal-test.m

