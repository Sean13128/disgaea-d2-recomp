!/codex/AH.ocr.m
!/codex/AH.metal-check.sh
!/codex/AH.elf-test.c
!/codex/AH.launcher-test.m
!/codex/AI.host-check.sh
!/codex/AN.host-check.sh

# Maintained asset-free regression suite and reproducibility tools.
!/port/tests/
/port/tests/*
!/port/tests/*.c
!/port/tests/*.cpp
!/port/tests/*.m
!/port/tests/*.py
!/port/tests/*.sh
