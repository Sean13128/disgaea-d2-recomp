# Whitelist: ignore everything, then allow only our own sources/docs.
# Never commit game files, decrypted binaries, lifted code, logs, saves.
/*
!/.gitignore
!/OPERATIONS.md
!/README.md
!/patches/
!/codex/
/codex/*
!/codex/*.md
!/codex/N.host-check.sh
!/codex/P.host-check.sh
!/codex/P.check.sh
!/codex/P.savedata-regression.sh
/codex/*.last.md
!/work/
/work/*
!/work/RECON.md
!/port/
/port/*
!/port/CMakeLists.txt
!/port/main.cpp
!/port/stubs.cpp
!/port/config.toml
!/port/run.sh
!/port/play.sh
!/port/capture.sh
!/port/src/
/port/src/*
!/port/src/d2_*
!/port/spu/
/port/spu/*
!/port/spu/README.md
*.elf
*.BIN
*.bin
*.log
.DS_Store
